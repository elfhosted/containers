 src/app/tests/test_anonymous_allowlist.py | 85 +++++++++++++++++++++++
 src/config/settings.py                    | 11 +++
 3 files changed, 177 insertions(+)
 create mode 100644 src/app/tests/test_anonymous_allowlist.py

