+import importlib
 import os
+from contextlib import contextmanager
 from unittest.mock import patch
 
-from django.test import SimpleTestCase
+from django.core.cache import cache
+from django.test import SimpleTestCase, TestCase, override_settings
 
+from app.discover.providers import tmdb_adapter
+from app.providers import tmdb
 from config import settings as project_settings
 
+MIRROR = "http://mirror.local:8080"
+
+
+@contextmanager
+def reloaded_with(module, **overrides):
+    """Re-import a provider module under overridden settings, then restore it.
+
+    Provider modules read their base URL from settings once, at import, so the
+    override only takes effect for a module imported while it is active.
+    """
+    try:
+        with override_settings(**overrides):
+            yield importlib.reload(module)
+    finally:
+        importlib.reload(module)
+
 
 class ProviderBaseUrlSettingTests(SimpleTestCase):
     """Test reading provider API base URLs from the environment."""
@@ -45,3 +66,40 @@ class ProviderBaseUrlSettingTests(SimpleTestCase):
                 ),
                 "http://mirror.local:8080/example/v1",
             )
+
+
+class TMDBBaseUrlTests(TestCase):
+    """Test that TMDB requests use the configured base URL."""
+
+    def setUp(self):
+        """Start each test with an empty cache."""
+        cache.clear()
+
+    def test_find_uses_configured_base_url(self):
+        """Find requests go to the configured base URL."""
+        with (
+            reloaded_with(tmdb, TMDB_BASE_URL=f"{MIRROR}/tmdb/3") as module,
+            patch.object(
+                module.services,
+                "api_request",
+                return_value={"movie_results": []},
+            ) as mock_api_request,
+        ):
+            module.find("tt0078748", "imdb_id")
+
+        self.assertEqual(
+            mock_api_request.call_args.args[2],
+            f"{MIRROR}/tmdb/3/find/tt0078748",
+        )
+
+    def test_public_api_restored_after_override(self):
+        """Without an override the module points at the public API."""
+        self.assertEqual(tmdb.base_url, "https://api.themoviedb.org/3")
+
+    def test_discover_adapter_uses_configured_base_url(self):
+        """The Discover adapter builds its URLs from the same setting."""
+        with reloaded_with(
+            tmdb_adapter,
+            TMDB_BASE_URL=f"{MIRROR}/tmdb/3",
+        ) as module:
+            self.assertEqual(module.TMDB_BASE_URL, f"{MIRROR}/tmdb/3")
