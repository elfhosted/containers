+def mount_mirror_limiters(target_session):
+    """Pace a provider pointed at a mirror the same way as its public API.
+
+    TVDB_BASE_URL and TVMAZE_BASE_URL can send these providers to a compatible
+    mirror or caching proxy. When one does, the public host's limiter adapter is
+    mounted on the configured base URL as well, so requests to the mirror draw
+    from the same budget as requests to the public API.
+    """
+    for public, configured in (
+        ("https://api4.thetvdb.com", settings.TVDB_BASE_URL),
+        ("https://api.tvmaze.com", settings.TVMAZE_BASE_URL),
+    ):
+        if not configured.startswith(public):
+            target_session.mount(configured, target_session.adapters[public])
+
+
+mount_mirror_limiters(session)
+
+
