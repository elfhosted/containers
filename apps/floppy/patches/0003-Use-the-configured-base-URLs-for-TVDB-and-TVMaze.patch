+class MirrorLimiterTests(SimpleTestCase):
+    """Test that a mirrored provider keeps its public host's rate limit."""
+
+    def _session(self):
+        target_session = LimiterSession(per_second=5)
+        target_session.mount("http://", HTTPAdapter(max_retries=3))
+        target_session.mount("https://", HTTPAdapter(max_retries=3))
+        target_session.mount("https://api4.thetvdb.com", LimiterAdapter(per_second=2))
+        target_session.mount("https://api.tvmaze.com", LimiterAdapter(per_second=2))
+        return target_session
+
+    @override_settings(
+        TVDB_BASE_URL=f"{MIRROR}/tvdb/v4",
+        TVMAZE_BASE_URL=f"{MIRROR}/tvmaze",
+    )
+    def test_limiters_mounted_on_configured_base_urls(self):
+        """A mirror shares the public host's limiter; other paths do not."""
+        target_session = self._session()
+
+        services.mount_mirror_limiters(target_session)
+
+        for mirror_url, public_url in (
+            (f"{MIRROR}/tvdb/v4/series/1", "https://api4.thetvdb.com/v4/series/1"),
+            (f"{MIRROR}/tvmaze/shows/1", "https://api.tvmaze.com/shows/1"),
+        ):
+            with self.subTest(mirror_url=mirror_url):
+                mirrored = target_session.get_adapter(mirror_url)
+                self.assertIsInstance(mirrored, LimiterAdapter)
+                self.assertIs(mirrored, target_session.get_adapter(public_url))
+        self.assertNotIsInstance(
+            target_session.get_adapter(f"{MIRROR}/other/path"),
+            LimiterAdapter,
+        )
+
+    @override_settings(
+        TVDB_BASE_URL="https://api4.thetvdb.com/v4",
+        TVMAZE_BASE_URL="https://api.tvmaze.com",
+    )
+    def test_nothing_extra_mounted_without_a_mirror(self):
+        """Without an override no additional adapter is mounted."""
+        target_session = self._session()
+        before = list(target_session.adapters)
+
+        services.mount_mirror_limiters(target_session)
+
+        self.assertEqual(list(target_session.adapters), before)
+
+
+class TVDBCredentialProbeTests(SimpleTestCase):
