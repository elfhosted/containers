+class TVDBBaseUrlTests(SimpleTestCase):
+    """Test that TVDB requests use the configured base URL."""
+
+    def test_module_reads_configured_base_url(self):
+        """The TVDB module builds its URLs from settings.TVDB_BASE_URL."""
+        with reloaded_with(tvdb, TVDB_BASE_URL=f"{MIRROR}/tvdb/v4") as module:
