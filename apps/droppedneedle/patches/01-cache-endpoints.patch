+/// An environment variable replaces a provider's API root. Unset or blank
+/// keeps upstream's root.
+fn elfhosted_base(var: &str, default: &str) -> String {
+    match std::env::var(var) {
+        Ok(value) if !value.trim().is_empty() => value.trim().trim_end_matches('/').to_owned(),
+        _ => default.to_owned(),
+    }
+}
