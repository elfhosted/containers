+/// AUDIODB_RATE_LIMIT_RPS (a positive number) replaces the `audiodb` row's
+/// rate. Unset, blank or not a positive number keeps upstream's rate.
+fn elfhosted_rate(source: &str) -> Option<f64> {
+    if source != "audiodb" {
+        return None;
+    }
+    let rate: f64 = std::env::var("AUDIODB_RATE_LIMIT_RPS").ok()?.trim().parse().ok()?;
+    (rate.is_finite() && rate > 0.0).then_some(rate)
+}
