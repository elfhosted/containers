@@ -3,9 +3,12 @@ from unittest.mock import patch
 
 from django.core.cache import cache
 from django.test import SimpleTestCase, override_settings
+from requests.adapters import HTTPAdapter
+from requests_ratelimiter import LimiterAdapter, LimiterSession
 
-from app.providers import tmdb, tvdb
+from app.providers import services, tmdb, tvdb
 from config import settings as project_settings
+from events.calendar.tv import get_tvmaze_response
 
 MIRROR = "http://mirror.local:8080"
 
@@ -124,3 +127,68 @@ class TVDBBaseUrlTests(SimpleTestCase):
             urls,
             [f"{MIRROR}/tvdb/v4/login", f"{MIRROR}/tvdb/v4/episodes/12345"],
         )
+
+
+@override_settings(TVMAZE_BASE_URL=f"{MIRROR}/tvmaze")
+class TVMazeBaseUrlTests(SimpleTestCase):
+    """Test that TVMaze requests and rate limiting follow the base URL."""
+
+    @patch("events.calendar.tv.services.api_request")
+    def test_lookup_and_show_use_configured_base_url(self, mock_api_request):
+        """Lookup and show requests go to the configured base URL."""
+        mock_api_request.side_effect = [{"id": 123}, {"_embedded": {}}]
+
+        get_tvmaze_response("81189")
+
+        urls = [call.args[2] for call in mock_api_request.call_args_list]
+        self.assertEqual(
+            urls,
+            [
+                f"{MIRROR}/tvmaze/lookup/shows?thetvdb=81189",
+                f"{MIRROR}/tvmaze/shows/123?embed=episodes",
+            ],
+        )
+
+    def test_limiter_mounted_on_configured_base_url(self):
+        """The TVMaze limiter covers both the public API and the override."""
+        target_session = LimiterSession(per_second=5)
+        target_session.mount("http://", HTTPAdapter(max_retries=3))
+        target_session.mount("https://", HTTPAdapter(max_retries=3))
+
+        services.mount_base_url_limiters(target_session)
+
+        override = target_session.get_adapter(
+            f"{MIRROR}/tvmaze/lookup/shows?thetvdb=81189",
+        )
+        public = target_session.get_adapter(
+            "https://api.tvmaze.com/lookup/shows?thetvdb=81189",
+        )
+        self.assertIsInstance(override, LimiterAdapter)
+        self.assertIs(override, public)
+        self.assertNotIsInstance(
+            target_session.get_adapter(f"{MIRROR}/other/path"),
+            LimiterAdapter,
+        )
+
+
+class TVMazeDefaultLimiterTests(SimpleTestCase):
+    """Test the TVMaze limiter when no base URL override is configured."""
+
+    @override_settings(TVMAZE_BASE_URL="https://api.tvmaze.com")
+    def test_limiter_mounted_once_on_public_url(self):
+        """Without an override the limiter is mounted only on the public API."""
+        target_session = LimiterSession(per_second=5)
+
+        services.mount_base_url_limiters(target_session)
+
+        tvmaze_prefixes = [
+            prefix for prefix in target_session.adapters if "tvmaze" in prefix
+        ]
+        self.assertEqual(tvmaze_prefixes, ["https://api.tvmaze.com"])
+
+    def test_module_session_limits_public_tvmaze(self):
+        """The shared provider session rate limits the public TVMaze API."""
+        self.assertIsInstance(
+            services.session.get_adapter("https://api.tvmaze.com/shows/1"),
+            LimiterAdapter,
+        )
