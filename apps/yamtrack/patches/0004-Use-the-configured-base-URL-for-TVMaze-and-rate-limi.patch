From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ElfHosted <noreply@elfhosted.com>
Date: Thu, 17 Sep 2026 10:58:01 +1200
Subject: [PATCH 4/4] Use the configured base URL for TVMaze and rate limit it

Build TVMaze lookup and show URLs from settings.TVMAZE_BASE_URL. The
TVMaze rate limiter is mounted on the configured base URL as well as the
public API, so requests to a mirror are paced the same way.
---
 src/app/providers/services.py             | 20 +++++--
 src/app/tests/providers/test_base_urls.py | 70 ++++++++++++++++++++++-
 src/events/calendar/tv.py                 |  5 +-
 3 files changed, 88 insertions(+), 7 deletions(-)

diff --git a/src/app/providers/services.py b/src/app/providers/services.py
index d45c19c..af47c07 100644
--- a/src/app/providers/services.py
+++ b/src/app/providers/services.py
@@ -34,6 +34,21 @@ def get_redis_client():
     return Redis.from_url(settings.REDIS_URL)
 
 
+TVMAZE_PUBLIC_URL = "https://api.tvmaze.com"
+
+
+def mount_base_url_limiters(target_session):
+    """Mount rate limiters for providers whose base URL is configurable.
+
+    The limiter is mounted on the public API URL and, when it differs, on the
+    configured base URL, so requests sent to a mirror or caching proxy are
+    paced the same way as requests sent to the public API.
+    """
+    tvmaze_limiter = LimiterAdapter(per_second=2)
+    for prefix in dict.fromkeys((TVMAZE_PUBLIC_URL, settings.TVMAZE_BASE_URL)):
+        target_session.mount(prefix, tvmaze_limiter)
+
+
 redis_db = get_redis_client()
 bucket_key = f"{settings.REDIS_PREFIX}_api" if settings.REDIS_PREFIX else "api"
 
@@ -58,10 +73,7 @@ session.mount(
     "https://api.igdb.com/v4",
     LimiterAdapter(per_second=3),
 )
-session.mount(
-    "https://api.tvmaze.com",
-    LimiterAdapter(per_second=2),
-)
+mount_base_url_limiters(session)
 session.mount(
     "https://comicvine.gamespot.com/api",
     LimiterAdapter(per_hour=190),
diff --git a/src/app/tests/providers/test_base_urls.py b/src/app/tests/providers/test_base_urls.py
