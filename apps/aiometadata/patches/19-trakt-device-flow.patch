+// --- Trakt code sign-in (device flow) ---
+// The user enters a short code at Trakt; no callback URL is involved, so one
+// registered application works for any instance however it is hosted.
+const TRAKT_DEVICE_NOT_ENABLED = 'Trakt device authentication is not enabled on this instance.';
+const TRAKT_NOT_CONFIGURED = 'Trakt is not configured. Please set the TRAKT_CLIENT_ID and TRAKT_CLIENT_SECRET environment variables.';
+
+// A redeemed code stays recoverable this long, and a finished one keeps
+// answering this long, independent of the code's own expiry.
+const TRAKT_DEVICE_FINALISE_MS = 10 * 60 * 1000;
+const TRAKT_DEVICE_RECEIPT_MS = 5 * 60 * 1000;
+// Longest an exchange claim is held if its holder dies mid-request.
+const TRAKT_DEVICE_CLAIM_MS = 5 * 60 * 1000;
+// Bound on reading the account and storing the token, well inside the claim.
+const TRAKT_DEVICE_FINALISE_TIMEOUT_MS = 45 * 1000;
+
+function traktDeviceClient() {
+  const clientId = process.env.TRAKT_CLIENT_ID;
+  const clientSecret = process.env.TRAKT_CLIENT_SECRET;
+  if (!clientId || !clientSecret) return null;
+  return new TraktClient(clientId, clientSecret, TRAKT_DEVICE_REDIRECT);
+}
+
+addon.post("/api/auth/trakt/device", deviceAuthCallerRateLimit, async (req, res) => {
+  if (!traktDeviceEnabled()) {
+    return res.status(404).json({ error: TRAKT_DEVICE_NOT_ENABLED });
+  }
+  const traktClient = traktDeviceClient();
+  if (!traktClient) {
+    return res.status(500).json({ error: TRAKT_NOT_CONFIGURED });
+  }
+
+  try {
+    const device = await traktClient.requestDeviceCode();
+    // The device code stays server-side; only the short user code is shown.
+    const sessionId = createDeviceAuthSession('trakt', {
+      userCode: device.user_code,
+      deviceCode: device.device_code,
+      expiresIn: device.expires_in,
+      interval: device.interval,
+    });
+    res.json({
+      sessionId,
+      userCode: device.user_code,
+      verificationUrl: device.verification_url,
+      interval: device.interval,
+      expiresIn: device.expires_in,
+    });
+  } catch (error) {
+    consola.error("[Trakt device] Failed to request a device code:", error);
+    res.status(500).json({ error: "Failed to start the Trakt authorization" });
+  }
+});
+
+addon.get("/api/auth/trakt/device/status", deviceAuthRateLimit, async (req, res) => {
+  if (!traktDeviceEnabled()) {
+    return res.status(404).json({ error: TRAKT_DEVICE_NOT_ENABLED });
+  }
+  const traktClient = traktDeviceClient();
+  if (!traktClient) {
+    return res.status(500).json({ error: TRAKT_NOT_CONFIGURED });
+  }
+
+  try {
+    const sessionId = typeof req.query.sessionId === 'string' ? req.query.sessionId : '';
+    let session = await getDeviceAuthSession('trakt', sessionId);
+    if (!session) {
+      return res.status(404).json({ status: 'expired' });
+    }
+    if (session.completed) {
+      return res.json({ status: 'authorized', ...session.completed });
+    }
+    if (!session.deviceCode && !session.redeemed) {
+      return res.status(404).json({ status: 'expired' });
+    }
+
+    // One claim covers redeeming the single-use code and storing the token,
+    // so two pollers can never both exchange it or both insert a token row.
+    const claim = await claimDeviceAuthExchange(sessionId, TRAKT_DEVICE_CLAIM_MS);
+    if (!claim) {
+      return res.json({ status: 'pending' });
+    }
+    let claimHeldByFinalise = false;
+
+    try {
+      // Re-read under the claim: the previous holder may have moved it on.
+      session = await getDeviceAuthSession('trakt', sessionId);
+      if (!session) {
+        return res.status(404).json({ status: 'expired' });
+      }
+      if (session.completed) {
+        return res.json({ status: 'authorized', ...session.completed });
+      }
+
+      let redeemed = session.redeemed;
+      if (!redeemed) {
+        if (pollTooSoon(session)) {
+          return res.json({ status: 'pending' });
+        }
+        session.lastPolledAt = Date.now();
+        saveDeviceAuthSession(sessionId, session);
+
+        const poll = await traktClient.pollDeviceToken(session.deviceCode);
+        if (poll.status === 'pending') {
+          return res.json({ status: 'pending' });
+        }
+        if (poll.status === 'slow_down') {
+          widenPollGap(session);
+          saveDeviceAuthSession(sessionId, session);
+          return res.json({ status: 'slow_down' });
+        }
+        if (poll.status === 'expired' || poll.status === 'denied') {
+          deleteDeviceAuthSession(sessionId);
+          return res.json({ status: poll.status });
+        }
+
+        redeemed = {
+          access_token: poll.tokens.access_token,
+          refresh_token: poll.tokens.refresh_token,
+          expires_at: poll.tokens.expires_at,
+          scope: poll.tokens.scope,
+        };
+        // The code is spent: keep the tokens until they are stored.
+        session.redeemed = redeemed;
+        session.expiresAt = Math.max(session.expiresAt, Date.now() + TRAKT_DEVICE_FINALISE_MS);
+        saveDeviceAuthSession(sessionId, session);
+      }
+
+      try {
+        const finalise = (async () => {
+          const user = await traktClient.getMe(redeemed.access_token);
+          // Confirm the claim is still ours right before writing.
+          if (!await renewDeviceAuthClaim(claim, TRAKT_DEVICE_CLAIM_MS)) {
+            consola.warn('[Trakt device] Lost the exchange claim before storing the token; leaving it for the next poll');
+            return null;
+          }
+          const storedId = await persistTraktTokens(user, redeemed);
+          return storedId ? { tokenId: storedId, username: user.username } : null;
+        })();
+
+        // The claim is released when the work settles, not when this request
+        // stops waiting for it.
+        claimHeldByFinalise = true;
+        void finalise
+          .catch(() => undefined)
+          .finally(() => { releaseDeviceAuthExchange(claim); });
+
+        const finished = await Promise.race([
+          finalise,
+          new Promise<null>(resolve => {
+            setTimeout(() => resolve(null), TRAKT_DEVICE_FINALISE_TIMEOUT_MS).unref?.();
+          }),
+        ]);
+
+        if (finished) {
+          const { tokenId, username } = finished;
+          completeDeviceAuthSession(sessionId, 'trakt', { tokenId, username }, TRAKT_DEVICE_RECEIPT_MS);
+          consola.info(`[Trakt device] Connected user ${username} - tokenId: ${tokenId}`);
+          return res.json({ status: 'authorized', tokenId, username });
+        }
+      } catch (finishError) {
+        consola.warn(`[Trakt device] Could not finish the connection, will retry on the next poll: ${finishError?.message}`);
+      }
+
+      // The session keeps the redeemed token, so the next poll resumes from it.
+      res.json({ status: 'pending' });
+    } finally {
+      if (!claimHeldByFinalise) {
+        releaseDeviceAuthExchange(claim);
+      }
+    }
+  } catch (error) {
+    consola.error("[Trakt device] Status check failed:", error);
+    res.status(500).json({ error: "Failed to check the Trakt authorization status" });
+  }
+});
