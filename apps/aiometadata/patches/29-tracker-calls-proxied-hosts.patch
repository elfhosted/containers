+// A call made through a configured base URL is recorded under the tracker's own
+// host. Matched on a path boundary, so .../simkl-data is not .../simkl.
+const PROXIED_TRACKER_BASES: Array<[string, string]> = [
+  ['SIMKL_API_BASE', 'api.simkl.com'],
+  ['MDBLIST_API_BASE', 'api.mdblist.com'],
+  ['TRAKT_API_BASE', 'api.trakt.tv'],
+  ['ANILIST_API_BASE', 'graphql.anilist.co'],
+];
+
+function trackerHostOf(url: string): string | null {
+  for (const [env, canonical] of PROXIED_TRACKER_BASES) {
+    const base = (process.env[env] || '').replace(/\/+$/, '');
+    if (base && (url === base || url.startsWith(`${base}/`) || url.startsWith(`${base}?`))) return canonical;
+  }
+  try {
+    const host = new URL(url).hostname;
+    return TRACKER_HOSTS.has(host) ? host : null;
+  } catch {
+    return null;
+  }
+}
