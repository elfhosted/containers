+// Saved list URLs name api.mdblist.com; send them through MDBLIST_API_BASE at
+// fetch time. Cache keys keep the saved URL.
+function viaMdblistBase(savedUrl: string): string {
+  const saved = new URL(savedUrl);
+  if (saved.hostname !== 'api.mdblist.com') return savedUrl;
+  const base = new URL(MDBLIST_API_BASE);
+  return `${base.origin}${base.pathname.replace(/\/$/, '')}${saved.pathname}${saved.search}`;
+}
