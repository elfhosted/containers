+  /**
+   * Configurations with a MovieLens account linked. The filter runs in the
+   * database, so a sync pass reads a handful of rows rather than every
+   * configuration on the instance.
+   */
+  async getMovieLensConfigs(): Promise<Array<{ uuid: string; config: any }>> {
+    // CASE keeps a malformed row from failing the whole query: only rows that
+    // mention the key, and (on SQLite) hold valid JSON, are ever parsed.
+    const query = this.type === 'sqlite'
+      ? `SELECT user_uuid, config_data FROM user_configs
+          WHERE CASE WHEN json_valid(config_data)
+            THEN COALESCE(json_extract(config_data, '$.apiKeys.movieLensCredId'), '') != ''
+            ELSE 0 END`
+      : `SELECT user_uuid, config_data FROM user_configs
+          WHERE CASE WHEN config_data::text LIKE '%"movieLensCredId"%'
+            THEN COALESCE(config_data::jsonb->'apiKeys'->>'movieLensCredId', '') <> ''
+            ELSE false END`;
+    const rows = await this.allQuery(query);
+    return rows.map(row => ({
+      uuid: row.user_uuid,
+      config: typeof row.config_data === 'string' ? JSON.parse(row.config_data) : row.config_data
+    }));
+  }
