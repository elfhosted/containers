+    logger.info(`MovieLens re-sync pass already claimed by ${current || 'another process'}, skipping`);
+    return false;
+  } catch (e: any) {
+    // Without Redis the pass runs uncoordinated.
+    logger.warn(`Could not claim the MovieLens re-sync pass (${e.message}), running anyway`);
+    return null;
+  }
+}
