+/**
+ * Each process schedules the re-sync. The first to tick claims the pass; the
+ * claim lapses shortly before the next pass is due.
+ */
+const RUN_CLAIM_KEY = 'movielens-sync:run-claim';
+
+/**
+ * Resolves to the claim's token when this process should run (null when it runs
+ * without a claim), or false when another process holds the pass.
+ */
+async function claimSyncPass(intervalMs: number): Promise<string | null | false> {
+  const redis: any = require('./redisClient').default || require('./redisClient');
+  if (!redis) return null;
+  // Unique per claim, so a release never removes a later claim.
+  const token = `${process.env.HOSTNAME || `pid-${process.pid}`}:${crypto.randomUUID()}`;
+  const ttlSeconds = Math.max(60, Math.floor(intervalMs / 1000) - 600);
+  try {
+    if ((await redis.set(RUN_CLAIM_KEY, token, 'EX', ttlSeconds, 'NX')) === 'OK') return token;
