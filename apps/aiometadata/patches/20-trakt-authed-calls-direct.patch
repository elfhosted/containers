@@ -0,0 +1,44 @@
+/**
+ * Trakt requests that carry an Authorization header go to Trakt directly;
+ * everything else uses TRAKT_API_BASE. Shared by the Trakt client and utilities.
+ */
+import { httpGet as httpGetDirect, httpPost as httpPostDirect } from './httpClient.js';
+
+export const TRAKT_CONFIGURED_BASE_URL = process.env.TRAKT_API_BASE || 'https://api.trakt.tv';
+
+/**
+ * Trakt's own address. TRAKT_DIRECT_BASE overrides it only outside production,
+ * for tests.
+ */
+export const TRAKT_DIRECT_BASE_URL =
+  (process.env.NODE_ENV !== 'production' && process.env.TRAKT_DIRECT_BASE) || 'https://api.trakt.tv';
+
+function carriesCredentials(headers: any): boolean {
+  if (!headers) return false;
+  // Header names are case-insensitive.
+  if (typeof headers.forEach === 'function' && !Array.isArray(headers)) {
+    let found = false;
+    headers.forEach((_value: any, name: string) => {
+      if (String(name).toLowerCase() === 'authorization') found = true;
+    });
+    if (found) return true;
+  }
+  return Object.keys(headers).some(name => name.toLowerCase() === 'authorization');
+}
+
+export function traktUrlFor(url: string, options?: any): string {
+  if (TRAKT_CONFIGURED_BASE_URL === TRAKT_DIRECT_BASE_URL) return url;
+  if (!carriesCredentials(options?.headers)) return url;
+  return url.startsWith(TRAKT_CONFIGURED_BASE_URL)
+    ? TRAKT_DIRECT_BASE_URL + url.slice(TRAKT_CONFIGURED_BASE_URL.length)
+    : url;
+}
+
+// Drop-in replacements for the shared HTTP helpers.
+export function traktHttpGet(url: string, options: any = {}): ReturnType<typeof httpGetDirect> {
+  return httpGetDirect(traktUrlFor(url, options), options);
+}
+
+export function traktHttpPost(url: string, data: any, options: any = {}): ReturnType<typeof httpPostDirect> {
+  return httpPostDirect(traktUrlFor(url, options), data, options);
+}
