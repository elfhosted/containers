+                name="JellyStreams"
+                description="Set up in one tap, no UUID to type"
+                onClick={() =>
+                  jellystreamsSetupUrl &&
+                  window.open(jellystreamsSetupUrl, '_blank', 'noopener')
+                }
+              />
+            ) : jellyfinAvailable === false ? (
