 const APIError = constants.APIError;
 const logger = createLogger('users');
 
+/**
+ * ELFHOSTED churn-limit: how stale `users.accessed_at` is allowed to get
+ * before `loadRawUser` re-stamps it.
+ *
+ * `loadRawUser` runs on essentially every addon request (manifest, catalog,
+ * meta, stream, playback proxy), and each call unconditionally issued
+ * `UPDATE users SET accessed_at = CURRENT_TIMESTAMP WHERE uuid = ?`. That is
+ * one write per request against a small table, so each row is updated far
+ * more often than it changes. Postgres HOT-updates still write a new tuple
+ * version per update, so the table bloats badly and this single statement
+ * becomes the largest WAL producer in the database.
+ *
+ * A per-process cache cannot fix this: aiostreams runs many replicas and a
+ * client's requests fan out across all of them, so every replica would stamp
+ * the same hot row. The rate-limit therefore lives in the SQL predicate,
+ * where the database — the one component that sees every writer — enforces
+ * it. When the row was stamped recently the UPDATE simply matches no rows:
+ * no tuple version, no WAL, no vacuum debt.
+ *
+ * 1 hour is chosen to be far tighter than every consumer of the column:
+ *   - `UserRepository.pruneUsers()` deletes on `accessed_at < now - N *days*`
+ *     (`PRUNE_MAX_DAYS`, default `-1` = pruning disabled entirely). The
+ *     coarsest possible resolution that could ever delete a user is 1 day,
+ *     i.e. 24x this window. That alone is not a *proof* of safety — a stamp
+ *     trailing reality by up to an hour could delete a user an hour early —
+ *     so `pruneUsers` below widens its own cutoff by exactly this window.
+ *     Anything that deletes or disables on `accessed_at` must do the same.
+ *   - analytics/`/metrics` active-user gauges bucket at 1d / 7d / 30d.
+ *   - the admin dashboard's "Last accessed" column and its `accessed_at`
+ *     sort are informational only.
+ * The only observable change is that "Last accessed" can read up to 1h stale.
+ */
+const ACCESSED_AT_STAMP_WINDOW_HOURS = 1;
+
 interface UserRow {
   uuid: string;
   password_hash: string;
