index 00000000..4d2ee5c5
--- /dev/null
+++ b/packages/server/src/metrics.ts
@@ -0,0 +1,205 @@
+/**
+ * Prometheus metrics listener (ElfHosted).
+ *
+ * Deliberately a SEPARATE http.Server on its own port rather than a route on
+ * the main express app. Instances are internet-facing, so a `/metrics` route
+ * mounted there would be world-readable.
+ * Prometheus scrapes the pod IP on METRICS_PORT, which no ingress maps.
+ *
+ * No prom-client dependency: the text exposition format is a handful of
+ * lines, and adding a runtime dep here would mean regenerating
+ * pnpm-lock.yaml inside a patch, which is miserable to maintain across
+ * upstream bumps.
+ */
+import http from 'http';
+import {
+  AnalyticsRepository,
+  config as appConfig,
+  createLogger,
+} from '@aiostreams/core';
+
+const logger = createLogger('metrics');
+
+let server: http.Server | null = null;
+
+/** Escape a Prometheus label value per the exposition format spec. */
+function esc(v: string): string {
+  return v.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n');
+}
+
+type Line = { name: string; labels?: Record<string, string>; value: number };
+
+function render(metrics: Array<{ help: string; type: string; lines: Line[] }>) {
+  const out: string[] = [];
+  for (const m of metrics) {
+    if (!m.lines.length) continue;
+    out.push(`# HELP ${m.lines[0].name} ${m.help}`);
+    out.push(`# TYPE ${m.lines[0].name} ${m.type}`);
+    for (const l of m.lines) {
+      const labels = l.labels
+        ? '{' +
+          Object.entries(l.labels)
+            .map(([k, v]) => `${k}="${esc(v)}"`)
+            .join(',') +
+          '}'
+        : '';
+      out.push(`${l.name}${labels} ${l.value}`);
+    }
+  }
+  return out.join('\n') + '\n';
+}
+
+export async function collect(): Promise<string> {
+  const s = await AnalyticsRepository.abuseSnapshot();
+
+  const serviceLines: Line[] = [...s.serviceUsers.entries()].map(
+    ([service, value]) => ({
+      name: 'aiostreams_service_configs',
+      labels: { service },
+      value,
+    })
+  );
+
+  return render([
+    {
+      help: 'Build metadata. Always 1; read the labels.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_build_info',
+          labels: {
+            version: String(appConfig.bootstrap.version ?? 'unknown'),
+            tag: String(appConfig.bootstrap.tag ?? 'unknown'),
+          },
+          value: 1,
+        },
+      ],
+    },
+    {
+      help: 'Total user configs registered on this instance.',
+      type: 'gauge',
+      lines: [{ name: 'aiostreams_configs_total', value: s.totalUsers }],
+    },
+    {
+      help: 'User configs whose accessed_at falls within the window.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_configs_active',
+          labels: { window: '1d' },
+          value: s.activeUsers.d1,
+        },
+        {
+          name: 'aiostreams_configs_active',
+          labels: { window: '7d' },
+          value: s.activeUsers.d7,
+        },
+        {
+          name: 'aiostreams_configs_active',
+          labels: { window: '30d' },
+          value: s.activeUsers.d30,
+        },
+      ],
+    },
+    {
+      help: 'User configs created within the window.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_configs_created',
+          labels: { window: '1d' },
+          value: s.newUsers.d1,
+        },
+        {
+          name: 'aiostreams_configs_created',
+          labels: { window: '7d' },
+          value: s.newUsers.d7,
+        },
+        {
+          name: 'aiostreams_configs_created',
+          labels: { window: '30d' },
+          value: s.newUsers.d30,
+        },
+      ],
+    },
+    {
+      help: 'Distinct configs using each debrid service, taken from the most recent feature sample of each config.',
+      type: 'gauge',
+      lines: serviceLines,
+    },
+    {
+      help: 'Distinct third-party debrid accounts across all configs, taken from the most recent feature sample of each config.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_debrid_accounts_total',
+          value: s.debridAccounts,
+        },
+      ],
+    },
+    {
+      help: 'Debrid accounts presented by more than one config.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_debrid_accounts_shared',
+          value: s.debridAccountsShared,
+        },
+      ],
+    },
+    {
+      help: 'Most configs seen on any single debrid account.',
+      type: 'gauge',
+      lines: [
+        {
+          name: 'aiostreams_debrid_account_max_configs',
+          value: s.debridAccountMaxShared,
+        },
+      ],
+    },
+    {
+      help: 'Analytics events recorded in the last 24h.',
+      type: 'gauge',
+      lines: [{ name: 'aiostreams_events_24h', value: s.requests24h }],
+    },
+  ]);
+}
+
+export function startMetricsServer(): void {
+  const port = Number(appConfig.bootstrap.metricsPort) || 0;
+  if (!port) return;
+
+  server = http.createServer((req, res) => {
+    if (!req.url || req.url.split('?')[0] !== '/metrics') {
+      res.writeHead(404).end('not found\n');
+      return;
+    }
+    collect()
+      .then((body) => {
+        res.writeHead(200, {
+          'content-type': 'text/plain; version=0.0.4; charset=utf-8',
+        });
+        res.end(body);
+      })
+      .catch((err) => {
+        // A scrape must never take the addon down, and a failed scrape
+        // should be visible as a gap rather than as bogus zeroes.
+        logger.error('metrics collection failed', err);
+        res.writeHead(500).end('collection failed\n');
+      });
+  });
+
+  server.on('error', (err) => {
+    logger.error(`metrics listener error on port ${port}`, err);
+  });
+
+  server.listen(port, () => {
+    logger.info(`Metrics listener running on port ${port} (/metrics)`);
+  });
+}
+
+export async function stopMetricsServer(): Promise<void> {
+  if (!server) return;
+  await new Promise<void>((resolve) => server!.close(() => resolve()));
+  server = null;
+}
