@@ -115,6 +115,36 @@ const DEBRID_NON_RETRYABLE_CODES = new Set<DebridErrorCode | undefined>([
   'NOT_IMPLEMENTED',
 ]);
 
+/**
+ * A URL a store attached to an error, to be played when the failover chain
+ * ends without a playable result — typically a short video explaining why.
+ *
+ * Only ever consulted after the chain is done, so attaching one never
+ * suppresses a working source: a store that answers instantly with an
+ * explanation still cannot end the search early.
+ *
+ * Read out of the error body rather than a typed field, because the value
+ * originates upstream of this client and travels as opaque JSON. Parsed
+ * rather than pattern-matched so that a malformed value is rejected instead
+ * of being handed to a redirect.
+ */
+export function storeFallbackUrl(error: unknown): string | undefined {
+  const body = (error as DebridError | undefined)?.body as
+    | { fallback_url?: unknown; error?: { fallback_url?: unknown } }
+    | undefined;
+  const raw = body?.fallback_url ?? body?.error?.fallback_url;
+  if (typeof raw !== 'string') return undefined;
+  try {
+    const parsed = new URL(raw);
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:')
+      return undefined;
+    if (!parsed.hostname) return undefined;
+    return parsed.toString();
+  } catch {
+    return undefined;
+  }
+}
+
 /**
  * Shared cross-service failure cache
  */
