--- a/packages/core/src/debrid/base.ts
+++ b/packages/core/src/debrid/base.ts
@@ -115,6 +115,23 @@ const DEBRID_NON_RETRYABLE_CODES = new Set<DebridErrorCode | undefined>([
   'NOT_IMPLEMENTED',
 ]);
 
+export function storeFallbackUrl(error: unknown): string | undefined {
+  const body = (error as DebridError | undefined)?.body as
+    | { fallback_url?: unknown; error?: { fallback_url?: unknown } }
+    | undefined;
+  const raw = body?.fallback_url ?? body?.error?.fallback_url;
+  if (typeof raw !== 'string') return undefined;
+  try {
+    const parsed = new URL(raw);
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:')
+      return undefined;
+    if (!parsed.hostname) return undefined;
+    return parsed.toString();
+  } catch {
+    return undefined;
+  }
+}
+
