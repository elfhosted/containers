diff --git a/packages/core/src/builtins/utils/sharedIndex.test.ts b/packages/core/src/builtins/utils/sharedIndex.test.ts
new file mode 100644
index 0000000..9a04f83
--- /dev/null
+++ b/packages/core/src/builtins/utils/sharedIndex.test.ts
@@ -0,0 +1,28 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { optedOutFor } from './sharedIndex.js';
+
+describe('shared index participation', () => {
+  it('participates only when both settings agree', () => {
+    assert.equal(optedOutFor(true, true), false);
+  });
+
+  it('opts out on either setting', () => {
+    // Reading and contributing are one decision, so neither survives alone.
+    assert.equal(optedOutFor(false, true), true);
+    assert.equal(optedOutFor(true, false), true);
+    assert.equal(optedOutFor(false, false), true);
+  });
+
+  it('treats an unset contribute setting as not participating', () => {
+    // It defaults to false, and the gated indexer has always been refused on
+    // that basis -- querying now follows the same rule.
+    assert.equal(optedOutFor(true, undefined), true);
+  });
+
+  it('treats an unset participation setting as participating', () => {
+    // Its default is true, so only an explicit false opts out through it.
+    assert.equal(optedOutFor(undefined, true), false);
+    assert.equal(optedOutFor(undefined, false), true);
+  });
+});
diff --git a/packages/core/src/builtins/utils/sharedIndex.ts b/packages/core/src/builtins/utils/sharedIndex.ts
new file mode 100644
index 0000000..088932c
--- /dev/null
+++ b/packages/core/src/builtins/utils/sharedIndex.ts
@@ -0,0 +1,38 @@
+import { config as appConfig } from '../../config/index.js';
+
+/**
+ * Participation in the shared health index.
+ *
+ * The index is built from the NZBs its participants contribute, so reading it
+ * and writing to it are one decision, not two. An instance that is not
+ * contributing does not query the index and cannot use the gated indexer.
+ * There is deliberately no "read but do not write" mode.
+ *
+ * Two settings say the same thing:
+ *
+ *   ZYCLOPS_INGEST                  false opts out. This is the name shared
+ *                                   with the other clients of the index, so
+ *                                   one documented setting means the same
+ *                                   thing wherever it is set.
+ *   BUILTIN_NAB_HEALTH_CONTRIBUTE   false also opts out. It predates the
+ *                                   shared name and already governed both
+ *                                   contribution and the gated indexer.
+ *
+ * Either being false is enough.
+ */
+/**
+ * The rule itself, as a function of the two settings. Kept separate from the
+ * settings read so it can be exercised directly: appConfig is not resolved at
+ * module-load time, so a test cannot read it.
+ */
+export const optedOutFor = (
+  zyclopsIngest: boolean | undefined,
+  healthContribute: boolean | undefined
+): boolean => zyclopsIngest === false || healthContribute !== true;
+
+/** Binds the rule to the resolved settings. */
+export const isOptedOut = (): boolean =>
+  optedOutFor(
+    appConfig.builtins.nab.zyclopsIngest,
+    appConfig.builtins.nab.healthContribute
+  );
