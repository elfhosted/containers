diff --git a/packages/core/src/utils/http.cooldown.test.ts b/packages/core/src/utils/http.cooldown.test.ts
new file mode 100644
index 0000000..438171b
--- /dev/null
+++ b/packages/core/src/utils/http.cooldown.test.ts
@@ -0,0 +1,147 @@
+import assert from 'node:assert/strict';
+import { describe, it, mock } from 'node:test';
+import {
+  getGlobalDispatcher,
+  Headers,
+  MockAgent,
+  setGlobalDispatcher,
+} from 'undici';
+
+// Read when the settings store initialises.
+process.env.BUILTIN_NZB_REPLAY_DOWNLOAD_URL = 'https://forwarder.test/nzb';
+process.env.REQUEST_URL_MAPPINGS = JSON.stringify({
+  'https://forwarder.test': 'http://forwarder.internal:8080',
+});
+
+const { settingsStore } = await import('../config/index.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+const { cooldownKey, cooldownTargetUrl, makeRequest, RateLimitedError } =
+  await import('./http.js');
+
+const FORWARDER = 'https://forwarder.example/nzb';
+
+function forwarded(inner: string): URL {
+  const url = new URL(FORWARDER);
+  url.searchParams.set('url', inner);
+  return url;
+}
+
+function keyFor(url: URL, explicitTarget?: string): string {
+  return cooldownKey(
+    cooldownTargetUrl(url, FORWARDER, explicitTarget),
+    new Headers(),
+    ''
+  ).key;
+}
+
+describe('cooldownTargetUrl', () => {
+  it('keys forwarded downloads on their target, per indexer and account', () => {
+    const a = forwarded('https://indexer-a.example/api?t=get&id=1&apikey=aaa');
+    const a2 = forwarded('https://indexer-a.example/api?t=get&id=2&apikey=aaa');
+    const b = forwarded('https://indexer-b.example/api?t=get&id=1&apikey=aaa');
+    const other = forwarded(
+      'https://indexer-a.example/api?t=get&id=1&apikey=bbb'
+    );
+
+    assert.equal(keyFor(a), keyFor(a2));
+    assert.notEqual(keyFor(a), keyFor(b));
+    assert.notEqual(keyFor(a), keyFor(other));
+    assert.equal(
+      cooldownKey(cooldownTargetUrl(a, FORWARDER), new Headers(), '').anon,
+      false
+    );
+  });
+
+  it('keys a forwarded search on the explicit target', () => {
+    const endpoint = new URL('https://forwarder.example/search');
+    assert.notEqual(
+      keyFor(endpoint, 'https://indexer-a.example/api?t=search&apikey=aaa'),
+      keyFor(endpoint, 'https://indexer-b.example/api?t=search&apikey=aaa')
+    );
+  });
+
+  it('leaves other URLs alone', () => {
+    const direct = new URL('https://indexer-a.example/api?t=get&apikey=aaa');
+    assert.equal(cooldownTargetUrl(direct, FORWARDER), direct);
+    assert.equal(cooldownTargetUrl(direct, undefined), direct);
+    const samePathElsewhere = new URL('https://elsewhere.example/nzb?url=x');
+    assert.equal(
+      cooldownTargetUrl(samePathElsewhere, FORWARDER),
+      samePathElsewhere
+    );
+  });
+
+  it('falls back to the request URL when the target is unparseable', () => {
+    const bad = forwarded('not a url');
+    assert.equal(cooldownTargetUrl(bad, FORWARDER), bad);
+  });
+});
+
+describe('makeRequest cooldowns through the forwarding endpoints', () => {
+  it('keeps one target\'s 429 from holding back another, with URL mappings', async (t) => {
+    mock.method(SettingsRepository, 'getAll', async () => []);
+    mock.method(SettingsRepository, 'getVersion', async () => 0);
+    await settingsStore.initialise();
+    const agent = new MockAgent();
+    agent.disableNetConnect();
+    const previous = getGlobalDispatcher();
+    setGlobalDispatcher(agent);
+    t.after(() => setGlobalDispatcher(previous));
+
+    const limited = 'https://indexer-a.test/api?t=get&id=1&apikey=aaa';
+    const fine = 'https://indexer-b.test/api?t=get&id=1&apikey=aaa';
+    const download = (target: string) => {
+      const url = new URL('https://forwarder.test/nzb');
+      url.searchParams.set('url', target);
+      return url.toString();
+    };
+    const pool = agent.get('http://forwarder.internal:8080');
+    for (const [target, status] of [
+      [limited, 429],
+      [fine, 200],
+    ] as const) {
+      const path = new URL(download(target));
+      pool
+        .intercept({ path: `${path.pathname}${path.search}` })
+        .reply(status, 'nzb', { headers: { 'Retry-After': '60' } })
+        .persist();
+    }
+    pool
+      .intercept({ path: '/search', method: 'POST' })
+      .reply(200, 'ok')
+      .persist();
+
+    assert.equal(
+      (await makeRequest(download(limited), { timeout: 1000 })).status,
+      429
+    );
+    assert.equal(
+      (await makeRequest(download(fine), { timeout: 1000 })).status,
+      200
+    );
+    await assert.rejects(
+      makeRequest(download(limited), { timeout: 1000 }),
+      RateLimitedError
+    );
+
+    // A forwarded search names its target explicitly.
+    await assert.rejects(
+      makeRequest('https://forwarder.test/search', {
+        method: 'POST',
+        timeout: 1000,
+        cooldownTarget: limited,
+      }),
+      RateLimitedError
+    );
+    assert.equal(
+      (
+        await makeRequest('https://forwarder.test/search', {
+          method: 'POST',
+          timeout: 1000,
+          cooldownTarget: fine,
+        })
+      ).status,
+      200
+    );
+  });
+});
