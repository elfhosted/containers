+    // the path-scoped grab never armed.
+    assert.equal(
+      (
+        await makeRequest('https://forwarder.test/search', {
+          method: 'POST',
+          timeout: 1000,
+          cooldownTarget: 'https://manager.test/1/api?t=search&apikey=aaa',
+        })
+      ).status,
+      200
+    );
+  });
+});
