+    setGlobalDispatcher(agent);
+    t.after(() => setGlobalDispatcher(previous));
+
+    const limited = 'https://indexer-a.test/api?t=get&id=1&apikey=aaa';
+    const fine = 'https://indexer-b.test/api?t=get&id=1&apikey=aaa';
+    const download = (target: string) => {
+      const url = new URL('https://forwarder.test/nzb');
+      url.searchParams.set('url', target);
