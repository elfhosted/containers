+/**
+ * The URL whose origin and credentials identify a request for cooldowns.
+ * Forwarded NZB downloads carry their target in the `url` parameter of the
+ * forwarding URL; keyed on the forwarding endpoint, one upstream's 429 would
+ * hold back every indexer and account routed through it.
+ */
+export function cooldownTargetUrl(
+  urlObj: URL,
+  forwardingDownloadUrl: string | null | undefined,
+  explicitTarget?: string
+): URL {
+  try {
+    if (explicitTarget) return new URL(explicitTarget);
+    if (!forwardingDownloadUrl) return urlObj;
+    const base = new URL(forwardingDownloadUrl);
+    if (urlObj.origin !== base.origin || urlObj.pathname !== base.pathname) {
+      return urlObj;
+    }
+    const inner = urlObj.searchParams.get('url');
+    return inner ? new URL(inner) : urlObj;
+  } catch {
+    return urlObj;
+  }
+}
+
+// Request URLs reach the cooldown check already rewritten, so the base they
+// are matched against is rewritten the same way.
+function forwardingDownloadBase(): string | undefined {
+  const base = appConfig.builtins.nab.replayDownloadUrl;
+  if (!base) return undefined;
+  try {
+    return rewriteRequestUrl(new URL(base)).toString();
+  } catch {
+    return undefined;
+  }
+}
