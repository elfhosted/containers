+++ b/packages/core/src/debrid/utils.nzbhash.base.test.ts
@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { before, describe, it, mock } from 'node:test';
+
+// A base with a repeated parameter and a `url` placeholder the builder
+// replaces (newznab/addon.ts buildReplayDownloadUrl sets `url`).
+process.env.BUILTIN_NZB_REPLAY_DOWNLOAD_URL =
+  'https://forwarder.test/nzb?mode=a&mode=b&url=';
+
+const { settingsStore } = await import('../config/index.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+// The barrel settles debrid/utils' import cycle before it is loaded directly.
+await import('../index.js');
+const { hashNzbUrl, sentNzbHash, unwrapForwardingUrl } =
+  await import('./utils.js');
+
+const BASE = 'https://forwarder.test/nzb?mode=a&mode=b&url=';
+
+function forwarded(inner: string): string {
+  const url = new URL(BASE);
+  url.searchParams.set('url', inner);
+  return url.toString();
+}
+
+const md5 = (value: string) => createHash('md5').update(value).digest('hex');
+
+describe('a forwarding base with a repeated selector and a url placeholder', () => {
+  before(async () => {
+    mock.method(SettingsRepository, 'getAll', async () => []);
+    mock.method(SettingsRepository, 'getVersion', async () => 0);
+    await settingsStore.initialise();
+  });
+
+  const a = 'https://indexer-a.test/api?t=get&id=42&apikey=aaa';
+  const b = 'https://indexer-a.test/api?t=get&id=43&apikey=aaa';
+
+  it('recognises the wrappers the builder emits', () => {
+    assert.equal(unwrapForwardingUrl(forwarded(a)), a);
+    assert.equal(hashNzbUrl(forwarded(a)), hashNzbUrl(a));
+    assert.notEqual(sentNzbHash(forwarded(a)), sentNzbHash(forwarded(b)));
+    assert.equal(sentNzbHash(forwarded(a)), md5(forwarded(a)));
+  });
+
+  it('requires the whole repeated selector', () => {
+    const partial =
+      'https://forwarder.test/nzb?mode=a&url=' + encodeURIComponent(a);
+    assert.equal(unwrapForwardingUrl(partial), partial);
+    assert.notEqual(hashNzbUrl(partial), hashNzbUrl(a));
+  });
+});
diff --git a/packages/core/src/debrid/utils.nzbhash.test.ts b/packages/core/src/debrid/utils.nzbhash.test.ts
new file mode 100644
index 0000000..a2c077e
--- /dev/null
+++ b/packages/core/src/debrid/utils.nzbhash.test.ts
@@ -0,0 +1,134 @@
+import assert from 'node:assert/strict';
+import { before, describe, it, mock } from 'node:test';
+import { createHash } from 'node:crypto';
+
+// Read when the settings store initialises.
+// A base with a parameter of its own, which a wrapper must carry too.
+process.env.BUILTIN_NZB_REPLAY_DOWNLOAD_URL =
+  'https://forwarder.test/nzb?mode=forward';
+
+const { settingsStore } = await import('../config/index.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+// The barrel settles debrid/utils' import cycle before it is loaded directly.
+await import('../index.js');
+const {
+  canonicalNzbHash,
+  hashNzbUrl,
+  sentNzbHash,
+  unwrapForwardingUrl,
+  unwrapNzbUrl,
+} = await import('./utils.js');
+const { toUrlSafeBase64 } = await import('../utils/index.js');
+
+const FORWARDER = 'https://forwarder.test/nzb?mode=forward';
+
+function forwarded(inner: string, base: string = FORWARDER): string {
+  const url = new URL(base);
+  url.searchParams.set('url', inner);
+  return url.toString();
+}
+
+/** One of our unencrypted NZB proxy URLs, as the proxy route would mint it. */
+function proxied(inner: string): string {
+  const token = [
+    'u',
+    toUrlSafeBase64('user:secret'),
+    toUrlSafeBase64(JSON.stringify({ url: inner, type: 'nzb' })),
+  ].join('.');
+  return `https://aiostreams.test/api/v1/proxy/${token}/release.nzb`;
+}
+
+describe('NZB hashes see through the forwarding endpoint', () => {
+  before(async () => {
+    mock.method(SettingsRepository, 'getAll', async () => []);
+    mock.method(SettingsRepository, 'getVersion', async () => 0);
+    await settingsStore.initialise();
+  });
+
+  const enclosure = 'https://indexer-a.test/api?t=get&id=42&apikey=aaa';
+
+  it('unwraps one or more forwarding layers and nothing else', () => {
+    assert.equal(unwrapForwardingUrl(forwarded(enclosure)), enclosure);
+    assert.equal(
+      unwrapForwardingUrl(forwarded(forwarded(enclosure))),
+      enclosure
+    );
+    assert.equal(unwrapForwardingUrl(enclosure), enclosure);
+    const elsewhere = forwarded(enclosure, 'https://elsewhere.test/nzb');
+    assert.equal(unwrapForwardingUrl(elsewhere), elsewhere);
+    assert.equal(unwrapForwardingUrl(FORWARDER), FORWARDER);
+    // Same origin and path, but not the base's own parameter: an indexer
+    // link, not a wrapper.
+    const lookalike =
+      'https://forwarder.test/nzb?t=get&id=1&url=https://x.test/';
+    assert.equal(unwrapForwardingUrl(lookalike), lookalike);
+    assert.notEqual(hashNzbUrl(lookalike), hashNzbUrl('https://x.test/'));
+    assert.equal(unwrapForwardingUrl('not a url'), 'not a url');
+  });
+
+  it('peels interleaved proxy and forwarding layers', () => {
+    assert.equal(unwrapNzbUrl(proxied(enclosure)), enclosure);
+    assert.equal(unwrapNzbUrl(proxied(forwarded(enclosure))), enclosure);
+    // An already-proxied enclosure, forwarded and proxied again.
+    const nested = proxied(forwarded(proxied(enclosure)));
+    assert.equal(unwrapNzbUrl(nested), enclosure);
+    assert.equal(hashNzbUrl(nested), hashNzbUrl(enclosure));
+    assert.equal(canonicalNzbHash(nested).known, true);
+  });
+
+  it('hashes a forwarded NZB by the indexer link behind it', () => {
+    assert.equal(hashNzbUrl(forwarded(enclosure)), hashNzbUrl(enclosure));
+    assert.equal(
+      hashNzbUrl(forwarded(forwarded(enclosure))),
+      hashNzbUrl(enclosure)
+    );
+    assert.equal(canonicalNzbHash(forwarded(enclosure)).known, true);
+  });
+
+  it('keeps distinct NZBs distinct through the wrapper', () => {
+    // The wrapper's own URL identifies no release: hashed as such, every
+    // forwarded NZB would share one hash.
+    const other = 'https://indexer-a.test/api?t=get&id=43&apikey=aaa';
+    assert.notEqual(
+      hashNzbUrl(forwarded(enclosure)),
+      hashNzbUrl(forwarded(other))
+    );
+    assert.equal(hashNzbUrl(forwarded(other)), hashNzbUrl(other));
+  });
+
+  it('still hashes what a remote service receives when asked', () => {
+    assert.notEqual(
+      hashNzbUrl(forwarded(enclosure), false),
+      hashNzbUrl(enclosure)
+    );
+  });
+
+  it('keeps forwarded NZBs distinct in the hash a service files them under', () => {
+    // sentNzbHash cleans an unknown URL of its query, which for the wrapper
+    // is the whole identity: service checks would key every forwarded NZB
+    // under one hash. The wrapper is a known shape instead.
+    const other = 'https://indexer-a.test/api?t=get&id=43&apikey=aaa';
+    assert.notEqual(
+      sentNzbHash(forwarded(enclosure)),
+      sentNzbHash(forwarded(other))
+    );
+    assert.equal(
+      sentNzbHash(forwarded(enclosure)),
+      hashNzbUrl(forwarded(enclosure), false)
+    );
+    // Not the wrapper base's hash, and still not the indexer link's.
+    assert.notEqual(sentNzbHash(forwarded(enclosure)), sentNzbHash(FORWARDER));
+    assert.notEqual(sentNzbHash(forwarded(enclosure)), hashNzbUrl(enclosure));
+    // The canonical hash peels the wrapper first and is unaffected.
+    assert.equal(hashNzbUrl(forwarded(enclosure)), hashNzbUrl(enclosure));
+    // The whole wrapper, base parameters included: what a service that
+    // hashes the URL it is sent files it under.
+    const md5 = (value: string) =>
+      createHash('md5').update(value).digest('hex');
+    assert.equal(
+      hashNzbUrl(forwarded(enclosure), false),
+      md5(forwarded(enclosure))
+    );
+    assert.equal(sentNzbHash(forwarded(enclosure)), md5(forwarded(enclosure)));
+  });
+});
