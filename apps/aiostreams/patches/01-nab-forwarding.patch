+    );
+    const search = (indexer: number) =>
+      makeRequest('https://forwarder.test/search', {
+        method: 'POST',
+        timeout: 1000,
+        cooldownTarget: `https://manager.test/${indexer}/api?t=search&apikey=aaa`,
+        cooldownContext: 'newznab',
+      });
+    await assert.rejects(search(1), RateLimitedError);
+    assert.equal((await search(2)).status, 200);
