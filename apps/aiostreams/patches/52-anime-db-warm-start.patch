+
+/** When the source cached at `filePath` was last checked, if ever. */
+export async function readLastChecked(
+  filePath: string
+): Promise<number | null> {
+  try {
+    const raw = (await fs.readFile(checkedPathFor(filePath), 'utf8')).trim();
+    const at = Number(raw);
+    return /^\d+$/.test(raw) && Number.isSafeInteger(at) ? at : null;
+  } catch {
