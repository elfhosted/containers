diff --git a/packages/core/src/anime-database/startup-refresh.test.ts b/packages/core/src/anime-database/startup-refresh.test.ts
new file mode 100644
index 00000000..c1aff74e
--- /dev/null
+++ b/packages/core/src/anime-database/startup-refresh.test.ts
@@ -0,0 +1,76 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {
+  checkedPathFor,
+  isSourceDue,
+  readLastChecked,
+} from './database.js';
+
+const DAY = 86_400_000;
+
+describe('isSourceDue', () => {
+  const now = 1_800_000_000_000;
+
+  it('is due when never checked', () => {
+    assert.equal(isSourceDue(null, DAY, now), true);
+  });
+
+  it('is not due inside the interval', () => {
+    assert.equal(isSourceDue(now - DAY + 1, DAY, now), false);
+    assert.equal(isSourceDue(now, DAY, now), false);
+  });
+
+  it('is due once the interval has passed', () => {
+    assert.equal(isSourceDue(now - DAY, DAY, now), true);
+    assert.equal(isSourceDue(now - 7 * DAY, DAY, now), true);
+  });
+
+  it('is due when the stamp is in the future', () => {
+    assert.equal(isSourceDue(now + 60_000, DAY, now), true);
+  });
+});
+
+describe('readLastChecked', () => {
+  async function withStamp<T>(
+    contents: string | null,
+    fn: (filePath: string) => Promise<T>
+  ): Promise<T> {
+    const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'aios-checked-'));
+    const filePath = path.join(dir, 'source.json');
+    try {
+      if (contents !== null) {
+        await fs.writeFile(checkedPathFor(filePath), contents);
+      }
+      return await fn(filePath);
+    } finally {
+      await fs.rm(dir, { recursive: true, force: true });
+    }
+  }
+
+  it('reads a written stamp', async () => {
+    await withStamp('1800000000000', async (f) =>
+      assert.equal(await readLastChecked(f), 1_800_000_000_000)
+    );
+  });
+
+  it('tolerates a trailing newline', async () => {
+    await withStamp('1800000000000\n', async (f) =>
+      assert.equal(await readLastChecked(f), 1_800_000_000_000)
+    );
+  });
+
+  it('is null when there is no stamp', async () => {
+    await withStamp(null, async (f) => assert.equal(await readLastChecked(f), null));
+  });
+
+  it('is null for a damaged stamp', async () => {
+    for (const bad of ['', 'abc', '-5', '1.5', '99999999999999999999']) {
+      await withStamp(bad, async (f) =>
+        assert.equal(await readLastChecked(f), null, `stamp ${JSON.stringify(bad)}`)
+      );
+    }
+  });
+});
