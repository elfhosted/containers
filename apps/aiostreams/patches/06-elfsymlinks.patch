index 0000000..a10add8
--- /dev/null
+++ b/packages/core/src/builtins/elfsymlinks/signing.ts
@@ -0,0 +1,78 @@
+import { createHmac, timingSafeEqual } from 'crypto';
+import { config as appConfig } from '../../config/index.js';
+
+const toBase64Url = (buf: Buffer): string =>
+  buf
+    .toString('base64')
+    .replace(/=+$/, '')
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_');
+
+const fromBase64Url = (s: string): Buffer => {
+  const padded = s.replace(/-/g, '+').replace(/_/g, '/');
+  const pad = padded.length % 4 === 0 ? '' : '='.repeat(4 - (padded.length % 4));
+  return Buffer.from(padded + pad, 'base64');
+};
+
+const hmac = (payload: string): string =>
+  toBase64Url(
+    createHmac('sha256', appConfig.bootstrap.internalSecret)
+      .update(payload)
+      .digest()
+  );
+
+export interface SignedFileToken {
+  path: string;
+  exp: number;
+}
+
+export const signFileToken = (
+  relativePath: string,
+  validForMs: number
+): string => {
+  const token: SignedFileToken = {
+    path: relativePath,
+    exp: Date.now() + validForMs,
+  };
+  const payload = toBase64Url(Buffer.from(JSON.stringify(token), 'utf8'));
+  return `${payload}.${hmac(payload)}`;
+};
+
+export interface VerifiedToken {
+  ok: true;
+  path: string;
+}
+export interface InvalidToken {
+  ok: false;
+  reason: 'malformed' | 'bad-signature' | 'expired';
+}
+
+export const verifyFileToken = (
+  token: string
+): VerifiedToken | InvalidToken => {
+  const dot = token.indexOf('.');
+  if (dot === -1) return { ok: false, reason: 'malformed' };
+  const payload = token.slice(0, dot);
+  const sig = token.slice(dot + 1);
+  const expected = hmac(payload);
+  const sigBuf = Buffer.from(sig);
+  const expBuf = Buffer.from(expected);
+  if (sigBuf.length !== expBuf.length) {
+    return { ok: false, reason: 'bad-signature' };
+  }
+  if (!timingSafeEqual(sigBuf, expBuf)) {
+    return { ok: false, reason: 'bad-signature' };
+  }
+  try {
+    const decoded = JSON.parse(
+      fromBase64Url(payload).toString('utf8')
+    ) as SignedFileToken;
+    if (typeof decoded.path !== 'string' || typeof decoded.exp !== 'number') {
+      return { ok: false, reason: 'malformed' };
+    }
+    if (Date.now() > decoded.exp) return { ok: false, reason: 'expired' };
+    return { ok: true, path: decoded.path };
+  } catch {
+    return { ok: false, reason: 'malformed' };
+  }
+};
