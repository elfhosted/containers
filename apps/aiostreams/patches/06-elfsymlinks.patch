new file mode 100644
index 0000000..0389ae7
--- /dev/null
+++ b/packages/core/src/builtins/elfsymlinks/addon.ts
@@ -0,0 +1,326 @@
+import { z } from 'zod';
+import {
+  Manifest,
+  Meta,
+  MetaPreview,
+  Stream,
+} from '../../db/schemas.js';
+import {
+  createLogger,
+  ExtrasParser,
+  IdParser,
+} from '../../utils/index.js';
+import { config as appConfig } from '../../config/index.js';
+import {
+  CatalogEntry,
+  findEpisodesByImdbId,
+  findMoviesByImdbId,
+  listCatalog,
+  listSeriesEpisodes,
+  SymlinkMatch,
+} from './scanner.js';
+import { signFileToken } from './signing.js';
+import { enrichWithTmdb, enrichEntry, EnrichedEntry } from './enrich.js';
+
+const logger = createLogger('elfsymlinks');
+
+const DEFAULT_FILE_URL_VALIDITY_MS = 24 * 60 * 60 * 1000;
+
+const safeDecode = (s: string): string => {
+  try {
+    return decodeURIComponent(s);
+  } catch {
+    return s;
+  }
+};
+
+export const ElfSymlinksConfigSchema = z
+  .object({
+    fileUrlValidityMs: z
+      .number()
+      .int()
+      .positive()
+      .default(DEFAULT_FILE_URL_VALIDITY_MS),
+    tmdbAccessToken: z.string().optional(),
+    tmdbApiKey: z.string().optional(),
+  })
+  .strict();
+
+export type ElfSymlinksConfig = z.infer<typeof ElfSymlinksConfigSchema>;
+
+export const ELFSYMLINKS_MOVIE_CATALOG_ID = 'elfsymlinks-recent-movies';
+export const ELFSYMLINKS_SERIES_CATALOG_ID = 'elfsymlinks-recent-series';
+
+const CATALOG_PAGE_SIZE = 100;
+
+export class ElfSymlinksAddon {
+  private readonly userData: ElfSymlinksConfig;
+
+  constructor(userData?: Partial<ElfSymlinksConfig>) {
+    this.userData = ElfSymlinksConfigSchema.parse(userData ?? {});
+  }
+
+  private get root(): string | undefined {
+    return appConfig.builtins.elfsymlinks.root ?? undefined;
+  }
+
+  private requireRoot(): string {
+    if (!this.root) {
+      throw new Error(
+        'builtins.elfsymlinks.root (BUILTIN_ELFSYMLINKS_ROOT) is not configured on the server.'
+      );
+    }
+    return this.root;
+  }
+
+  private tmdbAuth() {
+    return {
+      accessToken: this.userData.tmdbAccessToken,
+      apiKey: this.userData.tmdbApiKey,
+    };
+  }
+
+  static getManifest(): Manifest {
+    return {
+      id: 'com.elfhosted.elfsymlinks',
+      version: '1.0.0',
+      name: 'ElfSymlinks',
+      description:
+        "For ElfHosted users with a Personal Media Stack: searches your existing symlinks for matching content and exposes a 'recently added' catalog of movies and TV.",
+      types: ['movie', 'series'],
+      catalogs: [
+        {
+          id: ELFSYMLINKS_MOVIE_CATALOG_ID,
+          name: 'ElfSymlinks',
+          type: 'movie',
+          extra: [{ name: 'skip' }, { name: 'search' }],
+        },
+        {
+          id: ELFSYMLINKS_SERIES_CATALOG_ID,
+          name: 'ElfSymlinks',
+          type: 'series',
+          extra: [{ name: 'skip' }, { name: 'search' }],
+        },
+      ],
+      resources: [
+        {
+          name: 'stream',
+          types: ['movie', 'series'],
+          idPrefixes: IdParser.getPrefixes(['imdbId']),
+        },
+        {
+          name: 'catalog',
+          types: ['movie', 'series'],
+          idPrefixes: ['elfsymlinks'],
+        },
+        {
+          name: 'meta',
+          types: ['movie', 'series'],
+          idPrefixes: IdParser.getPrefixes(['imdbId']),
+        },
+      ],
+      behaviorHints: {
+        adult: false,
+        p2p: false,
+        configurable: false,
+        configurationRequired: false,
+      },
+    };
+  }
+
+  public getManifest(): Manifest {
+    return ElfSymlinksAddon.getManifest();
+  }
+
+  public async getStreams(type: string, id: string): Promise<Stream[]> {
+    const root = this.requireRoot();
+    const parsedId = IdParser.parse(id, type);
+    if (!parsedId || parsedId.type !== 'imdbId') {
+      throw new Error(`Unsupported ID for ElfSymlinks: ${id}`);
+    }
+
+    const imdbId = String(parsedId.value);
+
+    let matches: SymlinkMatch[] = [];
+    if (type === 'movie') {
+      matches = await findMoviesByImdbId(root, imdbId);
+    } else if (type === 'series') {
+      const season =
+        parsedId.season !== undefined ? Number(parsedId.season) : undefined;
+      const episode =
+        parsedId.episode !== undefined ? Number(parsedId.episode) : undefined;
+      if (
+        season === undefined ||
+        episode === undefined ||
+        Number.isNaN(season) ||
+        Number.isNaN(episode)
+      ) {
+        throw new Error(`Series stream request missing season/episode: ${id}`);
+      }
+      matches = await findEpisodesByImdbId(root, imdbId, season, episode);
+    } else {
+      logger.debug(`Unsupported type for ElfSymlinks: ${type}`);
+      return [];
+    }
+
+    if (matches.length === 0) {
+      logger.debug(
+        `No ElfSymlinks matches for ${type} ${id} (imdb ${imdbId})`
+      );
+      return [];
+    }
+
+    return matches.map((m) => this.createStream(m));
+  }
+
+  public async getCatalog(
+    type: string,
+    catalogId: string,
+    extras?: string
+  ): Promise<MetaPreview[]> {
+    const root = this.requireRoot();
+    const parsedExtras = extras ? new ExtrasParser(extras) : undefined;
+    const skip = parsedExtras?.skip ?? 0;
+    const search = parsedExtras?.search
+      ? safeDecode(parsedExtras.search).toLowerCase()
+      : undefined;
+
+    let stremioType: 'movie' | 'series';
+    if (type === 'movie' && catalogId === ELFSYMLINKS_MOVIE_CATALOG_ID) {
+      stremioType = 'movie';
+    } else if (
+      type === 'series' &&
+      catalogId === ELFSYMLINKS_SERIES_CATALOG_ID
+    ) {
+      stremioType = 'series';
+    } else {
+      throw new Error(`Unsupported catalog: ${type}/${catalogId}`);
+    }
+
+    let entries = await listCatalog(root, stremioType);
+    if (search) {
+      entries = entries.filter((e) => e.title.toLowerCase().includes(search));
+    }
+    const page = entries.slice(skip, skip + CATALOG_PAGE_SIZE);
+    const enriched = await enrichWithTmdb(page, this.tmdbAuth());
+    return enriched.map((e) => this.createMetaPreview(e));
+  }
+
+  public async getMeta(type: string, id: string): Promise<Meta> {
+    const root = this.requireRoot();
+    const parsedId = IdParser.parse(id, type);
+    if (!parsedId || parsedId.type !== 'imdbId') {
+      throw new Error(`Unsupported ID for ElfSymlinks meta: ${id}`);
+    }
+    const imdbId = String(parsedId.value);
+    const stremioType: 'movie' | 'series' =
+      type === 'series' ? 'series' : 'movie';
+
+    const entry = (await listCatalog(root, stremioType)).find(
+      (e) => e.imdbId === imdbId
+    );
+    if (!entry) {
+      return {
+        id,
+        type: stremioType,
+        name: 'Not in ElfSymlinks library',
+        description:
+          'This item is not available in the ElfSymlinks library on this instance.',
+      };
+    }
+
+    const enriched = await enrichEntry(entry, this.tmdbAuth());
+
+    const meta: Meta = {
+      id,
+      type: stremioType,
+      name: enriched.enrichedTitle ?? enriched.title,
+      releaseInfo: enriched.year ? String(enriched.year) : undefined,
+      description: this.buildDescription(enriched),
+      poster: enriched.posterUrl,
+      background: enriched.backdropUrl,
+    };
+
+    if (stremioType === 'series') {
+      const episodes = await listSeriesEpisodes(root, imdbId);
+      meta.videos = episodes.map(({ season, episode }) => ({
+        id: `${id}:${season}:${episode}`,
+        title: `S${String(season).padStart(2, '0')}E${String(episode).padStart(2, '0')}`,
+        season,
+        episode,
+        released: undefined,
+      }));
+    }
+
+    return meta;
+  }
+
+  private buildDescription(entry: CatalogEntry): string {
+    const parts: string[] = [];
+    if (entry.year) parts.push(`📅 ${entry.year}`);
+    if (entry.has4K) parts.push('🟦 4K available');
+    return parts.join(' • ');
+  }
+
+  private createMetaPreview(entry: EnrichedEntry): MetaPreview {
+    return {
+      id: `tt${entry.imdbId.replace(/^tt/, '')}`,
+      type: entry.type,
+      name: entry.enrichedTitle ?? entry.title,
+      poster: entry.posterUrl,
+      posterShape: 'poster',
+      releaseInfo: entry.year ? String(entry.year) : undefined,
+      description: entry.has4K ? '🟦 4K available' : undefined,
+    };
+  }
+
+  private createStream(match: SymlinkMatch): Stream {
+    const is4K = match.bucket.endsWith('-4k');
+    const token = signFileToken(
+      match.relativePath,
+      this.userData.fileUrlValidityMs
+    );
+    const filename = match.fileName;
+    const url = `${appConfig.bootstrap.baseUrl}/elfsymlinks/file/${token}/${encodeURIComponent(filename)}`;
+
+    const descriptionLines: string[] = [];
+    if (match.seasonFolderName) {
+      descriptionLines.push(
+        `📁 ${match.folderName} / ${match.seasonFolderName}`
+      );
+    } else {
+      descriptionLines.push(`📁 ${match.folderName}`);
+    }
+    descriptionLines.push(filename);
+
+    return {
+      name: `🗃️ [⚡] ElfSymlinks${is4K ? ' 4K' : ''}`,
+      description: descriptionLines.join('\n'),
+      url,
+      behaviorHints: {
+        filename,
+        folderName: match.folderName,
+        videoSize: match.size || undefined,
+        notWebReady: true,
+        bingeGroup: `elfsymlinks-${match.bucket}`,
+      },
+    };
+  }
+}
+
+export const elfSymlinksFromConfig = (
+  encoded?: string
+): ElfSymlinksAddon => {
+  if (!encoded) return new ElfSymlinksAddon();
+  try {
+    const parsed = JSON.parse(
+      Buffer.from(
+        encoded.replace(/-/g, '+').replace(/_/g, '/'),
+        'base64'
+      ).toString('utf8')
+    );
+    return new ElfSymlinksAddon(parsed);
+  } catch {
+    return new ElfSymlinksAddon();
+  }
+};
diff --git a/packages/core/src/builtins/elfsymlinks/enrich.ts b/packages/core/src/builtins/elfsymlinks/enrich.ts
new file mode 100644
index 0000000..83e54ae
--- /dev/null
+++ b/packages/core/src/builtins/elfsymlinks/enrich.ts
@@ -0,0 +1,114 @@
+import pLimit from 'p-limit';
+import { config as appConfig } from '../../config/index.js';
+import { createLogger } from '../../utils/index.js';
+import { TMDBMetadata } from '../../metadata/tmdb.js';
+import type { ParsedId } from '../../utils/id-parser.js';
+import { CatalogEntry } from './scanner.js';
+
+const logger = createLogger('elfsymlinks-enrich');
+
+export interface EnrichedEntry extends CatalogEntry {
+  enrichedTitle?: string;
+  posterUrl?: string;
+  backdropUrl?: string;
+}
+
+const TMDB_CONCURRENCY = 16;
+const POSTER_SIZE = 'w500' as const;
+const BACKDROP_SIZE = 'w780' as const;
+const ENRICH_PAGE_BUDGET_MS = 6000;
+
+const buildParsedId = (
+  imdbId: string,
+  type: 'movie' | 'series'
+): ParsedId => ({
+  type: 'imdbId',
+  value: imdbId,
+  fullId: imdbId,
+  externalType: 'imdb_id',
+  mediaType: type,
+  generator: (value, season, episode) =>
+    `${value}${season && episode ? `:${season}:${episode}` : ''}`,
+});
+
+export interface TmdbAuth {
+  accessToken?: string;
+  apiKey?: string;
+}
+
+export const tmdbEnrichmentAvailable = (auth?: TmdbAuth): boolean =>
+  !!(
+    auth?.accessToken ||
+    auth?.apiKey ||
+    appConfig.metadata.tmdb.accessToken ||
+    appConfig.metadata.tmdb.apiKey
+  );
+
+export const enrichWithTmdb = async (
+  entries: CatalogEntry[],
+  auth?: TmdbAuth
+): Promise<EnrichedEntry[]> => {
+  if (entries.length === 0) return [];
+  if (!tmdbEnrichmentAvailable(auth)) return entries;
+
+  let tmdb: TMDBMetadata;
+  try {
+    tmdb = new TMDBMetadata({
+      accessToken: auth?.accessToken,
+      apiKey: auth?.apiKey,
+    });
+  } catch (err) {
+    logger.debug(
+      `Skipping TMDB enrichment: ${err instanceof Error ? err.message : err}`
+    );
+    return entries;
+  }
+
+  const limit = pLimit(TMDB_CONCURRENCY);
+  let deadlineReached = false;
+  const deadlineP = new Promise<'deadline'>((resolve) => {
+    const t = setTimeout(() => {
+      deadlineReached = true;
+      resolve('deadline');
+    }, ENRICH_PAGE_BUDGET_MS);
+    t.unref?.();
+  });
+
+  return Promise.all(
+    entries.map(async (entry): Promise<EnrichedEntry> => {
+      return Promise.race([
+        limit(async (): Promise<EnrichedEntry> => {
+          if (deadlineReached) return entry;
+          try {
+            const meta = await tmdb.getMetadata(
+              buildParsedId(entry.imdbId, entry.type)
+            );
+            return {
+              ...entry,
+              enrichedTitle: meta.title || entry.title,
+              posterUrl: TMDBMetadata.getImageUrl(meta.posterPath, POSTER_SIZE),
+              backdropUrl: TMDBMetadata.getImageUrl(
+                meta.backdropPath,
+                BACKDROP_SIZE
+              ),
+            };
+          } catch (err) {
+            logger.debug(
+              `TMDB lookup failed for ${entry.imdbId}: ${err instanceof Error ? err.message : err}`
+            );
+            return entry;
+          }
+        }),
+        deadlineP.then(() => entry),
+      ]);
+    })
+  );
+};
+
+export const enrichEntry = async (
+  entry: CatalogEntry,
+  auth?: TmdbAuth
+): Promise<EnrichedEntry> => {
+  const [enriched] = await enrichWithTmdb([entry], auth);
+  return enriched;
+};
