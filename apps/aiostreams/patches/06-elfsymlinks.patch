@@ -0,0 +1,449 @@
+import fs from 'fs';
+import fsp from 'fs/promises';
+import path from 'path';
+import pLimit from 'p-limit';
+import { config as appConfig } from '../../config/index.js';
+import { createLogger } from '../../utils/index.js';
+
+const logger = createLogger('elfsymlinks');
+
+const VIDEO_EXTENSIONS = new Set([
+  '.mkv',
+  '.mp4',
+  '.m4v',
+  '.avi',
+  '.mov',
+  '.webm',
+  '.ts',
+  '.m2ts',
+  '.flv',
+  '.wmv',
+  '.mpg',
+  '.mpeg',
+  '.ogv',
+]);
+
+export type SymlinkBucket = 'movies' | 'movies-4k' | 'series' | 'series-4k';
+
+export const BUCKETS: readonly SymlinkBucket[] = [
+  'movies',
+  'movies-4k',
+  'series',
+  'series-4k',
+] as const;
+
+export interface SymlinkMatch {
+  bucket: SymlinkBucket;
+  relativePath: string;
+  fileName: string;
+  folderName: string;
+  seasonFolderName?: string;
+  absolutePath: string;
+  size: number;
+}
+
+export interface CatalogEntry {
+  imdbId: string;
+  type: 'movie' | 'series';
+  bucket: SymlinkBucket;
+  folderName: string;
+  title: string;
+  year?: number;
+  has4K: boolean;
+  modifiedTime: number;
+}
+
+interface IndexEntry {
+  folderName: string;
+  modifiedTime: number;
+  title: string;
+  year?: number;
+}
+
+type BucketIndex = Map<string, IndexEntry>;
+
+const isVideoFile = (name: string) =>
+  VIDEO_EXTENSIONS.has(path.extname(name).toLowerCase());
+
+const FOLDER_PARSE_RE =
+  /^(?<title>.+?)\s*(?:\((?<year>\d{4})\))?\s*\{imdb-(?<imdb>tt\d+)\}/;
+
+const parseFolderName = (
+  folderName: string
+): { title: string; year?: number; imdbId: string } | undefined => {
+  const m = folderName.match(FOLDER_PARSE_RE);
+  if (!m?.groups) return undefined;
+  return {
+    title: m.groups.title.trim(),
+    year: m.groups.year ? Number(m.groups.year) : undefined,
+    imdbId: m.groups.imdb,
+  };
+};
+
+const toRelative = (root: string, absolute: string): string =>
+  path.relative(root, absolute).split(path.sep).join('/');
+
+const safeReadDirAsync = async (dir: string): Promise<fs.Dirent[]> => {
+  try {
+    return await fsp.readdir(dir, { withFileTypes: true });
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') {
+      logger.warn(`Failed to read ${dir}: ${err?.message ?? err}`);
+    }
+    return [];
+  }
+};
+
+const safeReadDirSync = (dir: string): fs.Dirent[] => {
+  try {
+    return fs.readdirSync(dir, { withFileTypes: true });
+  } catch {
+    return [];
+  }
+};
+
+const safeStatMtime = async (p: string): Promise<number> => {
+  try {
+    return (await fsp.stat(p)).mtimeMs;
+  } catch {
+    return 0;
+  }
+};
+
+const safeStatSize = (p: string): number => {
+  try {
+    return fs.statSync(p).size;
+  } catch {
+    return 0;
+  }
+};
+
+const isFileFollowingLinks = (
+  dir: string,
+  e: fs.Dirent
+): boolean => {
+  if (e.isFile()) return true;
+  if (!e.isSymbolicLink()) return false;
+  try {
+    return fs.statSync(path.join(dir, e.name)).isFile();
+  } catch {
+    return false;
+  }
+};
+
+const isDirectoryFollowingLinks = (
+  dir: string,
+  e: fs.Dirent
+): boolean => {
+  if (e.isDirectory()) return true;
+  if (!e.isSymbolicLink()) return false;
+  try {
+    return fs.statSync(path.join(dir, e.name)).isDirectory();
+  } catch {
+    return false;
+  }
+};
+
+class ElfSymlinksIndex {
+  private cache: Record<SymlinkBucket, BucketIndex> | null = null;
+  private buildPromise: Promise<void> | null = null;
+  private lastBuild = 0;
+
+  private get ttl(): number {
+    return appConfig.builtins.elfsymlinks.indexTtl;
+  }
+
+  invalidate(): void {
+    this.cache = null;
+    this.lastBuild = 0;
+  }
+
+  async getCache(root: string): Promise<Record<SymlinkBucket, BucketIndex>> {
+    const age = Date.now() - this.lastBuild;
+    if (this.cache && age < this.ttl) return this.cache;
+
+    if (!this.cache) {
+      if (!this.buildPromise) this.buildPromise = this.build(root);
+      await this.buildPromise;
+      return this.cache!;
+    }
+
+    if (!this.buildPromise) {
+      this.buildPromise = this.build(root).catch((err) => {
+        logger.error(`Background index refresh failed: ${err?.message ?? err}`);
+      });
+    }
+    return this.cache;
+  }
+
+  async lookup(
+    root: string,
+    bucket: SymlinkBucket,
+    imdbId: string
+  ): Promise<IndexEntry | undefined> {
+    const cache = await this.getCache(root);
+    return cache[bucket].get(imdbId);
+  }
+
+  async listAll(
+    root: string,
+    type: 'movie' | 'series'
+  ): Promise<CatalogEntry[]> {
+    const cache = await this.getCache(root);
+    const buckets: SymlinkBucket[] =
+      type === 'movie' ? ['movies', 'movies-4k'] : ['series', 'series-4k'];
+    const merged = new Map<string, CatalogEntry>();
+    for (const bucket of buckets) {
+      for (const [imdbId, entry] of cache[bucket]) {
+        const existing = merged.get(imdbId);
+        if (!existing) {
+          merged.set(imdbId, {
+            imdbId,
+            type,
+            bucket,
+            folderName: entry.folderName,
+            title: entry.title,
+            year: entry.year,
+            has4K: bucket.endsWith('-4k'),
+            modifiedTime: entry.modifiedTime,
+          });
+          continue;
+        }
+        existing.has4K = existing.has4K || bucket.endsWith('-4k');
+        if (entry.modifiedTime > existing.modifiedTime) {
+          existing.modifiedTime = entry.modifiedTime;
+        }
+        if (existing.bucket.endsWith('-4k') && !bucket.endsWith('-4k')) {
+          existing.bucket = bucket;
+          existing.folderName = entry.folderName;
+        }
+      }
+    }
+    return [...merged.values()].sort(
+      (a, b) => b.modifiedTime - a.modifiedTime
+    );
+  }
+
+  private async build(root: string): Promise<void> {
+    const start = Date.now();
+    try {
+      const limit = pLimit(appConfig.builtins.elfsymlinks.indexConcurrency);
+      const next: Record<SymlinkBucket, BucketIndex> = {
+        movies: new Map(),
+        'movies-4k': new Map(),
+        series: new Map(),
+        'series-4k': new Map(),
+      };
+
+      await Promise.all(
+        BUCKETS.map(async (bucket) => {
+          const bucketDir = path.join(root, bucket);
+          const entries = await safeReadDirAsync(bucketDir);
+          const dirs = entries.filter((e) =>
+            isDirectoryFollowingLinks(bucketDir, e)
+          );
+
+          await Promise.all(
+            dirs.map((d) =>
+              limit(async () => {
+                const parsed = parseFolderName(d.name);
+                if (!parsed) return;
+                const fullPath = path.join(bucketDir, d.name);
+                const mtime = await safeStatMtime(fullPath);
+                next[bucket].set(parsed.imdbId, {
+                  folderName: d.name,
+                  modifiedTime: mtime,
+                  title: parsed.title,
+                  year: parsed.year,
+                });
+              })
+            )
+          );
+        })
+      );
+
+      this.cache = next;
+      this.lastBuild = Date.now();
+      const total = Object.values(next).reduce((n, m) => n + m.size, 0);
+      logger.info(
+        `ElfSymlinks index built in ${Date.now() - start}ms (${total} entries across ${BUCKETS.length} buckets)`
+      );
+    } finally {
+      this.buildPromise = null;
+    }
+  }
+}
+
+const sharedIndex = new ElfSymlinksIndex();
+
+export const elfSymlinksIndex = (): ElfSymlinksIndex => sharedIndex;
+
+const buildEpisodeRegex = (season: number, episode: number): RegExp => {
+  const s = season.toString();
+  const e = episode.toString();
+  return new RegExp(
+    `(?:s0*${s}[\\s.\\-]?e0*${e}|0*${s}x0*${e})(?!\\d)`,
+    'i'
+  );
+};
+
+const buildSeasonFolderRegex = (season: number): RegExp =>
+  new RegExp(`^(?:season|s)\\s*0*${season}(?!\\d)`, 'i');
+
+const findMoviesInBucket = async (
+  root: string,
+  bucket: SymlinkBucket,
+  imdbId: string
+): Promise<SymlinkMatch[]> => {
+  const entry = await sharedIndex.lookup(root, bucket, imdbId);
+  if (!entry) return [];
+
+  const folderDir = path.join(root, bucket, entry.folderName);
+  const entries = await safeReadDirAsync(folderDir);
+
+  return entries
+    .filter((e) => isVideoFile(e.name) && isFileFollowingLinks(folderDir, e))
+    .map((e) => {
+      const absolutePath = path.join(folderDir, e.name);
+      return {
+        bucket,
+        relativePath: toRelative(root, absolutePath),
+        fileName: e.name,
+        folderName: entry.folderName,
+        absolutePath,
+        size: safeStatSize(absolutePath),
+      } satisfies SymlinkMatch;
+    });
+};
+
+const findEpisodesInBucket = async (
+  root: string,
+  bucket: SymlinkBucket,
+  imdbId: string,
+  season: number,
+  episode: number
+): Promise<SymlinkMatch[]> => {
+  const entry = await sharedIndex.lookup(root, bucket, imdbId);
+  if (!entry) return [];
+
+  const seriesDir = path.join(root, bucket, entry.folderName);
+  const seasonRe = buildSeasonFolderRegex(season);
+  const seriesEntries = await safeReadDirAsync(seriesDir);
+  const seasonFolder = seriesEntries.find(
+    (e) => seasonRe.test(e.name) && isDirectoryFollowingLinks(seriesDir, e)
+  );
+  if (!seasonFolder) return [];
+
+  const seasonDir = path.join(seriesDir, seasonFolder.name);
+  const episodeRe = buildEpisodeRegex(season, episode);
+  const seasonEntries = await safeReadDirAsync(seasonDir);
+
+  return seasonEntries
+    .filter(
+      (e) =>
+        isVideoFile(e.name) &&
+        episodeRe.test(e.name) &&
+        isFileFollowingLinks(seasonDir, e)
+    )
+    .map((e) => {
+      const absolutePath = path.join(seasonDir, e.name);
+      return {
+        bucket,
+        relativePath: toRelative(root, absolutePath),
+        fileName: e.name,
+        folderName: entry.folderName,
+        seasonFolderName: seasonFolder.name,
+        absolutePath,
+        size: safeStatSize(absolutePath),
+      } satisfies SymlinkMatch;
+    });
+};
+
+export const findMoviesByImdbId = async (
+  root: string,
+  imdbId: string
+): Promise<SymlinkMatch[]> => {
+  const results = await Promise.all([
+    findMoviesInBucket(root, 'movies', imdbId),
+    findMoviesInBucket(root, 'movies-4k', imdbId),
+  ]);
+  return results.flat();
+};
+
+export const findEpisodesByImdbId = async (
+  root: string,
+  imdbId: string,
+  season: number,
+  episode: number
+): Promise<SymlinkMatch[]> => {
+  const results = await Promise.all([
+    findEpisodesInBucket(root, 'series', imdbId, season, episode),
+    findEpisodesInBucket(root, 'series-4k', imdbId, season, episode),
+  ]);
+  return results.flat();
+};
+
+export const listCatalog = async (
+  root: string,
+  type: 'movie' | 'series'
+): Promise<CatalogEntry[]> => sharedIndex.listAll(root, type);
+
+export const listSeriesEpisodes = async (
+  root: string,
+  imdbId: string
+): Promise<Array<{ season: number; episode: number }>> => {
+  const seen = new Map<string, { season: number; episode: number }>();
+  for (const bucket of ['series', 'series-4k'] as const) {
+    const entry = await sharedIndex.lookup(root, bucket, imdbId);
+    if (!entry) continue;
+    const seriesDir = path.join(root, bucket, entry.folderName);
+    const seasonDirs = await safeReadDirAsync(seriesDir);
+    for (const sd of seasonDirs) {
+      if (!isDirectoryFollowingLinks(seriesDir, sd)) continue;
+      const seasonMatch = sd.name.match(/^(?:season|s)\s*0*(\d+)/i);
+      if (!seasonMatch) continue;
+      const seasonNum = Number(seasonMatch[1]);
+      const seasonDir = path.join(seriesDir, sd.name);
+      const files = await safeReadDirAsync(seasonDir);
+      for (const f of files) {
+        if (!isFileFollowingLinks(seasonDir, f)) continue;
+        const epMatch =
+          f.name.match(/s(\d+)[\s.\-]?e(\d+)(?!\d)/i) ??
+          f.name.match(/(?<![\d])(\d+)x(\d+)(?!\d)/i);
+        if (!epMatch) continue;
+        const epNum = Number(epMatch[2]);
+        const key = `${seasonNum}:${epNum}`;
+        if (!seen.has(key)) {
+          seen.set(key, { season: seasonNum, episode: epNum });
+        }
+      }
+    }
+  }
+  return [...seen.values()].sort((a, b) =>
+    a.season === b.season ? a.episode - b.episode : a.season - b.season
+  );
+};
+
+export const resolveSafeFilePath = (
+  root: string,
+  relativePath: string
+): string | undefined => {
+  if (!relativePath || relativePath.includes('\0')) return undefined;
+  const absoluteRoot = path.resolve(root);
+  const resolved = path.resolve(absoluteRoot, relativePath);
+  const rootWithSep = absoluteRoot.endsWith(path.sep)
+    ? absoluteRoot
+    : absoluteRoot + path.sep;
+  if (resolved !== absoluteRoot && !resolved.startsWith(rootWithSep)) {
+    return undefined;
+  }
+  try {
+    const stat = fs.statSync(resolved);
+    if (!stat.isFile()) return undefined;
+  } catch {
+    return undefined;
+  }
+  return resolved;
+};
+
+export const _internal = { safeReadDirSync };
