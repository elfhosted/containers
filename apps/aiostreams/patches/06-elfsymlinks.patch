@@ -0,0 +1,103 @@
+import { Addon, Option, ParsedStream, Stream, UserData } from '../db/index.js';
+import { appConfig, constants } from '../utils/index.js';
+import { baseOptions } from './preset.js';
+import { BuiltinAddonPreset, BuiltinStreamParser } from './builtin.js';
+import { StreamParser } from '../parser/index.js';
+
+class ElfSymlinksStreamParser extends BuiltinStreamParser {
+  protected override getInLibrary(
+    _stream: Stream,
+    _currentParsedStream: ParsedStream
+  ): boolean {
+    return true;
+  }
+
+  protected override getStreamType(): 'http' {
+    return 'http';
+  }
+}
+
+export class ElfSymlinksPreset extends BuiltinAddonPreset {
+  static override getParser(): typeof StreamParser {
+    return ElfSymlinksStreamParser;
+  }
+
+  static override get METADATA() {
+    const supportedResources = [
+      constants.STREAM_RESOURCE,
+      constants.CATALOG_RESOURCE,
+      constants.META_RESOURCE,
+    ];
+
+    const options: Option[] = [
+      ...baseOptions(
+        'ElfSymlinks',
+        supportedResources,
+        appConfig.builtins.elfsymlinks.timeout ??
+          appConfig.presets.defaultTimeout
+      ).filter((option) => option.id !== 'url'),
+    ];
+
+    return {
+      ID: 'elfsymlinks',
+      NAME: 'ElfSymlinks',
+      LOGO: 'https://docs.elfhosted.com/images/logo.png',
+      URL: [`${appConfig.bootstrap.internalUrl}/builtins/elfsymlinks`],
+      TIMEOUT:
+        appConfig.builtins.elfsymlinks.timeout ??
+        appConfig.presets.defaultTimeout,
+      USER_AGENT: appConfig.http.defaultUserAgent,
+      SUPPORTED_SERVICES: [],
+      DESCRIPTION:
+        "For ElfHosted users with a Personal Media Stack: searches your existing symlinks for matching content and exposes a 'recently added' catalog of movies and TV.",
+      OPTIONS: options,
+      SUPPORTED_STREAM_TYPES: [constants.HTTP_STREAM_TYPE],
+      SUPPORTED_RESOURCES: supportedResources,
+      BUILTIN: true,
+      CATEGORY: constants.PresetCategory.STREAMS,
+      DISABLED: !appConfig.builtins.elfsymlinks.root
+        ? {
+            reason: 'Not configured',
+            disabled: true,
+          }
+        : undefined,
+    };
+  }
+
+  static override async generateAddons(
+    userData: UserData,
+    options: Record<string, any>
+  ): Promise<Addon[]> {
+    return [
+      {
+        name: options.name || this.METADATA.NAME,
+        manifestUrl: this.generateManifestUrl(userData),
+        enabled: true,
+        resources: options.resources || this.METADATA.SUPPORTED_RESOURCES,
+        timeout: options.timeout || this.METADATA.TIMEOUT,
+        preset: {
+          id: '',
+          type: this.METADATA.ID,
+          options,
+        },
+        headers: {
+          'User-Agent': this.METADATA.USER_AGENT,
+        },
+      },
+    ];
+  }
+
+  private static generateManifestUrl(userData: UserData): string {
+    if (!appConfig.builtins.elfsymlinks.root) {
+      throw new Error(
+        'builtins.elfsymlinks.root (BUILTIN_ELFSYMLINKS_ROOT) is not configured'
+      );
+    }
+    const config = {
+      tmdbAccessToken: userData.tmdbAccessToken,
+      tmdbApiKey: userData.tmdbApiKey,
+    };
+    const encoded = this.base64EncodeJSON(config, 'urlSafe');
+    return `${appConfig.bootstrap.internalUrl}/builtins/elfsymlinks/${encoded}/manifest.json`;
+  }
+}
