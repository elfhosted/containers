diff --git a/packages/core/src/builtins/library/resolve.ts b/packages/core/src/builtins/library/resolve.ts
new file mode 100644
index 0000000..0c8c79b
--- /dev/null
+++ b/packages/core/src/builtins/library/resolve.ts
@@ -0,0 +1,149 @@
+import pLimit from 'p-limit';
+import { ParsedResult } from '@viren070/parse-torrent-title';
+import { TMDBMetadata, TitleSearchResult } from '../../metadata/tmdb.js';
+import { createLogger } from '../../utils/index.js';
+import { config as appConfig } from '../../config/index.js';
+
+const logger = createLogger('library');
+
+const RESOLVE_CONCURRENCY = 5;
+
+const PAGE_DEADLINE_MS = 8000;
+
+export interface TmdbAuth {
+  apiKey?: string;
+  accessToken?: string;
+}
+
+export interface ResolvedLibraryMeta {
+  title: string;
+  year?: number;
+  poster?: string;
+  background?: string;
+}
+
+function buildResolver(auth?: TmdbAuth): TMDBMetadata | null {
+  if (!appConfig.builtins.library.metadataResolution) {
+    return null;
+  }
+  try {
+    return new TMDBMetadata({
+      apiKey: auth?.apiKey,
+      accessToken: auth?.accessToken,
+    });
+  } catch {
+    logger.debug(
+      'Library metadata resolution enabled but no TMDB credentials available — skipping'
+    );
+    return null;
+  }
+}
+
+function toResolvedMeta(hit: TitleSearchResult): ResolvedLibraryMeta {
+  return {
+    title: hit.title,
+    year: hit.year,
+    poster: TMDBMetadata.getImageUrl(hit.posterPath, 'w342'),
+    background: TMDBMetadata.getImageUrl(hit.backdropPath, 'w780'),
+  };
+}
+
+async function resolveOne(
+  tmdb: TMDBMetadata,
+  parsed: ParsedResult
+): Promise<ResolvedLibraryMeta | null> {
+  const title = parsed.title?.trim();
+  if (!title) return null;
+  const mediaType =
+    (parsed.seasons?.length ?? 0) > 0 || (parsed.episodes?.length ?? 0) > 0
+      ? ('tv' as const)
+      : undefined;
+  const yearNum = parsed.year ? parseInt(String(parsed.year), 10) : NaN;
+  try {
+    const hit = await tmdb.searchTitle(title, {
+      year: isNaN(yearNum) ? undefined : yearNum,
+      mediaType,
+    });
+    return hit ? toResolvedMeta(hit) : null;
+  } catch (error) {
+    logger.debug(`Library title resolution failed for "${title}"`, {
+      error: (error as Error).message,
+    });
+    return null;
+  }
+}
+
+function resolveKey(parsed: ParsedResult): string | null {
+  const title = parsed.title?.trim().toLowerCase();
+  if (!title) return null;
+  const tv =
+    (parsed.seasons?.length ?? 0) > 0 || (parsed.episodes?.length ?? 0) > 0;
+  return `${tv ? 'tv' : 'multi'}:${parsed.year ?? ''}:${title}`;
+}
+
+export async function resolveLibraryMetas(
+  parsedEntries: ParsedResult[],
+  auth?: TmdbAuth
+): Promise<(ResolvedLibraryMeta | null)[]> {
+  const tmdb = buildResolver(auth);
+  if (!tmdb) {
+    return parsedEntries.map(() => null);
+  }
+
+  const uniqueByKey = new Map<string, ParsedResult>();
+  for (const parsed of parsedEntries) {
+    const key = resolveKey(parsed);
+    if (key && !uniqueByKey.has(key)) {
+      uniqueByKey.set(key, parsed);
+    }
+  }
+
+  let deadlineTimer: NodeJS.Timeout | undefined;
+  let deadlineReached = false;
+  const deadline = new Promise<'deadline'>((resolve) => {
+    deadlineTimer = setTimeout(() => {
+      deadlineReached = true;
+      resolve('deadline');
+    }, PAGE_DEADLINE_MS);
+    deadlineTimer.unref?.();
+  });
+
+  const limit = pLimit(RESOLVE_CONCURRENCY);
+  let timedOut = 0;
+  const resolvedByKey = new Map<string, ResolvedLibraryMeta | null>();
+  await Promise.all(
+    [...uniqueByKey.entries()].map(async ([key, parsed]) => {
+      const outcome = await Promise.race([
+        limit(() =>
+          deadlineReached ? Promise.resolve(null) : resolveOne(tmdb, parsed)
+        ),
+        deadline,
+      ]);
+      if (outcome === 'deadline') {
+        timedOut++;
+        resolvedByKey.set(key, null);
+      } else {
+        resolvedByKey.set(key, outcome);
+      }
+    })
+  );
+  clearTimeout(deadlineTimer);
+  if (timedOut > 0) {
+    logger.warn(
+      `Library metadata resolution page budget (${PAGE_DEADLINE_MS}ms) hit — ${timedOut}/${uniqueByKey.size} lookups returned unresolved (cache warms in background)`
+    );
+  }
+
+  return parsedEntries.map((parsed) => {
+    const key = resolveKey(parsed);
+    return key ? (resolvedByKey.get(key) ?? null) : null;
+  });
+}
+
+export async function resolveLibraryMeta(
+  parsed: ParsedResult,
+  auth?: TmdbAuth
+): Promise<ResolvedLibraryMeta | null> {
+  const [resolved] = await resolveLibraryMetas([parsed], auth);
+  return resolved;
+}
