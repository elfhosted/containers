index 00000000..44691997
--- /dev/null
+++ b/packages/server/src/utils/readiness.ts
@@ -0,0 +1,127 @@
+/**
+ * Startup readiness gate for the lookup datasets (anime database, SeaDex,
+ * scene mappings, id mappings).
+ *
+ * Those four take tens of seconds to build on a cold start, and the server
+ * used to bind its socket only after all of them had finished. Nothing was
+ * listening in the meantime, so orchestrator startup and readiness probes
+ * failed with connection-refused for the whole window and the pod counted as
+ * down on every restart.
+ *
+ * The socket now opens first and the datasets load behind this gate.
+ *
+ * The gate holds *everything* except an explicit exemption list. Gating by
+ * exception rather than by enumerating the routes that read a dataset is
+ * deliberate: a request that waits behaves exactly as it did before this
+ * change (when it could not connect at all), whereas a route that should have
+ * waited and did not would silently answer from a half-built store. Several
+ * routes reach the datasets indirectly by constructing AIOStreams — /stremio,
+ * /chilllink, /api/*\/search, /api/*\/catalogs, /api/*\/{newznab,torznab} —
+ * and /api/*\/anime reads AnimeDatabase directly, so an allow-list is the only
+ * form of this that stays correct as routes are added.
+ *
+ * Deliberately free of runtime imports: this sits on the boot path, and
+ * pulling in the core barrel would drag environment validation (and a possible
+ * import cycle) into a module whose whole job is to be available early.
+ */
+import type { NextFunction, Request, RequestHandler, Response } from 'express';
+import { isStaticOrSpaPath } from './served-paths.js';
+
+/**
+ * Probe paths. These are the reason the socket opens early at all, so they
+ * must never wait.
+ */
+const PROBE_PATH = /^\/api\/v\d+\/(health|status)(\/|$)/;
+
+/**
+ * Served during the cold-start window: the probes, plus the SPA documents and
+ * static files, which touch no dataset. The static list is shared with the
+ * handlers in app.ts so the gate cannot end up holding a document the SPA
+ * fallback would happily serve.
+ *
+ * Note the pod now reports ready during this window, so an un-exempt request
+ * *hangs* where it previously got a fast connection-refused. Serving the shell
+ * immediately matters more than it looks: its API calls are still gated, so
+ * the page loads and then waits, rather than the browser spinning on a dead
+ * socket.
+ */
+function isExempt(routePath: string): boolean {
+  return PROBE_PATH.test(routePath) || isStaticOrSpaPath(routePath);
+}
+
+/**
+ * Upper bound on how long a request will wait. A dataset build that hangs
+ * should degrade results, never wedge the addon: past this point the gate
+ * latches open and requests proceed with whatever has loaded, exactly as they
+ * would if a refresh were still in flight later in the process's life.
+ */
+const MAX_WAIT_MS = 120_000;
+
+let openGate: () => void = () => {};
+let open = false;
+let timeoutHandler: (() => void) | undefined;
+let timer: ReturnType<typeof setTimeout> | undefined;
+
+const openPromise = new Promise<void>((resolve) => {
+  openGate = () => {
+    if (open) return;
+    open = true;
+    if (timer) {
+      clearTimeout(timer);
+      timer = undefined;
+    }
+    resolve();
+  };
+});
+
+/** Open the gate. Safe to call more than once. */
+export function markDatasetsReady(): void {
+  openGate();
+}
+
+/**
+ * Whether the gate is open — because the datasets finished, or because the
+ * wait timed out and we chose to serve degraded. Not a claim that every
+ * dataset loaded successfully.
+ */
+export function datasetGateIsOpen(): boolean {
+  return open;
+}
+
+/** Called once if the wait times out; the caller owns the logging. */
+export function onDatasetWaitTimeout(handler: () => void): void {
+  timeoutHandler = handler;
+}
+
+/** Resolves once the gate opens, or after {@link MAX_WAIT_MS}. */
+export function whenDatasetsReady(): Promise<void> {
+  if (open) return Promise.resolve();
+  // One timer for the whole process, armed on the first wait. A timer per
+  // call would leave the losers of the race armed, so every request that
+  // waited would later fire a spurious "gave up waiting" warning.
+  if (!timer) {
+    timer = setTimeout(() => {
+      timer = undefined;
+      timeoutHandler?.();
+      // Latch open rather than letting each subsequent wait start its own
+      // 120s window — a request can pass through the gate more than once,
+      // and a build this slow will not be worth waiting on again.
+      openGate();
+    }, MAX_WAIT_MS);
+    timer.unref?.();
+  }
+  return openPromise;
+}
+
+/** Hold a request until the datasets it may read have loaded. */
+export const datasetReadinessMiddleware: RequestHandler = (
+  req: Request,
+  _res: Response,
+  next: NextFunction
+) => {
+  if (open || isExempt(req.path)) {
+    next();
+    return;
+  }
+  whenDatasetsReady().then(() => next(), next);
+};
diff --git a/packages/server/src/utils/served-paths.ts b/packages/server/src/utils/served-paths.ts
new file mode 100644
index 00000000..a308d55a
--- /dev/null
+++ b/packages/server/src/utils/served-paths.ts
@@ -0,0 +1,62 @@
+/**
+ * Paths the server can answer without touching the lookup datasets: the SPA's
+ * own routes, and the static files those pages pull in.
+ *
+ * Shared by the SPA fallback in app.ts and the startup readiness gate, so the
+ * two cannot drift. If they did, the gate would hold a document the fallback
+ * is willing to serve — which is exactly the bug this module exists to stop.
+ *
+ * No imports: the readiness gate consumes this on the boot path.
+ */
+
+/** Paths that exist in the client-side router. */
+export const SPA_STATIC_ROUTES = [
+  '/',
+  '/login',
+  '/oauth/callback/gdrive',
+  '/splashscreen',
+  '/stremio/configure',
+];
+
+export const SPA_DYNAMIC_PATTERNS: RegExp[] = [
+  /^\/stremio\/[^/]+\/[^/]+\/configure$/,
+  /^\/dashboard(\/.*)?$/,
+];
+
+export function isValidSpaRoute(routePath: string): boolean {
+  if (SPA_STATIC_ROUTES.includes(routePath)) {
+    return true;
+  }
+  return SPA_DYNAMIC_PATTERNS.some((pattern) => pattern.test(routePath));
+}
+
+/**
+ * Root-level static files served straight from the frontend build, plus the
+ * hashed-asset and static prefixes. Mirrors the handlers in app.ts.
+ */
+const ROOT_STATIC_FILES = [
+  '/logo.png',
+  '/logo_alt.png',
+  '/favicon.ico',
+  '/manifest.json',
+  '/robots.txt',
+  '/icon0.svg',
+  '/icon1.png',
+  '/apple-icon.png',
+  '/apple-touch-icon.png',
+  '/web-app-manifest-192x192.png',
+  '/web-app-manifest-512x512.png',
+  '/mini-nightly-white.png',
+  '/mini-stable-white.png',
+];
+
+const STATIC_PREFIXES = ['/assets/', '/static/', '/_next/'];
+
+/** True for a request that is a static asset or an SPA document. */
+export function isStaticOrSpaPath(routePath: string): boolean {
+  return (
+    ROOT_STATIC_FILES.includes(routePath) ||
+    STATIC_PREFIXES.some((prefix) => routePath.startsWith(prefix)) ||
+    isValidSpaRoute(routePath)
+  );
+}
