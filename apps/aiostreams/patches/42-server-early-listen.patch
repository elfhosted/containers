+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { streamJsonArray, streamJsonLines } from './streaming.js';
+
+async function withTempFile<T>(
+  contents: string,
+  fn: (filePath: string) => Promise<T>
+): Promise<T> {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'aios-streaming-'));
+  const filePath = path.join(dir, 'data');
+  try {
+    await fs.writeFile(filePath, contents);
+    return await fn(filePath);
+  } finally {
+    await fs.rm(dir, { recursive: true, force: true });
+  }
+}
+
+async function collect<T>(it: AsyncIterable<T>): Promise<T[]> {
+  const out: T[] = [];
+  for await (const value of it) out.push(value);
+  return out;
+}
+
+describe('streamJsonArray', () => {
+  it('yields every element of a top-level array in order', async () => {
+    const values = [
+      { id: 1, title: 'one' },
+      { id: 2, title: 'two' },
+      { id: 3, title: 'three' },
+    ];
+    await withTempFile(JSON.stringify(values), async (filePath) => {
+      assert.deepEqual(await collect(streamJsonArray(filePath)), values);
+    });
+  });
+
+  it('handles an empty array', async () => {
+    await withTempFile('[]', async (filePath) => {
+      assert.deepEqual(await collect(streamJsonArray(filePath)), []);
+    });
+  });
+
+  it('preserves nulls and nested structures', async () => {
+    const values = [null, { a: { b: [1, 2, { c: 'd' }] } }, 'plain', 7];
+    await withTempFile(JSON.stringify(values), async (filePath) => {
+      assert.deepEqual(await collect(streamJsonArray(filePath)), values);
+    });
+  });
+
+  it('tolerates leading whitespace and pretty printing', async () => {
+    const values = [{ id: 1 }, { id: 2 }];
+    await withTempFile(
+      `\n  ${JSON.stringify(values, null, 2)}\n`,
+      async (f) => {
+        assert.deepEqual(await collect(streamJsonArray(f)), values);
+      }
+    );
+  });
+
+  it('rejects a document that is not a top-level array', async () => {
+    await withTempFile('{"data": []}', async (filePath) => {
+      await assert.rejects(
+        () => collect(streamJsonArray(filePath)),
+        /Expected a top-level JSON array/
+      );
+    });
+  });
+
+  it('rejects malformed JSON so a corrupt cache is caught', async () => {
+    await withTempFile('[{"id": 1},', async (filePath) => {
+      await assert.rejects(() => collect(streamJsonArray(filePath)));
+    });
+  });
+});
+
+describe('streamJsonLines', () => {
+  it('parses one record per line and skips blank lines', async () => {
+    const body = '{"id":1}\n\n{"id":2}\n   \n{"id":3}\n';
+    await withTempFile(body, async (filePath) => {
+      assert.deepEqual(await collect(streamJsonLines(filePath)), [
+        { id: 1 },
+        { id: 2 },
+        { id: 3 },
+      ]);
+    });
+  });
+});
