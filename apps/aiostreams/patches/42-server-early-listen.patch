index 0000000..b267803
--- /dev/null
+++ b/packages/server/src/utils/readiness.test.ts
@@ -0,0 +1,164 @@
+import { describe, expect, it, vi, beforeEach, afterEach } from 'vitest';
+
+async function loadModule() {
+  vi.resetModules();
+  return import('./readiness.js');
+}
+
+const call = (handler: any, path = '/stremio/x/y/stream/movie/tt1.json') =>
+  new Promise<void>((resolve, reject) => {
+    handler({ path } as any, {} as any, (err?: unknown) =>
+      err ? reject(err) : resolve()
+    );
+  });
+
+describe('dataset readiness gate', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it('holds requests until the datasets are marked ready', async () => {
+    const { datasetReadinessMiddleware, markDatasetsReady, datasetGateIsOpen } =
+      await loadModule();
+
+    expect(datasetGateIsOpen()).toBe(false);
+
+    let passed = false;
+    const inFlight = call(datasetReadinessMiddleware).then(() => {
+      passed = true;
+    });
+
+    await Promise.resolve();
+    expect(passed).toBe(false);
+
+    markDatasetsReady();
+    await inFlight;
+    expect(passed).toBe(true);
+    expect(datasetGateIsOpen()).toBe(true);
+  });
+
+  it('passes straight through once open', async () => {
+    const { datasetReadinessMiddleware, markDatasetsReady } =
+      await loadModule();
+    markDatasetsReady();
+    await expect(call(datasetReadinessMiddleware)).resolves.toBeUndefined();
+  });
+
+  it('is safe to mark ready more than once', async () => {
+    const { markDatasetsReady, datasetGateIsOpen } = await loadModule();
+    markDatasetsReady();
+    markDatasetsReady();
+    expect(datasetGateIsOpen()).toBe(true);
+  });
+
+  it.each([
+    '/api/v1/health',
+    '/api/v1/status',
+    '/assets/index-abc.js',
+    '/static/logo.png',
+    '/favicon.ico',
+    '/manifest.json',
+    '/logo.png',
+    '/icon0.svg',
+    '/apple-icon.png',
+    '/web-app-manifest-512x512.png',
+    '/',
+    '/login',
+    '/splashscreen',
+    '/stremio/configure',
+    '/stremio/uuid/pw/configure',
+    '/dashboard',
+    '/dashboard/settings',
+  ])('serves %s without waiting', async (path) => {
+    const { datasetReadinessMiddleware } = await loadModule();
+    await expect(
+      call(datasetReadinessMiddleware, path)
+    ).resolves.toBeUndefined();
+  });
+
+  it.each([
+    '/stremio/uuid/pw/stream/movie/tt1.json',
+    '/chilllink/uuid/pw/streams/movie/tt1.json',
+    '/api/v1/search',
+    '/api/v1/catalogs',
+    '/api/v1/anime/mapping',
+    '/api/v1/newznab/api',
+    '/builtins/torznab/search',
+  ])('holds %s', async (path) => {
+    const { datasetReadinessMiddleware } = await loadModule();
+    let passed = false;
+    void call(datasetReadinessMiddleware, path).then(() => {
+      passed = true;
+    });
+    await Promise.resolve();
+    expect(passed).toBe(false);
+  });
+
+  it('releases waiters if the build never finishes', async () => {
+    const { datasetReadinessMiddleware } = await loadModule();
+
+    let passed = false;
+    const inFlight = call(datasetReadinessMiddleware).then(() => {
+      passed = true;
+    });
+
+    await vi.advanceTimersByTimeAsync(119_000);
+    expect(passed).toBe(false);
+
+    await vi.advanceTimersByTimeAsync(2_000);
+    await inFlight;
+    expect(passed).toBe(true);
+  });
+
+  it('warns once, not once per waiting request', async () => {
+    const { datasetReadinessMiddleware, onDatasetWaitTimeout } =
+      await loadModule();
+    const warn = vi.fn();
+    onDatasetWaitTimeout(warn);
+
+    const inFlight = Promise.all(
+      Array.from({ length: 5 }, () => call(datasetReadinessMiddleware))
+    );
+
+    await vi.advanceTimersByTimeAsync(121_000);
+    await inFlight;
+    expect(warn).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not warn when the datasets win the race', async () => {
+    const {
+      datasetReadinessMiddleware,
+      onDatasetWaitTimeout,
+      markDatasetsReady,
+    } = await loadModule();
+    const warn = vi.fn();
+    onDatasetWaitTimeout(warn);
+
+    const inFlight = call(datasetReadinessMiddleware);
+    await vi.advanceTimersByTimeAsync(1_000);
+    markDatasetsReady();
+    await inFlight;
+
+    await vi.advanceTimersByTimeAsync(300_000);
+    expect(warn).not.toHaveBeenCalled();
+  });
+
+  it('does not restart the wait after a timeout has latched it open', async () => {
+    const { datasetReadinessMiddleware, onDatasetWaitTimeout } =
+      await loadModule();
+    const warn = vi.fn();
+    onDatasetWaitTimeout(warn);
+
+    await vi.advanceTimersByTimeAsync(0);
+    const first = call(datasetReadinessMiddleware);
+    await vi.advanceTimersByTimeAsync(121_000);
+    await first;
+
+    let passed = false;
+    const second = call(datasetReadinessMiddleware).then(() => {
+      passed = true;
+    });
+    await second;
+    expect(passed).toBe(true);
+    expect(warn).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/packages/server/src/utils/readiness.ts b/packages/server/src/utils/readiness.ts
new file mode 100644
index 0000000..2a10630
--- /dev/null
+++ b/packages/server/src/utils/readiness.ts
@@ -0,0 +1,64 @@
+import type { NextFunction, Request, RequestHandler, Response } from 'express';
+import { isStaticOrSpaPath } from './served-paths.js';
+
+const PROBE_PATH = /^\/api\/v\d+\/(health|status)(\/|$)/;
+
+function isExempt(routePath: string): boolean {
+  return PROBE_PATH.test(routePath) || isStaticOrSpaPath(routePath);
+}
+
+const MAX_WAIT_MS = 120_000;
+
+let openGate: () => void = () => {};
+let open = false;
+let timeoutHandler: (() => void) | undefined;
+let timer: ReturnType<typeof setTimeout> | undefined;
+
+const openPromise = new Promise<void>((resolve) => {
+  openGate = () => {
+    if (open) return;
+    open = true;
+    if (timer) {
+      clearTimeout(timer);
+      timer = undefined;
+    }
+    resolve();
+  };
+});
+
+export function markDatasetsReady(): void {
+  openGate();
+}
+
+export function datasetGateIsOpen(): boolean {
+  return open;
+}
+
+export function onDatasetWaitTimeout(handler: () => void): void {
+  timeoutHandler = handler;
+}
+
+export function whenDatasetsReady(): Promise<void> {
+  if (open) return Promise.resolve();
+  if (!timer) {
+    timer = setTimeout(() => {
+      timer = undefined;
+      timeoutHandler?.();
+      openGate();
+    }, MAX_WAIT_MS);
+    timer.unref?.();
+  }
+  return openPromise;
+}
+
+export const datasetReadinessMiddleware: RequestHandler = (
+  req: Request,
+  _res: Response,
+  next: NextFunction
+) => {
+  if (open || isExempt(req.path)) {
+    next();
+    return;
+  }
+  whenDatasetsReady().then(() => next(), next);
+};
diff --git a/packages/server/src/utils/served-paths.ts b/packages/server/src/utils/served-paths.ts
new file mode 100644
index 0000000..b6fd0d2
--- /dev/null
+++ b/packages/server/src/utils/served-paths.ts
@@ -0,0 +1,46 @@
+
+export const SPA_STATIC_ROUTES = [
+  '/',
+  '/login',
+  '/oauth/callback/gdrive',
+  '/splashscreen',
+  '/stremio/configure',
+];
+
+export const SPA_DYNAMIC_PATTERNS: RegExp[] = [
+  /^\/stremio\/[^/]+\/[^/]+\/configure$/,
+  /^\/dashboard(\/.*)?$/,
+];
+
+export function isValidSpaRoute(routePath: string): boolean {
+  if (SPA_STATIC_ROUTES.includes(routePath)) {
+    return true;
+  }
+  return SPA_DYNAMIC_PATTERNS.some((pattern) => pattern.test(routePath));
+}
+
+const ROOT_STATIC_FILES = [
+  '/logo.png',
+  '/logo_alt.png',
+  '/favicon.ico',
+  '/manifest.json',
+  '/robots.txt',
+  '/icon0.svg',
+  '/icon1.png',
+  '/apple-icon.png',
+  '/apple-touch-icon.png',
+  '/web-app-manifest-192x192.png',
+  '/web-app-manifest-512x512.png',
+  '/mini-nightly-white.png',
+  '/mini-stable-white.png',
+];
+
+const STATIC_PREFIXES = ['/assets/', '/static/', '/_next/'];
+
+export function isStaticOrSpaPath(routePath: string): boolean {
+  return (
+    ROOT_STATIC_FILES.includes(routePath) ||
+    STATIC_PREFIXES.some((prefix) => routePath.startsWith(prefix)) ||
+    isValidSpaRoute(routePath)
+  );
+}
