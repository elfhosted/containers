+/**
+ * True when two endpoints address the same host and path, ignoring trailing
+ * slashes and query. Used to recognise the health-backed indexer whichever
+ * form it was configured in.
+ */
+function sameEndpoint(a: string, b: string): boolean {
+  try {
+    const ua = new URL(a);
+    const ub = new URL(b);
+    const norm = (p: string) => p.replace(/\/+$/, '');
+    return ua.host === ub.host && norm(ua.pathname) === norm(ub.pathname);
+  } catch {
+    return false;
+  }
+}
