--- /dev/null
+++ b/packages/core/src/builtins/utils/nzbContribution.ts
@@ -0,0 +1,85 @@
+import { fetch, FormData } from 'undici';
+import crypto from 'crypto';
+import { createLogger } from '../../utils/index.js';
+import { makeUrlLogSafe } from '../../utils/http.js';
+import { config as appConfig } from '../../config/index.js';
+
+const logger = createLogger('nzb-contribution');
+
+const recent = new Map<string, number>();
+const RECENT_TTL_MS = 6 * 60 * 60 * 1000;
+const RECENT_MAX = 5000;
+
+function inFlightOrSubmitted(key: string): boolean {
+  const now = Date.now();
+  const at = recent.get(key);
+  if (at !== undefined && now - at < RECENT_TTL_MS) return true;
+  if (recent.size >= RECENT_MAX) {
+    for (const [k, t] of recent) {
+      if (now - t >= RECENT_TTL_MS) recent.delete(k);
+    }
+    if (recent.size >= RECENT_MAX) {
+      const oldest = recent.keys().next();
+      if (!oldest.done) recent.delete(oldest.value);
+    }
+  }
+  recent.set(key, now);
+  return false;
+}
+
+export function contributeNzb(
+  bytes: Buffer,
+  source: string,
+  name?: string
+): void {
+  if (!appConfig.builtins.nab.healthContribute) return;
+  const url = appConfig.builtins.nab.healthIngestUrl;
+  if (!url) {
+    logger.debug('NZB contribution enabled but no ingest endpoint is set.');
+    return;
+  }
+  if (!bytes?.length) return;
+
+  const key = crypto.createHash('sha1').update(bytes).digest('hex');
+  if (inFlightOrSubmitted(key)) return;
+
+  const base = (name || source.split('/').pop() || 'release')
+    .replace(/\.nzb$/i, '')
+    .replace(/[<>:"/\\|?*]+/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+  const releaseName = base || 'release';
+  const form = new FormData();
+  form.append(
+    'metadata',
+    JSON.stringify({ name: releaseName, source: 'AIOStreams' })
+  );
+  form.append(
+    'nzb',
+    new Blob([new Uint8Array(bytes)], { type: 'application/x-nzb' }),
+    `${releaseName.replace(/\s+/g, '.')}.nzb`
+  );
+
+  void fetch(url, {
+    method: 'POST',
+    body: form,
+    signal: AbortSignal.timeout(appConfig.builtins.nab.zyclopsHealthApiTimeout),
+  })
+    .then((res) => {
+      void res.body?.cancel().catch(() => undefined);
+      if (res.status < 200 || res.status >= 300) {
+        recent.delete(key);
+        logger.debug(
+          `NZB contribution returned ${res.status} for ${makeUrlLogSafe(source)}`
+        );
+      }
+    })
+    .catch((err) => {
+      recent.delete(key);
+      logger.debug(
+        `NZB contribution failed for ${makeUrlLogSafe(source)}: ${
+          err instanceof Error ? err.message : String(err)
+        }`
+      );
+    });
+}
