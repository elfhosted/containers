+import dns from 'node:dns';
+import { isIP } from 'node:net';
+import { Dispatcher, ProxyAgent } from 'undici';
+import { config as appConfig } from '../config/index.js';
+import { createLogger } from '../logging/logger.js';
+import { isBlockedAddress } from './url-safety.js';
+
+/**
+ * INDEXER_EGRESS_PROXY: one HTTP(S) forward proxy that carries every Usenet
+ * indexer request.
+ *
+ * When set to a valid proxy URL, these requests are sent through it:
+ *
+ *   - built-in Newznab API calls (caps, searches, connection tests)
+ *   - NZB grabs made by this process: the grab cache behind the NZB proxy
+ *     route, the native usenet engine, the SABnzbd-compatible addurl
+ *     endpoint, library rechecks, and the StremThru NZB upload
+ *
+ * For those requests it takes the place of the forwarding endpoints
+ * (`BUILTIN_NAB_REPLAY_ENDPOINT`, `BUILTIN_NZB_REPLAY_DOWNLOAD_URL`, which are
+ * then neither called nor wrapped around NZB URLs), `REPLAY_BYPASS_HOSTS`,
+ * `BUILTIN_NAB_HTTP_PROXY` and any `ADDON_PROXY` / `ADDON_PROXY_CONFIG` match.
+ * Request headers are the ones the direct path already sends.
+ *
+ * Not covered: Torznab, debrid and NNTP traffic, and NZB links that are only
+ * handed to another service (nzbdav, AltMount, TorBox and similar fetch those
+ * themselves, from their own network).
+ *
+ * Destinations a remote proxy could not reach keep their current route:
+ * loopback and private addresses (as literals, or names that resolve to
+ * them), `localhost`, single-label names, cluster service names (`*.svc`,
+ * `*.cluster.local`) and the hosts of this instance's own configured
+ * endpoints (internal URL, forwarding and health proxy endpoints).
+ *
+ * Accepted value: an absolute `http://` or `https://` URL with a host,
+ * optional `user:password@` and optional port, and no path, query or
+ * fragment. Anything else is reported once, without the value, and ignored.
+ * A failure reaching the proxy fails that request; it is never retried on
+ * another route.
+ *
+ * Neither the URL nor its credentials are logged; where the route is logged
+ * at all, it is as `host:port`.
+ */
+export const INDEXER_EGRESS_PROXY_ENV = 'INDEXER_EGRESS_PROXY';
+
+const logger = createLogger('indexer-egress');
+
+export type IndexerEgressParse =
+  | { kind: 'unset' }
+  | { kind: 'invalid'; reason: string }
+  | {
+      kind: 'valid';
+      /** Proxy origin without credentials. */
+      origin: string;
+      /** `host:port`, the only form that is ever logged. */
+      target: string;
+      /** `Proxy-Authorization` value, when the URL carried credentials. */
+      authorization?: string;
+    };
+
+const DEFAULT_PORTS: Record<string, string> = {
+  'http:': '80',
+  'https:': '443',
+};
+
+/** Validates a raw value. Never echoes the value back in `reason`. */
+export function parseIndexerEgressProxy(
+  raw: string | undefined | null
+): IndexerEgressParse {
+  const value = (raw ?? '').trim();
+  if (!value) return { kind: 'unset' };
+
+  // Checked on the raw text: `http://host/?` parses with an empty search.
+  if (/[?#]/.test(value)) {
+    return { kind: 'invalid', reason: 'it has a query or fragment' };
+  }
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return { kind: 'invalid', reason: 'it is not a valid absolute URL' };
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    return { kind: 'invalid', reason: 'the scheme must be http or https' };
+  }
+  if (!url.hostname) {
+    return { kind: 'invalid', reason: 'it has no host' };
+  }
+  if (url.pathname !== '/' && url.pathname !== '') {
+    return { kind: 'invalid', reason: 'it has a path' };
+  }
+
+  let authorization: string | undefined;
+  if (url.username || url.password) {
+    let user: string;
+    let pass: string;
+    try {
+      user = decodeURIComponent(url.username);
+      pass = decodeURIComponent(url.password);
+    } catch {
+      return {
+        kind: 'invalid',
+        reason: 'its credentials are not valid percent-encoding',
+      };
+    }
+    authorization =
+      'Basic ' + Buffer.from(`${user}:${pass}`).toString('base64');
+  }
+
+  const port = url.port || DEFAULT_PORTS[url.protocol];
+  return {
+    kind: 'valid',
+    origin: `${url.protocol}//${url.host}`,
+    target: `${url.hostname}:${port}`,
+    authorization,
+  };
+}
+
+export interface IndexerEgress {
+  dispatcher: Dispatcher;
+  /** `host:port` of the proxy, for logs. */
+  target: string;
+}
+
+let memo: {
+  raw: string | undefined;
+  egress: IndexerEgress | undefined;
+} | null = null;
+
+/**
+ * The configured proxy, or undefined when unset or invalid. Re-read whenever
+ * the variable's value changes; an invalid value is reported once per value.
+ */
+export function getIndexerEgress(): IndexerEgress | undefined {
+  const raw = process.env[INDEXER_EGRESS_PROXY_ENV];
+  if (memo && memo.raw === raw) return memo.egress;
+
+  const previous = memo?.egress;
+  const parsed = parseIndexerEgressProxy(raw);
+  let egress: IndexerEgress | undefined;
+  if (parsed.kind === 'invalid') {
+    logger.error(
+      `${INDEXER_EGRESS_PROXY_ENV} is ignored because ${parsed.reason}; indexer requests use their usual route`
+    );
+  } else if (parsed.kind === 'valid') {
+    egress = {
+      target: parsed.target,
+      // Plain-HTTP targets go as absolute-form requests; HTTPS targets are
+      // tunnelled with CONNECT. Credentials travel as a header built here, so
+      // the agent never holds them inside a URL that could reach an error.
+      dispatcher: new ProxyAgent({
+        uri: parsed.origin,
+        proxyTunnel: false,
+        ...(parsed.authorization ? { token: parsed.authorization } : {}),
+      }),
+    };
+  }
+  memo = { raw, egress };
+  if (previous) void previous.dispatcher.close().catch(() => undefined);
+  return egress;
+}
+
+/** Logs, once at startup, whether indexer requests use the proxy. */
+export function logIndexerEgressStatus(): void {
+  const egress = getIndexerEgress();
+  if (egress) {
+    logger.info(
+      `Indexer requests are using a custom egress proxy (${egress.target})`
+    );
+  }
+}
+
+const hostOf = (raw: string | null | undefined): string | undefined => {
+  if (!raw) return undefined;
+  try {
+    return normaliseHostname(new URL(raw).hostname);
+  } catch {
+    return undefined;
+  }
+};
+
+const normaliseHostname = (hostname: string): string =>
+  hostname
+    .replace(/^\[|\]$/g, '')
+    .toLowerCase()
+    .replace(/\.+$/, '');
+
+/**
+ * Hosts of this instance's own configured endpoints, as configured and as
+ * rewritten by `REQUEST_URL_MAPPINGS` (requests are classified after it).
+ */
+function configuredInternalHosts(): Set<string> {
+  const nab = appConfig.builtins.nab;
+  const mappings = appConfig.http.requestUrlMappings ?? {};
+  const hosts = new Set<string>();
+  for (const raw of [
+    appConfig.bootstrap.internalUrl,
+    nab.replayEndpoint,
+    nab.replayDownloadUrl,
+    nab.zyclopsHealthProxyEndpoint,
+  ]) {
+    const host = hostOf(raw);
+    if (host) hosts.add(host);
+    let origin: string | undefined;
+    try {
+      origin = raw ? new URL(raw).origin : undefined;
+    } catch {
+      origin = undefined;
+    }
+    const mapped = origin ? hostOf(mappings[origin]) : undefined;
+    if (mapped) hosts.add(mapped);
+  }
+  return hosts;
+}
+
+const RESOLVE_TTL_MS = 60_000;
+const RESOLVE_TIMEOUT_MS = 2_000;
+const RESOLVE_CACHE_MAX = 1_000;
+const resolved = new Map<string, { internal: boolean; until: number }>();
+
+/**
+ * Whether a name resolves to a loopback, private, link-local or CGNAT
+ * address, which a remote proxy could not reach. A name that does not
+ * resolve here counts as external: the proxy may still resolve it.
+ */
+async function resolvesInternally(host: string): Promise<boolean> {
+  const now = Date.now();
+  const hit = resolved.get(host);
+  if (hit && hit.until > now) return hit.internal;
+
+  let internal = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    const addresses = await Promise.race([
+      dns.promises.lookup(host, { all: true }),
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(
+          () => reject(new Error('lookup timed out')),
+          RESOLVE_TIMEOUT_MS
+        );
+      }),
+    ]);
+    internal = addresses.some((a) => isBlockedAddress(a.address));
+  } catch {
+    internal = false;
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+
+  if (resolved.size >= RESOLVE_CACHE_MAX) resolved.clear();
+  resolved.set(host, { internal, until: now + RESOLVE_TTL_MS });
+  return internal;
+}
+
+/**
+ * True for a destination an external proxy could not reach: loopback and
+ * private addresses (written as literals or resolved from the name),
+ * `localhost`, single-label names, `*.svc` / `*.cluster.local`, and the hosts
+ * of this instance's own configured endpoints. Pass the URL after
+ * `rewriteRequestUrl`, which is where the request actually goes.
+ */
+export async function isInternalDestination(url: URL): Promise<boolean> {
+  const host = normaliseHostname(url.hostname);
+  if (!host) return true;
+  if (host === 'localhost' || host.endsWith('.localhost')) return true;
+  if (configuredInternalHosts().has(host)) return true;
+  if (isIP(host)) return isBlockedAddress(host);
+  if (!host.includes('.')) return true;
+  if (host.endsWith('.svc') || host.endsWith('.cluster.local')) return true;
+  return resolvesInternally(host);
+}
+
+/**
+ * The proxy for this request, when the variable is set, the request is
+ * indexer traffic and its (rewritten) destination is not internal.
+ */
+export async function indexerEgressFor(
+  url: URL,
+  isIndexerRequest: boolean
+): Promise<IndexerEgress | undefined> {
+  if (!isIndexerRequest) return undefined;
+  const egress = getIndexerEgress();
+  if (!egress) return undefined;
+  return (await isInternalDestination(url)) ? undefined : egress;
+}
+
+/** Clears the resolution cache. For tests. */
+export function resetIndexerEgressCache(): void {
+  resolved.clear();
+}
