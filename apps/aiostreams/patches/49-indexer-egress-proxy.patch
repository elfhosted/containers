+import assert from 'node:assert/strict';
+import dns from 'node:dns';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Agent, type Dispatcher, setGlobalDispatcher } from 'undici';
+import { createServer, type IncomingMessage, type Server } from 'node:http';
+import type { AddressInfo, Socket } from 'node:net';
+import { after, before, beforeEach, describe, it, mock } from 'node:test';
+
+// Every module under test is imported dynamically, after the environment
+// below is in place: the settings store and the logger read it on load.
+process.env.LOG_LEVEL = 'debug';
+// Request headers and dispatchers are logged too; the proxy's must not be.
+process.env.LOG_SENSITIVE_INFO = 'true';
+// A grab cache of its own, so no earlier run can answer for the stubs.
+const scratch = mkdtempSync(join(tmpdir(), 'indexer-egress-'));
+process.env.DISK_CACHE_DIR = join(scratch, 'cache');
+
+const PROXY_USER = 'egress-user';
+const PROXY_PASS = 'egress-pass-7d1c';
+
+interface Seen {
+  /** Absolute-form request lines, e.g. `GET http://host/path`. */
+  requests: string[];
+  /** CONNECT targets, e.g. `host:443`. */
+  connects: string[];
+  proxyAuth: (string | undefined)[];
+}
+
+const fresh = (): Seen => ({ requests: [], connects: [], proxyAuth: [] });
+
+const CAPS = `<?xml version="1.0" encoding="UTF-8"?>
+<caps>
+  <server title="Stub"/>
+  <limits max="100" default="100"/>
+  <searching>
+    <search available="yes" supportedParams="q,imdbid"/>
+    <movie-search available="yes" supportedParams="q,imdbid"/>
+  </searching>
+  <categories><category id="2000" name="Movies"/></categories>
+</caps>`;
+
+const searchXml = (enclosure: string) => `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0" xmlns:newznab="http://www.newznab.com/DTD/2010/feeds/attributes/">
+  <channel>
+    <item>
+      <title>Some.Movie.2020.1080p.WEB-DL.x264-GRP</title>
+      <guid>1</guid>
+      <pubDate>Mon, 01 Jan 2024 00:00:00 +0000</pubDate>
+      <enclosure url="${enclosure}" length="1000" type="application/x-nzb"/>
+      <newznab:attr name="size" value="1000"/>
+    </item>
+  </channel>
+</rss>`;
+
+const NZB = `<?xml version="1.0" encoding="UTF-8"?>
+<nzb>
+  <file poster="p" date="1" subject="s">
+    <groups><group>alt.binaries.test</group></groups>
+    <segments><segment bytes="1" number="1">a@b</segment></segments>
+  </file>
+</nzb>`;
+
+/** Answers an indexer request for `target` the way an indexer would. */
+function answer(target: URL): { status: number; body: string } {
+  const t = target.searchParams.get('t');
+  if (t === 'caps') return { status: 200, body: CAPS };
+  if (t) {
+    return {
+      status: 200,
+      body: searchXml(
+        `http://dl.example.com/getnzb/${target.hostname}.nzb?apikey=KEY`
+      ),
+    };
+  }
+  return { status: 200, body: NZB };
+}
+
+/** A forward proxy that serves indexer answers for plain-HTTP targets. */
+function stubProxy(seen: () => Seen, serve: boolean): Server {
+  const server = createServer((req: IncomingMessage, res) => {
+    seen().requests.push(`${req.method} ${req.url}`);
+    seen().proxyAuth.push(req.headers['proxy-authorization']);
+    if (!serve || !req.url?.startsWith('http')) {
+      res.writeHead(502).end();
+      return;
+    }
+    const target = new URL(req.url);
+    if (target.hostname.startsWith('denied')) {
+      res.writeHead(407, { 'Proxy-Authenticate': 'Basic' }).end();
+      return;
+    }
+    if (target.hostname.startsWith('redirect')) {
+      // An indexer redirecting a grab to a forwarding-wrapped link.
+      const location = new URL(`${FORWARDER}/nzb`);
+      location.searchParams.set(
+        'url',
+        `http://after-${target.hostname}/getnzb/1.nzb?apikey=KEY`
+      );
+      res.writeHead(302, { Location: location.toString() }).end();
+      return;
+    }
+    const { status, body } = answer(target);
+    res.writeHead(status, { 'Content-Type': 'application/xml' }).end(body);
+  });
+  server.on('connect', (req: IncomingMessage, socket: Socket) => {
+    seen().connects.push(req.url ?? '');
+    seen().proxyAuth.push(req.headers['proxy-authorization']);
+    socket.end('HTTP/1.1 502 Bad Gateway\r\n\r\n');
+  });
+  return server;
+}
+
+/** The forwarding endpoints: a search relay and an NZB download wrapper. */
+function stubForwarder(seen: () => Seen): Server {
+  return createServer((req, res) => {
+    let raw = '';
+    req.on('data', (c) => (raw += c));
+    req.on('end', () => {
+      seen().requests.push(`${req.method} ${req.url}`);
+      const url = new URL(req.url ?? '/', 'http://localhost');
+      let target: URL;
+      if (url.pathname === '/search') {
+        const { host, path } = JSON.parse(raw);
+        target = new URL(`http://${host}${path}`);
+      } else {
+        target = new URL(
+          url.searchParams.get('url') ?? 'http://x.example.com/'
+        );
+      }
+      const { status, body } = answer(target);
+      res.writeHead(status, { 'Content-Type': 'application/xml' }).end(body);
+    });
+  });
+}
+
+const listen = (server: Server) =>
+  new Promise<number>((resolve) =>
+    server.listen(0, () => resolve((server.address() as AddressInfo).port))
