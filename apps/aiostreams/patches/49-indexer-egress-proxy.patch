+const EGRESS = `http://${PROXY_USER}:${PROXY_PASS}@127.0.0.1:${egressPort}`;
+const NORMAL = `http://127.0.0.1:${normalPort}`;
+const FORWARDER = `http://localhost:${forwarderPort}`;
+
+// The routes the variable has to win over.
+process.env.BUILTIN_NAB_REPLAY_ENDPOINT = `${FORWARDER}/search`;
+process.env.BUILTIN_NZB_REPLAY_DOWNLOAD_URL = `${FORWARDER}/nzb`;
