+const { settingsStore } = await import('../config/index.js');
+const { initDb, closeDb } = await import('../db/db.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+// The package entry point, so modules load in the order the app loads them.
+await import('../index.js');
+const { BaseNabApi } = await import('../builtins/base/nab/api.js');
+const { NewznabAddon } = await import('../builtins/newznab/addon.js');
+const { downloadManager } = await import('./download-manager.js');
+const { StremThruService } = await import('../debrid/stremthru.js');
+const { createLogger } = await import('../logging/logger.js');
+const { logRingBuffer } = await import('../logging/ring-buffer.js');
+const egressModule = await import('./indexer-egress.js');
+const { parseIndexerEgressProxy, getIndexerEgress, logIndexerEgressStatus } =
+  egressModule;
+
+const testLogger = createLogger('indexer-egress-test');
+
+let hostSeq = 0;
+/** A host no earlier test has used, so no cache answers for it. */
+const host = (label: string) => `${label}${++hostSeq}.example.com`;
+
+const caps = (baseUrl: string) =>
+  new BaseNabApi(
+    'newznab',
+    testLogger,
+    baseUrl,
+    'KEY',
+    '/api'
+  ).getCapabilities();
+
+const grab = (url: string) => downloadManager.fetchNzb(url);
+
+const logLines = async (): Promise<string> => {
+  // pino hands lines to the ring stream asynchronously.
+  await new Promise((r) => setTimeout(r, 50));
+  return logRingBuffer
+    .query({ limit: 100000 })
+    .records.map((r) => r.line)
+    .join('\n');
+};
+
+const PROXY_BASIC = Buffer.from(`${PROXY_USER}:${PROXY_PASS}`).toString(
+  'base64'
+);
+
+const assertNoSecrets = (text: string) => {
+  assert.ok(!text.includes(PROXY_BASIC), 'proxy credentials reached the log');
+  assert.ok(!text.includes(PROXY_PASS), 'proxy password reached the log');
+  assert.ok(!text.includes(PROXY_USER), 'proxy username reached the log');
+  assert.ok(!text.includes(EGRESS), 'proxy URL reached the log');
+};
+
+before(async () => {
