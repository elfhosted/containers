+/**
+ * Optional stream C: appends every line to LOG_FILE, so logs outlive the
+ * process and can be read from the filesystem. Lines are rendered the same way
+ * as stdout (json verbatim, text through pino-pretty without colour) and are
+ * already redacted.
+ *
+ * The file is a pino.destination (SonicBoom) in async mode, the same kind of
+ * stream as stdout: writes never block the event loop, at most
+ * LOG_FILE_MAX_PENDING bytes wait for a slow disk (beyond that, lines are
+ * dropped and the drop is noted in the file once writing recovers), and
+ * a normal exit drains what is pending.
+ *
+ * Rotation: bytes are counted as they reach the disk. Once the file passes
+ * LOG_FILE_MAX_SIZE it is renamed (async) to `<LOG_FILE>.1`, replacing any
+ * older one, and the stream reopens a new file. While the rename is in flight
+ * at most LOG_FILE_ROTATION_SLACK more bytes are accepted (the rest are
+ * dropped and noted), and lines already queued may still reach the old file,
+ * so `.1` holds at most LOG_FILE_MAX_SIZE + LOG_FILE_MAX_PENDING +
+ * LOG_FILE_ROTATION_SLACK bytes. The file opens asynchronously, so lines logged in
+ * the first moments of startup are lost from the file (not from stdout) if
+ * the process exits before it has opened. On process.exit() the file is not
+ * written synchronously, so shutdown never waits on it: lines still queued at
+ * that instant are only in stdout. A single record larger than
+ * LOG_FILE_MAX_RECORD is replaced by a short notice. A file error never takes
+ * the app down: file logging turns itself off and says so once on stderr.
+ */
+const LOG_FILE_DEFAULT_MAX_SIZE = 10 * 1024 * 1024;
+const LOG_FILE_MIN_MAX_SIZE = 1024 * 1024;
+const LOG_FILE_MAX_PENDING = 4 * 1024 * 1024;
+const LOG_FILE_MAX_RECORD = 256 * 1024;
+const LOG_FILE_ROTATION_SLACK = 256 * 1024;
+
+export function parseLogFileMaxSize(raw: string | undefined): number {
+  const n = Number(raw);
+  if (!raw || !Number.isFinite(n) || n <= 0) return LOG_FILE_DEFAULT_MAX_SIZE;
+  return Math.max(LOG_FILE_MIN_MAX_SIZE, Math.floor(n));
+}
+
+export function buildFileStream(
+  file: string,
+  maxSize: number
+): DestinationStream & { readonly disabled: boolean } {
+  // Always a path: pino treats a numeric `dest` as a file descriptor.
+  const path = resolve(file);
+  const prettify = prettyFactory({ colorize: false, sync: true });
+  const out = pino.destination({
+    dest: path,
+    sync: false,
+    mkdir: true,
+    append: true,
+    maxLength: LOG_FILE_MAX_PENDING,
+  });
+  let size = 0;
+  let ready = false;
+  let rotating = false;
+  let rotationBytes = 0;
+  let disabled = false;
+  let dropped = 0;
+  let lastWriteDropped = false;
+  // A write carrying only a drop notice: rejecting it loses no app record.
+  let noticeOnly = false;
+
+  const disable = (err: unknown) => {
+    if (disabled) return;
+    disabled = true;
+    process.stderr.write(
+      `LOG_FILE ${path}: file logging turned off: ${String(err)}\n`
+    );
+    try {
+      out.destroy();
+    } catch {
+      // already closed
+    }
+  };
+  out.on('error', disable);
+  // pino flushes this stream synchronously on process.exit(). A synchronous
+  // write can block indefinitely (a stalled filesystem, a FIFO), so for this
+  // stream that flush does nothing.
+  out.flushSync = () => {};
+  out.on('drop', () => {
+    if (!noticeOnly) dropped++;
+    lastWriteDropped = true;
+  });
+  out.on('ready', () => {
+    ready = true;
+  });
+  out.on('write', (n: number) => {
+    size += n;
+    if (ready && !rotating && !disabled && size >= maxSize) rotate();
+  });
+  // Count what is already there, so a restart does not reset the limit.
+  stat(path, (err, st) => {
+    if (!err) size += st.size;
+  });
+
+  // A notice in the file's own format, so json files stay one JSON per line.
+  const notice = (msg: string): string =>
+    currentFormat === 'text'
+      ? `[${msg}]\n`
+      : JSON.stringify({
+          level: 'warn',
+          time: new Date().toISOString(),
+          module: 'log-file',
+          msg,
+        }) + '\n';
+
+  const render = (chunk: string): string => {
+    if (currentFormat !== 'text') return chunk;
+    let text = '';
+    for (const line of chunk.split('\n')) {
+      if (!line) continue;
+      try {
+        text += prettify(JSON.parse(line) as Record<string, unknown>);
+      } catch {
+        text += line + '\n';
+      }
+    }
+    return text;
+  };
+
+  const rotate = () => {
+    rotating = true;
+    rotationBytes = 0;
+    rename(path, `${path}.1`, (err) => {
+      rotating = false;
+      // ENOENT: the file was removed by hand; reopening starts a fresh one.
+      if (err && err.code !== 'ENOENT') {
+        disable(err);
+        return;
+      }
+      if (disabled) return;
+      size = 0;
+      out.reopen();
+    });
+  };
+
+  const api = {
+    get disabled() {
+      return disabled;
+    },
+    write(chunk: string) {
+      if (disabled) return;
+      let text = render(chunk);
+      const hasRecord = text.length > 0;
+      if (Buffer.byteLength(text) > LOG_FILE_MAX_RECORD) {
+        text = notice(
+          `a log record of ${Buffer.byteLength(text)} bytes was too large for LOG_FILE and was left out`
+        );
+      }
+      const pendingDrops = dropped;
+      if (pendingDrops) {
+        text =
+          notice(
+            `${pendingDrops} log writes were dropped: the log file could not keep up`
+          ) + text;
+      }
+      if (!text) return;
+      if (rotating) {
+        // The whole output counts, notice included.
+        const len = Buffer.byteLength(text);
+        if (rotationBytes + len > LOG_FILE_ROTATION_SLACK) {
+          if (hasRecord) dropped++;
+          return;
+        }
+        rotationBytes += len;
+      }
+      lastWriteDropped = false;
+      noticeOnly = !hasRecord;
+      out.write(text);
+      noticeOnly = false;
+      // Only forget the count once its notice is actually in the queue.
+      if (!lastWriteDropped) dropped -= pendingDrops;
+    },
+  };
+  // Report drops even if nothing else is logged after the burst.
+  out.on('drain', () => {
+    if (dropped && !disabled) api.write('');
+  });
+  return api;
+}
+
+const logFileStream = process.env.LOG_FILE
+  ? buildFileStream(
+      process.env.LOG_FILE,
+      parseLogFileMaxSize(process.env.LOG_FILE_MAX_SIZE)
+    )
+  : undefined;
+
 const root: PinoLogger = pino(
