index 00000000..9ac7d1b7
--- /dev/null
+++ b/packages/core/src/utils/private-addresses.test.ts
@@ -0,0 +1,218 @@
+import assert from 'node:assert/strict';
+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { after, before, describe, it, mock } from 'node:test';
+
+// Loopback servers stand in for private services. Each answers 200 with the
+// path it saw, or redirects when asked to.
+const listen = async (): Promise<Server> => {
+  const server = createServer((req, res) => {
+    const to = new URL(req.url ?? '/', 'http://x').searchParams.get('to');
+    if (to) {
+      res.writeHead(302, { location: to }).end();
+      return;
+    }
+    res.writeHead(200).end(req.url);
+  });
+  await new Promise<void>((r) => server.listen(0, '127.0.0.1', r));
+  return server;
+};
+
+const servers = await Promise.all([listen(), listen(), listen(), listen()]);
+const [ruled, pathed, bare, unconfigured] = servers.map(
+  (s) => `http://127.0.0.1:${(s.address() as AddressInfo).port}`
+);
+
+// IPv6 loopback, when the host has it: rule keys must match bracketed hosts.
+const v6 = await new Promise<Server | undefined>((resolve) => {
+  const server = createServer((req, res) => res.writeHead(200).end(req.url));
+  server.once('error', () => resolve(undefined));
+  server.listen(0, '::1', () => resolve(server));
+});
+if (v6) servers.push(v6);
+const ruledV6 = v6
+  ? `http://[::1]:${(v6.address() as AddressInfo).port}`
+  : undefined;
+
+process.env.ALLOW_PRIVATE_URLS = 'false';
+process.env.PRIVATE_URL_PATH_MODE = 'enforce';
+// Configured bare, then narrowed by an explicit rule.
+process.env.BUILTIN_ZILEAN_URL = ruled;
+process.env.PRIVATE_URL_PATH_RULES = JSON.stringify({
+  [ruled]: ['/dmm/', '/torrents/touch'],
+  ...(ruledV6 ? { [ruledV6]: ['/dmm/'] } : {}),
+});
+// Configured bare too, so only the rule can narrow it.
+if (ruledV6) process.env.BUILTIN_ELFCACHE_URL = ruledV6;
+// Configured with a path and no rule: that path is the allowance.
+process.env.ZYCLOPS_HEALTH_API_URL = `${pathed}/api/v1/batch`;
+// Configured bare and no rule: every path.
+process.env.BUILTIN_STREMTHRU_URL = bare;
+
+const { settingsStore } = await import('../config/index.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+const { httpSchema } = await import('../config/schema/http.js');
+const {
+  installPrivateAddressGuard,
+  pathAllowed,
+  redactPath,
+  ruleKey,
+  PrivateAddressError,
+} = await import('./private-addresses.js');
+
+before(async () => {
+  mock.method(SettingsRepository, 'getAll', async () => []);
+  mock.method(SettingsRepository, 'getVersion', async () => 0);
+  await settingsStore.initialise();
+  installPrivateAddressGuard();
+});
+
+after(() => {
+  for (const s of servers) s.close();
+});
+
+const get = async (url: string) => {
+  const res = await fetch(url);
+  return { status: res.status, body: await res.text() };
+};
+
+const refused = async (url: string) => {
+  let message = '';
+  await assert.rejects(fetch(url), (err: Error) => {
+    assert.ok(err.cause instanceof PrivateAddressError, String(err.cause));
+    message = (err.cause as Error).message;
+    return true;
+  });
+  return message;
+};
+
+describe('pathAllowed', () => {
+  it('matches prefixes on a segment boundary', () => {
+    assert.ok(pathAllowed('/api', ['/api']));
+    assert.ok(pathAllowed('/api/x?y=1', ['/api']));
+    assert.ok(!pathAllowed('/apix', ['/api']));
+    assert.ok(pathAllowed('/dmm/x', ['/dmm/']));
+    assert.ok(!pathAllowed('/dmm', ['/dmm/']));
+    assert.ok(pathAllowed('/anything', ['/']));
+  });
+
+  it('refuses encoded separators and dots', () => {
+    assert.ok(!pathAllowed('/dmm/%2e%2e/admin', ['/dmm/']));
+    assert.ok(!pathAllowed('/dmm/..%2Fadmin', ['/dmm/']));
+    assert.ok(!pathAllowed('/dmm/..%5cadmin', ['/dmm/']));
+    assert.ok(!pathAllowed('/dmm/..\\admin', ['/dmm/']));
+    assert.ok(!pathAllowed('/dmm/%252e%252e%252fadmin', ['/dmm/']));
+  });
+
+  it('lets an allow-all rule through encoded paths', () => {
+    assert.ok(pathAllowed('/search/AC%2FDC%25', ['/']));
+  });
+});
+
+describe('ruleKey', () => {
+  const key = (u: string) => ruleKey(new URL(u));
+  it('folds spellings of one origin together', () => {
+    assert.equal(key('http://Service.:80/x'), key('http://service'));
+    assert.equal(key('http://[::1]:8181'), 'http://::1:8181');
+  });
+  it('keeps schemes apart', () => {
+    assert.notEqual(key('http://service:8181'), key('https://service:8181'));
+  });
+});
+
+describe('redactPath', () => {
+  it('shows only a first segment the operator wrote', () => {
+    const known = new Set(['stremio', 'api', 's']);
+    assert.equal(redactPath('/stremio/abc123XYZtoken/x', known), '/stremio');
+    assert.equal(redactPath('/api/v1/nzb?apikey=k', known), '/api');
+    assert.equal(redactPath('/s/supersecret/manifest.json', known), '/s');
+    assert.equal(redactPath('/privatepass/isValid', known), '/*');
+    assert.equal(redactPath('/CometAccessSecret', known), '/*');
+    assert.equal(redactPath('/', known), '/');
+  });
+
+  it('learns route words from rules and configured URLs', () => {
+    // From the rule prefixes and BUILTIN_*/ZYCLOPS URLs set above.
+    assert.equal(redactPath('/dmm/x'), '/dmm');
+    assert.equal(redactPath('/api/x'), '/api');
+    assert.equal(redactPath('/admin/x'), '/*');
+  });
+});
+
+describe('PRIVATE_URL_PATH_RULES', () => {
+  it('parses its own output again (settings are stored and reloaded)', () => {
+    const schema = httpSchema.privateUrlPathRules.schema;
+    const once = schema.parse(
+      JSON.stringify({
+        'http://[::1]:8181': ['/api'],
+        'http://service:8181': ['x'],
+      })
+    );
+    assert.deepEqual(schema.parse(once), once);
+    assert.deepEqual(once['http://service:8181'], ['/x']);
+  });
+
+  it('refuses keys that are not http(s) origins', () => {
+    const schema = httpSchema.privateUrlPathRules.schema;
+    assert.throws(() => schema.parse({ 'service:8181': [] }));
+    assert.throws(() => schema.parse({ 'http://x:1/metrics': [] }));
+    assert.throws(() => schema.parse({ 'http://u:p@x:1': [] }));
+    assert.throws(() => schema.parse({ 'http://x:1?a=b': [] }));
+    assert.throws(() => schema.parse({ 'http://x:1\\admin\\..': [] }));
+    assert.throws(() => schema.parse({ 'http:x:1/admin/..': [] }));
+    assert.doesNotThrow(() => schema.parse({ 'http://x:1/': [] }));
+    assert.throws(() => schema.parse({ 'http://x': '/api' as never }));
+  });
+});
+
+describe('private address path guard (enforce)', () => {
+  it('allows a ruled origin under its prefixes', async () => {
+    assert.deepEqual(await get(`${ruled}/dmm/search?q=1`), {
+      status: 200,
+      body: '/dmm/search?q=1',
+    });
+    assert.equal((await get(`${ruled}/torrents/touch`)).status, 200);
+  });
+
+  it('refuses a ruled origin outside its prefixes', async () => {
+    const message = await refused(`${ruled}/admin/abc123XYZtoken/x`);
+    assert.ok(!message.includes('/admin'), 'path reached the error');
+    assert.ok(
+      !message.includes('abc123XYZtoken'),
+      'path token reached the error'
+    );
+    await refused(`${ruled}/`);
+    await refused(`${ruled}/dmmx`);
+  });
+
+  it('refuses dot segments that climb out of a prefix', async () => {
+    // fetch resolves `..` before dispatch, so this reaches /admin.
+    await refused(`${ruled}/dmm/../admin`);
+    await refused(`${ruled}/dmm/%2e%2e/admin`);
+  });
+
+  it('leaves configured origins without a rule as they were', async () => {
+    assert.equal((await get(`${pathed}/api/v1/batch`)).status, 200);
+    assert.equal((await get(`${pathed}/anything/else`)).status, 200);
+  });
+
+  it('allows every path on an origin configured without one', async () => {
+    assert.equal((await get(`${bare}/any/thing`)).status, 200);
+  });
+
+  it('still refuses private origins nobody configured', async () => {
+    await refused(`${unconfigured}/`);
+  });
+
+  it('matches rules on bracketed IPv6 hosts', { skip: !ruledV6 }, async () => {
+    assert.equal((await get(`${ruledV6}/dmm/x`)).status, 200);
+    await refused(`${ruledV6}/admin`);
+  });
+
+  it('checks every redirect hop', async () => {
+    const to = encodeURIComponent(`${ruled}/admin`);
+    await refused(`${bare}/r?to=${to}`);
+    const ok = encodeURIComponent(`${ruled}/dmm/x`);
+    assert.equal((await get(`${bare}/r?to=${ok}`)).status, 200);
+  });
+});
