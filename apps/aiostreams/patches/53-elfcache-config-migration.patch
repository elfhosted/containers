index 0000000..7abc4c5
--- /dev/null
+++ b/packages/core/src/utils/retired-presets.test.ts
@@ -0,0 +1,196 @@
+import { before, describe, it, mock } from 'node:test';
+import assert from 'node:assert/strict';
+
+// Imported dynamically: preset metadata reads settings, which must be loaded first.
+const { settingsStore } = await import('../config/index.js');
+const { SettingsRepository } = await import('../db/repositories/settings.js');
+await import('../index.js');
+const { applyMigrations, mergeConfigs } = await import('./config.js');
+const { PresetManager } = await import('../presets/presetManager.js');
+const { applyVariants } = await import('../variants/runtime.js');
+
+before(async () => {
+  mock.method(SettingsRepository, 'getAll', async () => []);
+  mock.method(SettingsRepository, 'getVersion', async () => 0);
+  await settingsStore.initialise();
+});
+
+
+const mk = () => ({
+  presets: [
+    { type: 'elfcache', instanceId: 'ec1', enabled: true, options: {} },
+    { type: 'comet', instanceId: 'c1', enabled: true, options: {} },
+    { type: 'elfcache', instanceId: 'ec2', enabled: false, options: {} },
+  ],
+  proxy: { enabled: true, proxiedAddons: ['ec1', 'c1'] },
+  deduplicator: { excludeAddons: ['ec2'] },
+  serviceWrap: { enabled: true, presets: ['ec1'] },
+  excludeCachedFromAddons: ['ec1', 'c1'],
+  excludeUncachedFromAddons: ['ec2'],
+  titleMatching: { enabled: true, addons: ['ec1', 'c1'] },
+  yearMatching: { enabled: true, addons: [] },
+  digitalReleaseFilter: { enabled: true, addons: ['ec2'] },
+  groups: {
+    groupings: [
+      { addons: ['ec1'], condition: 'true' },
+      { addons: ['ec1', 'c1'], condition: 'true' },
+      { addons: [], condition: 'true' },
+    ],
+  },
+});
+
+describe('retired presets', () => {
+  it('drops retired preset instances and every reference to them', () => {
+    const c: any = applyMigrations(mk());
+    assert.deepEqual(
+      c.presets.map((p: any) => p.instanceId),
+      ['c1']
+    );
+    assert.deepEqual(c.proxy.proxiedAddons, ['c1']);
+    assert.deepEqual(c.deduplicator.excludeAddons, []);
+    assert.deepEqual(c.serviceWrap.presets, []);
+    assert.deepEqual(c.excludeCachedFromAddons, ['c1']);
+    assert.deepEqual(c.excludeUncachedFromAddons, []);
+    assert.deepEqual(c.titleMatching.addons, ['c1']);
+    assert.deepEqual(c.digitalReleaseFilter.addons, []);
+  });
+
+  it('turns off a setting whose addon list named only retired addons', () => {
+    // An empty list means every addon, so pruning to [] would widen it.
+    const c: any = applyMigrations(mk());
+    assert.equal(c.serviceWrap.enabled, false);
+    assert.equal(c.digitalReleaseFilter.enabled, false);
+    // Still scoped to a remaining addon, or never scoped: left on.
+    assert.equal(c.proxy.enabled, true);
+    assert.equal(c.titleMatching.enabled, true);
+    assert.equal(c.yearMatching.enabled, true);
+    assert.deepEqual(c.yearMatching.addons, []);
+  });
+
+  it('drops a group emptied by the removal, keeps one that was already empty', () => {
+    const c: any = applyMigrations(mk());
+    assert.deepEqual(
+      c.groups.groupings.map((g: any) => g.addons),
+      [['c1'], []]
+    );
+  });
+
+  it('leaves a config without retired presets unchanged', () => {
+    const plain = {
+      presets: [{ type: 'comet', instanceId: 'c1', options: {} }],
+      groups: { groupings: [{ addons: [], condition: 'true' }] },
+    };
+    const c: any = applyMigrations(structuredClone(plain));
+    assert.deepEqual(c.presets, plain.presets);
+    assert.deepEqual(c.groups, plain.groups);
+  });
+
+  it('removes references to a parent config\'s retired instances after merging', () => {
+    // Each config is migrated alone before the merge, so the child still holds
+    // the parent's ids until the merge prunes them.
+    const rawParent = () => ({
+      presets: [
+        { type: 'elfcache', instanceId: 'ec1', enabled: true, options: {} },
+        { type: 'comet', instanceId: 'c1', enabled: true, options: {} },
+      ],
+    });
+    const rawChild = () => ({
+      parentConfig: {
+        uuid: 'parent',
+        mergeStrategies: { presets: 'extend', filters: 'override' },
+      },
+      presets: [],
+      groups: {
+        groupings: [
+          { addons: ['ec1'], condition: 'true' },
+          { addons: ['ec1', 'c1'], condition: 'true' },
+        ],
+      },
+      titleMatching: { enabled: true, addons: ['ec1'] },
+    });
+    const parent: any = applyMigrations(rawParent());
+    const child: any = applyMigrations(rawChild());
+    const childBefore = structuredClone(child);
+    const merged: any = mergeConfigs(parent, child);
+    // The child the merge was built from is left as it was.
+    assert.deepEqual(child, childBefore);
+    // The same once the parent has been saved, so its retired ids are gone.
+    const savedParent: any = applyMigrations(JSON.parse(JSON.stringify(parent)));
+    const mergedAfterSave: any = mergeConfigs(
+      savedParent,
+      applyMigrations(rawChild())
+    );
+    assert.deepEqual(
+      mergedAfterSave.groups.groupings.map((g: any) => g.addons),
+      [['c1']]
+    );
+    assert.equal(mergedAfterSave.titleMatching.enabled, false);
+    assert.deepEqual(
+      merged.presets.map((p: any) => p.instanceId),
+      ['c1']
+    );
+    assert.deepEqual(
+      merged.groups.groupings.map((g: any) => g.addons),
+      [['c1']]
+    );
+    assert.equal(merged.titleMatching.enabled, false);
+  });
+
+  it('prunes references a saved variant sets after the migration has run', () => {
+    // Variants are scripts applied per request, so they cannot be rewritten
+    // in storage; a reference they set is pruned once they have applied.
+    const migrated: any = applyMigrations({
+      presets: [
+        { type: 'elfcache', instanceId: 'ec1', enabled: true, options: {} },
+        { type: 'comet', instanceId: 'c1', enabled: true, options: {} },
+      ],
+      variants: [
+        {
+          id: 'only-cache',
+          script:
+            'set titleMatching.enabled = true\nset titleMatching.addons = ["ec1"]\nset proxy.proxiedAddons = ["ec1", "c1"]',
+        },
+      ],
+    });
+    const { userData }: any = applyVariants(migrated, ['only-cache']);
+    assert.equal(userData.titleMatching.enabled, false);
+    assert.deepEqual(userData.titleMatching.addons, []);
+    assert.deepEqual(userData.proxy.proxiedAddons, ['c1']);
+  });
+
+  it('is unavailable here, which is what retires it', () => {
+    // The test environment configures no ElfCache endpoint.
+    assert.ok(PresetManager.fromId('elfcache').METADATA.DISABLED);
+  });
+
+  it('keeps ElfCache while this instance still offers it', async () => {
+    const env = process.env as Record<string, string | undefined>;
+    const saved = {
+      url: env.BUILTIN_ELFCACHE_URL,
+      hashReport: env.BUILTIN_HASH_REPORT_ENABLED,
+    };
+    env.BUILTIN_ELFCACHE_URL = 'http://elfcache.example';
+    env.BUILTIN_HASH_REPORT_ENABLED = 'true';
+    try {
+      await settingsStore.initialise();
+      assert.equal(PresetManager.fromId('elfcache').METADATA.DISABLED, undefined);
+      const c: any = applyMigrations(mk());
+      assert.deepEqual(
+        c.presets.map((p: any) => p.instanceId),
+        ['ec1', 'c1', 'ec2']
+      );
+      assert.deepEqual(c.proxy.proxiedAddons, ['ec1', 'c1']);
+      assert.equal(c.serviceWrap.enabled, true);
+      assert.equal(c.groups.groupings.length, 3);
+    } finally {
+      for (const [key, value] of [
+        ['BUILTIN_ELFCACHE_URL', saved.url],
+        ['BUILTIN_HASH_REPORT_ENABLED', saved.hashReport],
+      ] as const) {
+        if (value === undefined) delete env[key];
+        else env[key] = value;
+      }
+      await settingsStore.initialise();
+    }
+  });
+});
