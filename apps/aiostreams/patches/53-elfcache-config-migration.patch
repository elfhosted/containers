index 0000000..0b72f8d
--- /dev/null
+++ b/packages/core/src/utils/retired-presets.ts
@@ -0,0 +1,94 @@
+/**
+ * Drops instances of the given preset types from a config, along with every
+ * reference to those instances, so it still loads and saves.
+ */
+export function removeRetiredPresets(config: any, retiredTypes: string[]): any {
+  if (retiredTypes.length === 0) return config;
+  if (!config || !Array.isArray(config.presets)) {
+    return config;
+  }
+  const removed = new Set<string>(
+    config.presets
+      .filter((preset: any) => retiredTypes.includes(preset?.type))
+      .map((preset: any) => preset.instanceId)
+  );
+  if (removed.size === 0) {
+    return config;
+  }
+  config.presets = config.presets.filter(
+    (preset: any) => !retiredTypes.includes(preset?.type)
+  );
+  return pruneReferences(config, (id) => removed.has(id));
+}
+
+/**
+ * References to instances a config no longer has, pruned the same way. A
+ * config that extends a parent can reference the parent's instances, and each
+ * is migrated on its own before the merge; a saved variant can set a reference
+ * after the migration has run.
+ */
+export function removeDanglingReferences<T>(merged: T): T {
+  const config = merged as any;
+  if (!config || !Array.isArray(config.presets)) return merged;
+  const existing = new Set<string>(
+    config.presets.map((preset: any) => preset?.instanceId)
+  );
+  return pruneReferences(config, (id) => !existing.has(id));
+}
+
+// Replaces the sections it changes rather than editing them, because a merged
+// config shares its sections with the child and parent it was built from.
+function pruneReferences(config: any, isRemoved: (id: string) => boolean): any {
+  const keep = (ids: string[]) => ids.filter((id) => !isRemoved(id));
+  const changed = (ids: unknown): ids is string[] =>
+    Array.isArray(ids) && ids.some((id) => isRemoved(id));
+  // In these settings an empty addon list means "every addon". When removal
+  // empties a list that named only removed addons, turn the setting off
+  // instead, so it does not widen to addons it never applied to.
+  const pruneScoped = (section: string, key: string) => {
+    const current = config[section];
+    if (!current || !changed(current[key])) return;
+    const remaining = keep(current[key]);
+    config[section] = {
+      ...current,
+      [key]: remaining,
+      ...(remaining.length === 0 ? { enabled: false } : {}),
+    };
+  };
+  pruneScoped('proxy', 'proxiedAddons');
+  pruneScoped('serviceWrap', 'presets');
+  for (const section of [
+    'digitalReleaseFilter',
+    'yearMatching',
+    'titleMatching',
+    'seasonEpisodeMatching',
+    'episodeTitleMatching',
+  ]) {
+    pruneScoped(section, 'addons');
+  }
+  if (config.deduplicator && changed(config.deduplicator.excludeAddons)) {
+    config.deduplicator = {
+      ...config.deduplicator,
+      excludeAddons: keep(config.deduplicator.excludeAddons),
+    };
+  }
+  for (const key of ['excludeCachedFromAddons', 'excludeUncachedFromAddons']) {
+    if (changed(config[key])) config[key] = keep(config[key]);
+  }
+  // A group needs at least one addon, so a group left empty is dropped.
+  const groupings = config.groups?.groupings;
+  if (Array.isArray(groupings) && groupings.some((g: any) => changed(g?.addons))) {
+    config.groups = {
+      ...config.groups,
+      groupings: groupings
+        .map((group: any) =>
+          changed(group?.addons)
+            ? { ...group, addons: keep(group.addons), emptied: true }
+            : group
+        )
+        .filter((group: any) => !(group?.emptied && group.addons.length === 0))
+        .map(({ emptied, ...group }: any) => group),
+    };
+  }
+  return config;
+}
