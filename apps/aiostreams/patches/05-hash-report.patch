diff --git a/packages/core/src/builtins/utils/hashReport.ts b/packages/core/src/builtins/utils/hashReport.ts
new file mode 100644
index 00000000..1532621a
--- /dev/null
+++ b/packages/core/src/builtins/utils/hashReport.ts
@@ -0,0 +1,184 @@
+import { fetch } from 'undici';
+import { createLogger } from '../../utils/index.js';
+import { config as appConfig } from '../../config/index.js';
+import { validateInfoHash } from './debrid.js';
+
+const logger = createLogger('hash-report');
+
+export interface HashReportRow {
+  hash: string;
+  title: string;
+  size: number;
+  /** Only meaningful when paired with a storeCode in the options. */
+  cached?: boolean;
+}
+
+export interface HashReportOptions {
+  /** Source addon name, used for log lines. */
+  source: string;
+  /** Store code (e.g. "tb"). Omit/empty to send metadata without cache state. */
+  storeCode?: string;
+}
+
+interface ReportPayload {
+  hashes: string[];
+  store_code: string;
+  metadata?: Record<string, { name: string; size: number }>;
+}
+
+function buildPayloads(
+  rows: HashReportRow[],
+  storeCode: string | undefined
+): ReportPayload[] {
+  const metadata: Record<string, { name: string; size: number }> = {};
+  const cachedHashes: string[] = [];
+
+  for (const row of rows) {
+    const hash = validateInfoHash(row.hash);
+    if (!hash) continue;
+
+    if (row.title && Number.isFinite(row.size) && row.size > 0) {
+      metadata[hash] = { name: row.title, size: row.size };
+    }
+    if (storeCode && row.cached === true) {
+      cachedHashes.push(hash);
+    }
+  }
+
+  const allHashes = Array.from(
+    new Set([...cachedHashes, ...Object.keys(metadata)])
+  );
+  if (allHashes.length === 0) return [];
+
+  const cachedSet = new Set(cachedHashes);
+  const batchSize = Math.max(1, appConfig.builtins.hashReport.batchSize);
+  const payloads: ReportPayload[] = [];
+
+  for (let i = 0; i < allHashes.length; i += batchSize) {
+    const slice = allHashes.slice(i, i + batchSize);
+    const batchMetadata: Record<string, { name: string; size: number }> = {};
+    for (const h of slice) {
+      if (metadata[h]) batchMetadata[h] = metadata[h];
+    }
+    payloads.push({
+      hashes: slice.filter((h) => cachedSet.has(h)),
+      store_code: storeCode ?? '',
+      ...(Object.keys(batchMetadata).length > 0
+        ? { metadata: batchMetadata }
+        : {}),
+    });
+  }
+
+  return payloads;
+}
+
+async function postWithRetry(
+  url: string,
+  apiKey: string,
+  body: ReportPayload,
+  source: string
+): Promise<void> {
+  const maxAttempts = 3;
+  let attempt = 0;
+  let lastError: unknown;
+
+  while (attempt < maxAttempts) {
+    attempt++;
+    try {
+      const response = await fetch(url, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          Accept: 'application/json',
+          'X-Api-Key': apiKey,
+        },
+        body: JSON.stringify(body),
+        signal: AbortSignal.timeout(appConfig.builtins.hashReport.timeout),
+      });
+
+      if (response.status >= 200 && response.status < 300) return;
+
+      if (response.status >= 500 && attempt < maxAttempts) {
+        const delay = 250 * 2 ** (attempt - 1);
+        await new Promise((r) => setTimeout(r, delay));
+        continue;
+      }
+
+      logger.warn(
+        `Hash report (${source}) returned ${response.status}; giving up after ${attempt} attempt(s).`
+      );
+      return;
+    } catch (error) {
+      lastError = error;
+      if (attempt < maxAttempts) {
+        const delay = 250 * 2 ** (attempt - 1);
+        await new Promise((r) => setTimeout(r, delay));
+        continue;
+      }
+    }
+  }
+
+  if (lastError) {
+    logger.warn(
+      `Hash report (${source}) failed after ${maxAttempts} attempt(s): ${
+        lastError instanceof Error ? lastError.message : String(lastError)
+      }`
+    );
+  }
+}
+
+export function reportHashes(
+  rows: HashReportRow[] | null | undefined,
+  options: HashReportOptions
+): void {
+  const source = options.source;
+  const rowCount = rows?.length ?? 0;
+
+  if (!appConfig.builtins.hashReport.enabled) {
+    logger.debug(
+      `Hash report (${source}): skipped — reporting disabled (rows=${rowCount}).`
+    );
+    return;
+  }
+  if (!rows || rows.length === 0) {
+    logger.debug(`Hash report (${source}): skipped — no rows.`);
+    return;
+  }
+
+  const apiKey = appConfig.builtins.hashReport.apiKey;
+  if (!apiKey) {
+    logger.warn(
+      `Hash report (${source}): enabled but no API key is set; skipping.`
+    );
+    return;
+  }
+
+  const payloads = buildPayloads(rows, options.storeCode);
+  if (payloads.length === 0) {
+    logger.debug(
+      `Hash report (${source}): skipped — ${rowCount} input row(s) produced no valid payloads (no valid 40-hex hashes / no metadata).`
+    );
+    return;
+  }
+
+  const url = appConfig.builtins.hashReport.url;
+  if (!url) {
+    logger.warn(
+      `Hash report (${source}): enabled but no endpoint is set; skipping.`
+    );
+    return;
+  }
+  const totalHashes = payloads.reduce((s, p) => s + p.hashes.length, 0);
+  const totalMetadata = payloads.reduce(
+    (s, p) => s + (p.metadata ? Object.keys(p.metadata).length : 0),
+    0
+  );
+
+  logger.info(
+    `Hash report (${source}): dispatching ${payloads.length} batch(es) to ${url} — ${totalHashes} cached hash(es), ${totalMetadata} metadata entr(ies).`
+  );
+
+  void Promise.allSettled(
+    payloads.map((p) => postWithRetry(url, apiKey, p, source))
+  );
+}
