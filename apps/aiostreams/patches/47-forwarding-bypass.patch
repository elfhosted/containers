diff --git a/packages/core/src/builtins/utils/replayBypass.test.ts b/packages/core/src/builtins/utils/replayBypass.test.ts
new file mode 100644
index 0000000..7011694
--- /dev/null
+++ b/packages/core/src/builtins/utils/replayBypass.test.ts
@@ -0,0 +1,53 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { isBypassedHost, parseBypassHosts } from './replayBypass.js';
+
+describe('bypass host matching', () => {
+  const on = (raw: string, host: string) =>
+    isBypassedHost(host, parseBypassHosts(raw));
+
+  it('matches an exact host and nothing below it', () => {
+    assert.equal(on('example.com', 'example.com'), true);
+    assert.equal(on('example.com', 'api.example.com'), false);
+  });
+
+  it('matches the domain and its subdomains for a leading dot', () => {
+    assert.equal(on('.example.com', 'example.com'), true);
+    assert.equal(on('.example.com', 'api.example.com'), true);
+    assert.equal(on('.example.com', 'notexample.com'), false);
+  });
+
+  it('matches only subdomains for *.domain', () => {
+    assert.equal(on('*.example.com', 'api.example.com'), true);
+    assert.equal(on('*.example.com', 'example.com'), false);
+    assert.equal(on('*.example.com', 'notexample.com'), false);
+  });
+
+  it('separates entries on commas, semicolons or whitespace', () => {
+    const want = ['a.example.com', 'b.example.com', 'c.example.com'];
+    assert.deepEqual(parseBypassHosts('a.example.com,b.example.com,c.example.com'), want);
+    assert.deepEqual(parseBypassHosts('a.example.com b.example.com c.example.com'), want);
+    assert.deepEqual(parseBypassHosts('a.example.com; b.example.com,  c.example.com'), want);
+    assert.deepEqual(parseBypassHosts('\n a.example.com \t b.example.com\nc.example.com '), want);
+  });
+
+  it('ignores a bare catch-all but keeps the rest of the list', () => {
+    assert.deepEqual(parseBypassHosts('*'), []);
+    assert.equal(on('*', 'example.com'), false);
+    assert.deepEqual(parseBypassHosts('* example.com'), ['example.com']);
+  });
+
+  it('ignores port, case, credentials and IPv6 brackets', () => {
+    assert.equal(on('example.com', 'example.com:443'), true);
+    assert.equal(on('Example.COM', 'example.com'), true);
+    assert.equal(on('example.com', 'user:pw@example.com:443'), true);
+    assert.equal(on('[::1]', '[::1]:8080'), true);
+  });
+
+  it('is inert when unset or empty', () => {
+    assert.equal(on('', 'example.com'), false);
+    assert.equal(on('   ', 'example.com'), false);
+    assert.equal(isBypassedHost('example.com', []), false);
+    assert.equal(isBypassedHost(undefined, ['example.com']), false);
+  });
+});
diff --git a/packages/core/src/builtins/utils/replayBypass.ts b/packages/core/src/builtins/utils/replayBypass.ts
new file mode 100644
index 0000000..270035a
--- /dev/null
+++ b/packages/core/src/builtins/utils/replayBypass.ts
@@ -0,0 +1,56 @@
+/**
+ * Hosts configured to be requested directly rather than through the forwarding
+ * endpoints, applied to both the search call and the NZB fetch.
+ *
+ * Entry forms, all accepted:
+ *
+ *   host        exact match
+ *   .domain     the domain and any subdomain
+ *   *.domain    subdomains only, not the domain itself
+ *
+ * Entries may be separated by commas, semicolons or whitespace. A bare `*` is
+ * ignored: the list selects individual hosts and has no catch-all form.
+ *
+ * Comparison is case-insensitive and ignores any port, credentials or IPv6
+ * brackets present on either side.
+ */
+const normaliseHost = (host: string): string => {
+  let h = host.trim().toLowerCase();
+
+  const at = h.lastIndexOf('@');
+  if (at !== -1) h = h.slice(at + 1);
+
+  // A bracketed IPv6 literal must not be cut at its first colon.
+  if (h.startsWith('[')) {
+    const close = h.indexOf(']');
+    if (close !== -1) return h.slice(1, close);
+  }
+
+  const colon = h.indexOf(':');
+  return colon === -1 ? h : h.slice(0, colon);
+};
+
+export const parseBypassHosts = (raw?: string | null): string[] =>
+  (raw ?? '')
+    .split(/[\s,;]+/)
+    .map((e) => e.trim().toLowerCase())
+    .map((e) => (e.startsWith('[') && e.endsWith(']') ? e.slice(1, -1) : e))
+    .filter((e) => e.length > 0 && e !== '*');
+
+export const isBypassedHost = (
+  host: string | undefined,
+  entries: string[]
+): boolean => {
+  if (!host || entries.length === 0) return false;
+  const h = normaliseHost(host);
+
+  return entries.some((entry) => {
+    if (entry.startsWith('*.')) {
+      return h.endsWith(entry.slice(1)) && h !== entry.slice(2);
+    }
+    if (entry.startsWith('.')) {
+      return h === entry.slice(1) || h.endsWith(entry);
+    }
+    return h === entry;
+  });
+};
