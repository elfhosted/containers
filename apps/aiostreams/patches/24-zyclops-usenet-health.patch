diff --git a/packages/core/src/builtins/utils/zyclopsHealth.ts b/packages/core/src/builtins/utils/zyclopsHealth.ts
new file mode 100644
index 0000000..93f2823
--- /dev/null
+++ b/packages/core/src/builtins/utils/zyclopsHealth.ts
@@ -0,0 +1,163 @@
+import { fetch } from 'undici';
+import { createLogger } from '../../utils/index.js';
+import { config as appConfig } from '../../config/index.js';
+
+const logger = createLogger('zyclops-health');
+
+const MAX_BATCH_SIZE = 500;
+
+export interface ZyclopsHealthDescriptor {
+  index: number;
+  nzbFilename: string;
+  pubDate?: string;
+  downloadUrl?: string;
+}
+
+const HEALTHY = new Set(['verified', 'elf-verified', 'healthy', 'good', 'ok', 'passed']);
+const BLOCKED = new Set(['blocked', 'unhealthy', 'failed', 'dead', 'rejected', 'bad']);
+function rank(status?: string): number {
+  const s = status?.trim().toLowerCase();
+  if (!s) return 1;
+  if (HEALTHY.has(s)) return 0;
+  if (BLOCKED.has(s)) return 2;
+  return 1;
+}
+
+function pubDateDay(pubDate?: string): string | undefined {
+  if (!pubDate) return undefined;
+  const d = new Date(pubDate);
+  if (isNaN(d.getTime())) return undefined;
+  return d.toISOString().slice(0, 10);
+}
+
+export function sanitizeNzbFilename(value?: string): string | null {
+  if (!value || typeof value !== 'string') return null;
+  const cleaned = value
+    .trim()
+    .replace(/[<>:"/\\|?*]+/g, ' ')
+    .replace(/\s+/g, '.')
+    .replace(/\.+/g, '.')
+    .replace(/^\.+|\.+$/g, '');
+  return cleaned || null;
+}
+
+export function deriveNzbFilename(title?: string): string | null {
+  const sanitized = sanitizeNzbFilename(title);
+  if (!sanitized) return null;
+  return /\.nzb$/i.test(sanitized) ? sanitized : `${sanitized}.nzb`;
+}
+
+interface BatchItem {
+  index: number;
+  nzb_filename: string;
+  provider_host: string;
+  pubDate: string;
+  pubdate_day?: string;
+  download_url?: string;
+  lookup_key?: string;
+}
+
+interface BatchEntry {
+  index?: number;
+  status?: string;
+  playable_status?: string;
+  health?: { status?: unknown } | null;
+}
+
+async function postBatch(
+  url: string,
+  providerHost: string,
+  items: BatchItem[]
+): Promise<BatchEntry[]> {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+    body: JSON.stringify({ provider_host: providerHost, items }),
+    signal: AbortSignal.timeout(appConfig.builtins.nab.zyclopsHealthApiTimeout),
+  });
+  if (response.status < 200 || response.status >= 300) {
+    logger.warn(`Zyclops batch health returned ${response.status}`);
+    return [];
+  }
+  const data = (await response.json()) as { results?: BatchEntry[] };
+  return Array.isArray(data?.results) ? data.results : [];
+}
+
+function entryStatus(entry: BatchEntry): string | undefined {
+  if (entry.status !== 'hit') return undefined;
+  if (entry.playable_status?.trim().toLowerCase() === 'unplayable') {
+    return 'blocked';
+  }
+  const verdict = entry.health?.status;
+  return typeof verdict === 'string' && verdict.trim() ? verdict : undefined;
+}
+
+export async function fetchZyclopsHealth(
+  descriptors: ZyclopsHealthDescriptor[],
+  providerHosts: string[]
+): Promise<Map<number, string>> {
+  const result = new Map<number, string>();
+  const hosts = Array.from(
+    new Set(providerHosts.map((h) => h?.trim()).filter((h): h is string => !!h))
+  );
+  if (!descriptors.length || !hosts.length) return result;
+
+  const url = appConfig.builtins.nab.zyclopsHealthApiUrl;
+  if (!url) return result;
+
+  const eligible = descriptors.filter(
+    (d): d is ZyclopsHealthDescriptor & { pubDate: string } =>
+      pubDateDay(d.pubDate) !== undefined
+  );
+  if (eligible.length < descriptors.length) {
+    logger.debug(
+      `Skipping ${descriptors.length - eligible.length} NZB(s) without a parseable pubDate`
+    );
+  }
+  if (!eligible.length) return result;
+
+  const tasks: Array<Promise<void>> = [];
+  for (const host of hosts) {
+    for (let i = 0; i < eligible.length; i += MAX_BATCH_SIZE) {
+      const slice = eligible.slice(i, i + MAX_BATCH_SIZE);
+      const items: BatchItem[] = slice.map((d) => ({
+        index: d.index,
+        nzb_filename: d.nzbFilename,
+        provider_host: host,
+        pubDate: d.pubDate,
+        pubdate_day: pubDateDay(d.pubDate),
+        download_url: d.downloadUrl,
+        lookup_key: d.downloadUrl,
+      }));
+      tasks.push(
+        postBatch(url, host, items)
+          .then((results) => {
+            for (const entry of results) {
+              if (!entry || typeof entry.index !== 'number') continue;
+              const item = slice[entry.index];
+              if (!item) continue;
+              const status = entryStatus(entry);
+              if (!status) continue;
+              const prev = result.get(item.index);
+              if (prev === undefined || rank(status) < rank(prev)) {
+                result.set(item.index, status);
+              }
+            }
+          })
+          .catch((err) => {
+            logger.warn(
+              `Zyclops batch health request failed: ${
+                err instanceof Error ? err.message : String(err)
+              }`
+            );
+          })
+      );
+    }
+  }
+
+  await Promise.all(tasks);
+  logger.debug(
+    `Zyclops batch health annotated ${result.size}/${descriptors.length} NZBs across ${hosts.length} host(s)`
+  );
+  return result;
+}
