diff --git a/packages/core/src/utils/distributed-lock.waiter.test.ts b/packages/core/src/utils/distributed-lock.waiter.test.ts
new file mode 100644
index 0000000..205fa95
--- /dev/null
+++ b/packages/core/src/utils/distributed-lock.waiter.test.ts
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { DistributedLock, stringifyLockResult } from './distributed-lock.js';
+
+/**
+ * A lock whose acquire always fails, so every call takes the waiter path.
+ * `getReply` controls when the waiter's double-check GET answers.
+ */
+function waiterLock(getReply: Promise<string | null>) {
+  let listener: ((message: string) => void) | undefined;
+  const lock: any = Object.create(DistributedLock.prototype);
+  lock.redis = {
+    set: async () => null,
+    get: () => getReply,
+  };
+  lock.subRedis = {
+    subscribe: async (_channel: string, fn: (message: string) => void) => {
+      listener = fn;
+    },
+    unsubscribe: async () => {},
+  };
+  return {
+    lock,
+    publish: (value: unknown) =>
+      listener?.(stringifyLockResult({ value })),
+    subscribed: async () => {
+      while (!listener) await new Promise((r) => setImmediate(r));
+    },
+  };
+}
+
+describe('DistributedLock redis waiter', () => {
+  it('does not rerun the work when the result arrives before the double-check', async () => {
+    let answerGet!: (value: string | null) => void;
+    const { lock, publish, subscribed } = waiterLock(
+      new Promise((r) => (answerGet = r))
+    );
+    let runs = 0;
+    const pending = lock.withRedisLock(
+      'k',
+      async () => {
+        runs++;
+        return 'rerun';
+      },
+      { timeout: 1000 }
+    );
+
+    await subscribed();
+    publish('from-holder');
+    // The holder released before publishing, so the GET now sees no lock.
+    answerGet(null);
+
+    assert.deepEqual(await pending, { result: 'from-holder', cached: true });
+    await new Promise((r) => setImmediate(r));
+    assert.equal(runs, 0);
+  });
+
+  it('still runs the work when the holder finished before the subscription', async () => {
+    const { lock } = waiterLock(Promise.resolve(null));
+    let runs = 0;
+    const result = await lock.withRedisLock(
+      'k',
+      async () => {
+        runs++;
+        return 'ran-here';
+      },
+      { timeout: 1000 }
+    );
+
+    assert.deepEqual(result, { result: 'ran-here', cached: false });
+    assert.equal(runs, 1);
+  });
+});
