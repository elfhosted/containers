index 00000000..3a66963f
--- /dev/null
+++ b/packages/core/src/debrid/rdBlocklist.ts
@@ -0,0 +1,58 @@
+/**
+ * RealDebrid filename blocklist (operator-configured band-aid).
+ *
+ * Downgrades cached DebridDownload entries to status='unknown' if the torrent
+ * name or any file name matches RD_BLOCKED_FILENAME_REGEX. Applied at the
+ * StremThru check-cache layer so stale 'cached' entries (cached locally for
+ * up to BUILTIN_DEBRID_INSTANT_AVAILABILITY_CACHE_TTL) don't keep claiming
+ * instant-play for content RD will refuse at unrestrict time.
+ *
+ * Empty/unset env var disables the feature (no overhead). Invalid regex
+ * throws at module load — silent no-op would be worse than a startup crash.
+ *
+ * RD only — other debrids have different policies.
+ */
+
+import type { DebridDownload } from './base.js';
+
+const _raw = (process.env.RD_BLOCKED_FILENAME_REGEX || '').trim();
+let _pattern: RegExp | null = null;
+if (_raw) {
+  try {
+    _pattern = new RegExp(_raw, 'i');
+    console.log(`rdBlocklist: RD filename blocklist active: ${_raw}`);
+  } catch (err) {
+    throw new Error(
+      `rdBlocklist: invalid RD_BLOCKED_FILENAME_REGEX: ${
+        err instanceof Error ? err.message : String(err)
+      }`
+    );
+  }
+}
+
+export function isEnabled(): boolean {
+  return _pattern !== null;
+}
+
+function matchesString(s: string | undefined | null): boolean {
+  if (!_pattern || !s || typeof s !== 'string') return false;
+  return _pattern.test(s);
+}
+
+/**
+ * If the item is marked cached and any of its name fields matches the
+ * configured regex, return a shallow copy with status='unknown'. Otherwise
+ * returns the item unchanged. Safe with undefined/null inputs.
+ */
+export function downgradeIfBlocked(
+  item: DebridDownload | undefined,
+  serviceName: string
+): DebridDownload | undefined {
+  if (!item || !_pattern) return item;
+  if (serviceName !== 'realdebrid') return item;
+  if (item.status !== 'cached') return item;
+  const nameMatches = matchesString(item.name);
+  const fileMatches = (item.files ?? []).some((f) => matchesString(f.name));
+  if (!nameMatches && !fileMatches) return item;
+  return { ...item, status: 'unknown' };
+}
