diff --git a/packages/core/src/debrid/rdBlocklist.ts b/packages/core/src/debrid/rdBlocklist.ts
new file mode 100644
index 0000000..a6f3a0a
--- /dev/null
+++ b/packages/core/src/debrid/rdBlocklist.ts
@@ -0,0 +1,39 @@
+
+import type { DebridDownload } from './base.js';
+
+const _raw = (process.env.RD_BLOCKED_FILENAME_REGEX || '').trim();
+let _pattern: RegExp | null = null;
+if (_raw) {
+  try {
+    _pattern = new RegExp(_raw, 'i');
+    console.log(`rdBlocklist: RD filename blocklist active: ${_raw}`);
+  } catch (err) {
+    throw new Error(
+      `rdBlocklist: invalid RD_BLOCKED_FILENAME_REGEX: ${
+        err instanceof Error ? err.message : String(err)
+      }`
+    );
+  }
+}
+
+export function isEnabled(): boolean {
+  return _pattern !== null;
+}
+
+function matchesString(s: string | undefined | null): boolean {
+  if (!_pattern || !s || typeof s !== 'string') return false;
+  return _pattern.test(s);
+}
+
+export function downgradeIfBlocked(
+  item: DebridDownload | undefined,
+  serviceName: string
+): DebridDownload | undefined {
+  if (!item || !_pattern) return item;
+  if (serviceName !== 'realdebrid') return item;
+  if (item.status !== 'cached') return item;
+  const nameMatches = matchesString(item.name);
+  const fileMatches = (item.files ?? []).some((f) => matchesString(f.name));
+  if (!nameMatches && !fileMatches) return item;
+  return { ...item, status: 'unknown' };
+}
