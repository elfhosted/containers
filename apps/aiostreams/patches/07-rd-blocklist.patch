diff --git a/packages/core/src/debrid/rdBlocklist.ts b/packages/core/src/debrid/rdBlocklist.ts
new file mode 100644
index 0000000..a6f3a0a
--- /dev/null
+++ b/packages/core/src/debrid/rdBlocklist.ts
@@ -0,0 +1,39 @@
+
+import type { DebridDownload } from './base.js';
+
+const _raw = (process.env.RD_BLOCKED_FILENAME_REGEX || '').trim();
+let _pattern: RegExp | null = null;
+if (_raw) {
+  try {
+    _pattern = new RegExp(_raw);
+    console.log(`rdBlocklist: RD filename blocklist active: ${_raw}`);
+  } catch (err) {
+    throw new Error(
+      `rdBlocklist: invalid RD_BLOCKED_FILENAME_REGEX: ${
+        err instanceof Error ? err.message : String(err)
+      }`
+    );
+  }
+}
+
+export function isEnabled(): boolean {
+  return _pattern !== null;
+}
+
+function matchesString(s: string | undefined | null): boolean {
+  if (!_pattern || !s || typeof s !== 'string') return false;
+  return _pattern.test(s);
+}
+
+export function downgradeIfBlocked(
+  item: DebridDownload | undefined,
+  serviceName: string
+): DebridDownload | undefined {
+  if (!item || !_pattern) return item;
+  if (serviceName !== 'realdebrid') return item;
+  if (item.status !== 'cached') return item;
+  const nameMatches = matchesString(item.name);
+  const fileMatches = (item.files ?? []).some((f) => matchesString(f.name));
+  if (!nameMatches && !fileMatches) return item;
+  return { ...item, status: 'unknown' };
+}
diff --git a/packages/core/src/debrid/stremthru.checkcache.test.ts b/packages/core/src/debrid/stremthru.checkcache.test.ts
new file mode 100644
index 0000000..cd249a1
--- /dev/null
+++ b/packages/core/src/debrid/stremthru.checkcache.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import type { DebridDownload } from './base.js';
+
+// Read once at module load, so it must be set before the import.
+process.env.RD_BLOCKED_FILENAME_REGEX = 'blocked';
+const { StremThruService } = await import('./stremthru.js');
+
+// The real cache and constructor both need the runtime config; the
+// check-cache helpers only need serviceName and the static cache.
+const store = new Map<string, DebridDownload>();
+(StremThruService as any).checkCache = {
+  get: async (key: string) => store.get(key),
+  getMany: async (keys: string[]) => keys.map((key) => store.get(key)),
+};
+
+function seed(svc: any, item: DebridDownload): void {
+  store.set(svc.checkCacheKey(item.hash!), item);
+}
+
+function service(serviceName: string): any {
+  return Object.assign(Object.create(StremThruService.prototype), {
+    serviceName,
+  });
+}
+
+function download(hash: string, name: string): DebridDownload {
+  return {
+    id: -1,
+    hash,
+    name,
+    status: 'cached',
+    files: [{ name, size: 1, index: 0 }],
+  } as DebridDownload;
+}
+
+describe('StremThru check cache: RD filename blocklist', () => {
+  it('downgrades a blocked realdebrid entry on single and batched reads', async () => {
+    const svc = service('realdebrid');
+    seed(svc, download('rd-blocked', 'Some.blocked.File.mkv'));
+    seed(svc, download('rd-clean', 'Some.Clean.File.mkv'));
+
+    assert.equal((await svc.checkCacheGet('rd-blocked'))?.status, 'unknown');
+    assert.equal((await svc.checkCacheGet('rd-clean'))?.status, 'cached');
+
+    const batched = await svc.checkCacheGetMany(['rd-blocked', 'rd-clean']);
+    assert.deepEqual(
+      batched.map((d: DebridDownload | undefined) => d?.status),
+      ['unknown', 'cached']
+    );
+  });
+
+  it('matches case-sensitively', async () => {
+    const svc = service('realdebrid');
+    seed(svc, download('rd-upper', 'Some.BLOCKED.File.mkv'));
+    assert.equal((await svc.checkCacheGet('rd-upper'))?.status, 'cached');
+  });
+
+  it('leaves other services alone', async () => {
+    const svc = service('torbox');
+    seed(svc, download('tb-blocked', 'Some.blocked.File.mkv'));
+    const [item] = await svc.checkCacheGetMany(['tb-blocked']);
+    assert.equal(item?.status, 'cached');
+  });
+});
