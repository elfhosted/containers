+
+function buildWrapStats(
+  wrapped: ParsedStream[],
+  addons: Addon[]
+): Record<string, WrappedAddonStat> {
+  const implicit = new Map<string, Addon>();
+  for (const addon of addons) {
+    if (addon.implicitlyWrapped && addon.instanceId) {
+      implicit.set(addon.instanceId, addon);
+    }
+  }
+  if (implicit.size === 0) return {};
+
+  const hashesByInstance = new Map<string, Set<string>>();
+  for (const stream of wrapped) {
+    const instanceId = stream.addon?.instanceId;
+    const hash = stream.torrent?.infoHash;
+    if (!instanceId || !hash) continue;
+    const addon = implicit.get(instanceId);
+    if (!addon) continue;
+    const hashes = hashesByInstance.get(instanceId) ?? new Set<string>();
+    hashes.add(hash);
+    hashesByInstance.set(instanceId, hashes);
+  }
+
+  const stats: Record<string, WrappedAddonStat> = {};
+  for (const [instanceId, hashes] of hashesByInstance) {
