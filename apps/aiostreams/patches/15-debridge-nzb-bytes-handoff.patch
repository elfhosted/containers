+  // stremthru's debridge adapter caps the NZB at 32 MiB (maxNZBBytes = 32 <<
+  // 20). Stay just under it so an oversize body fails here with a clear error
+  // instead of being uploaded and rejected upstream. Reserve only the actual
+  // multipart framing overhead (boundary + Content-Disposition + part
+  // filename — well under 64 KiB), NOT a full MiB: a cap flush to the raw
+  // ceiling needlessly rejected otherwise-valid NZBs just under it that
+  // StremThru and the previous link-based path both accept.
+  private static readonly MAX_NZB_BYTES = 32 * 1024 * 1024 - 64 * 1024;
+
+  // Turn the resolve-supplied filename into a safe multipart part filename.
+  // stremthru uses the part filename for the file `name` when debridge
+  // returns none, so it must be non-empty and free of path separators /
+  // control characters.
+  private static nzbFilename(name: string): string {
+    const cleaned = (name || 'download')
+      .replace(/[/\\]+/g, '_')
+      // eslint-disable-next-line no-control-regex
+      .replace(/[\x00-\x1f]+/g, '')
+      .trim();
+    return `${cleaned || 'download'}.nzb`;
+  }
+
+  private static oversizeNzbError(observed: number): DebridError {
+    return new DebridError(
+      `NZB too large to upload (${observed} bytes exceeds ${StremThruService.MAX_NZB_BYTES} cap)`,
+      {
+        statusCode: 413,
+        statusText: 'NZB too large',
+        code: 'UNPROCESSABLE_ENTITY',
+        type: 'api_error',
+        headers: {},
+        body: { bytes: observed, max: StremThruService.MAX_NZB_BYTES },
+      }
+    );
+  }
+
+  // Read the NZB body while enforcing the size cap as bytes arrive. A bad or
+  // malicious indexer/replay URL must not be able to force us to buffer an
+  // unbounded body into memory before the cap is checked, so we honour
+  // Content-Length up front and abort the stream the moment the running total
+  // crosses the cap. Throws a 413 DebridError on overflow.
+  private static async readCappedNzb(
+    res: Awaited<ReturnType<typeof makeRequest>>,
+    max: number
+  ): Promise<Buffer> {
+    const declared = Number(res.headers.get('content-length'));
+    if (Number.isFinite(declared) && declared > max) {
+      throw StremThruService.oversizeNzbError(declared);
+    }
+    const reader = res.body?.getReader();
+    if (!reader) {
+      return Buffer.alloc(0);
+    }
+    const chunks: Buffer[] = [];
+    let total = 0;
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!value) continue;
+      total += value.byteLength;
+      if (total > max) {
+        await reader.cancel();
+        throw StremThruService.oversizeNzbError(total);
+      }
+      chunks.push(Buffer.from(value));
+    }
+    return Buffer.concat(chunks);
+  }
+
