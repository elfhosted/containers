diff --git a/packages/core/src/streams/utils.test.ts b/packages/core/src/streams/utils.test.ts
new file mode 100644
index 0000000..2320879
--- /dev/null
+++ b/packages/core/src/streams/utils.test.ts
@@ -0,0 +1,154 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import type { ParsedStream, UserData } from '../db/schemas.js';
+import { isServiceWrapEligibleP2PStream } from './utils.js';
+
+const HASH = 'a'.repeat(40);
+
+function stream(opts: {
+  type?: string;
+  serviceWrapped?: boolean;
+  infoHash?: string;
+  presetId?: string;
+}): ParsedStream {
+  return {
+    type: opts.type ?? 'p2p',
+    addon: {
+      serviceWrapped: opts.serviceWrapped,
+      preset: { id: opts.presetId ?? 'tio', type: 'torrentio', options: {} },
+    },
+    torrent: opts.infoHash ? { infoHash: opts.infoHash } : undefined,
+  } as unknown as ParsedStream;
+}
+
+function user(opts: {
+  services?: { id: string; enabled?: boolean }[];
+  serviceWrap?: { enabled?: boolean; presets?: string[] };
+}): UserData {
+  return {
+    services: (opts.services ?? []).map((s) => ({ ...s, credentials: {} })),
+    serviceWrap: opts.serviceWrap,
+  } as unknown as UserData;
+}
+
+const debridge = [{ id: 'debridge', enabled: true }];
+
+describe('isServiceWrapEligibleP2PStream without explicit Service Wrap', () => {
+  it('picks up a stream from a service-wrapped addon', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ serviceWrapped: true, infoHash: HASH }),
+        user({ services: debridge })
+      ),
+      true
+    );
+  });
+
+  it('picks up a hashed P2P stream when Debridge is enabled', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH }),
+        user({ services: debridge, serviceWrap: { enabled: false } })
+      ),
+      true
+    );
+  });
+
+  it('treats a Debridge service with no enabled flag as enabled', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH }),
+        user({ services: [{ id: 'debridge' }] })
+      ),
+      true
+    );
+  });
+
+  it('ignores a stale presets selection', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH, presetId: 'tio' }),
+        user({
+          services: debridge,
+          serviceWrap: { enabled: false, presets: ['other'] },
+        })
+      ),
+      true
+    );
+  });
+
+  it('skips a hashless stream that is not service-wrapped', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(stream({}), user({ services: debridge })),
+      false
+    );
+  });
+
+  it('skips when Debridge is disabled', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH }),
+        user({ services: [{ id: 'debridge', enabled: false }] })
+      ),
+      false
+    );
+  });
+
+  it('skips when the user has other services but not Debridge', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH }),
+        user({ services: [{ id: 'realdebrid', enabled: true }] })
+      ),
+      false
+    );
+  });
+
+  it('skips non-P2P streams', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ type: 'debrid', serviceWrapped: true, infoHash: HASH }),
+        user({ services: debridge })
+      ),
+      false
+    );
+  });
+});
+
+describe('isServiceWrapEligibleP2PStream with explicit Service Wrap', () => {
+  it('picks up a service-wrapped stream', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ serviceWrapped: true }),
+        user({ serviceWrap: { enabled: true } })
+      ),
+      true
+    );
+  });
+
+  it('picks up an in-scope hashed stream without Debridge', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH, presetId: 'tio' }),
+        user({
+          services: [{ id: 'realdebrid', enabled: true }],
+          serviceWrap: { enabled: true, presets: ['tio'] },
+        })
+      ),
+      true
+    );
+  });
+
+  it('skips an out-of-scope stream that is not service-wrapped', () => {
+    assert.equal(
+      isServiceWrapEligibleP2PStream(
+        stream({ infoHash: HASH, presetId: 'tio' }),
+        user({
+          services: debridge,
+          serviceWrap: { enabled: true, presets: ['other'] },
+        })
+      ),
+      false
+    );
+  });
+});
