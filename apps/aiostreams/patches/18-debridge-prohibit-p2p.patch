diff --git a/packages/core/src/main/serviceWrapper.ts b/packages/core/src/main/serviceWrapper.ts
index 48a7b002..d6758fdd 100644
--- a/packages/core/src/main/serviceWrapper.ts
+++ b/packages/core/src/main/serviceWrapper.ts
@@ -80,9 +80,28 @@ export async function resolveServiceWrappedStreams(
     }
   }
 
-  // Skip when neither explicit Service Wrap is enabled nor any implicit-wrapped
-  // addons exist (e.g. implicit Debridge wrap from applyPresets).
-  if (!userData.serviceWrap?.enabled && serviceWrappedInstanceIds.size === 0) {
+  // A Debridge user can have raw P2P streams that no addon pre-marked as
+  // serviceWrapped — e.g. when only "native-debridge" presets (comet,
+  // mediafusion, jackettio, stremthru) are installed and the upstream addon
+  // returned torrents instead of resolving Debridge. Engage the wrap for those
+  // too so they resolve through Debridge rather than being dropped downstream
+  // by PROHIBIT_P2P_STREAMS. An omitted `enabled` flag counts as enabled
+  // (matches buildDebridServices / getUsableServices semantics).
+  const userHasDebridge = (userData.services ?? []).some(
+    (s) => s.enabled !== false && s.id === constants.DEBRIDGE_SERVICE
+  );
+  const hasWrappableP2P = streams.some(
+    (s) => s.type === 'p2p' && !!s.torrent?.infoHash
+  );
+
+  // Skip when neither explicit Service Wrap is enabled, nor any implicit-wrapped
+  // addons exist (e.g. implicit Debridge wrap from applyPresets), nor a Debridge
+  // user has resolvable P2P to wrap.
+  if (
+    !userData.serviceWrap?.enabled &&
+    serviceWrappedInstanceIds.size === 0 &&
+    !(userHasDebridge && hasWrappableP2P)
+  ) {
     return { streams, errors: [], hasNewStreams: false };
   }
 
