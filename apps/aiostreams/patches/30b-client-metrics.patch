+/**
+ * Expand an IPv6 address to its eight hextets, so a prefix is taken from the
+ * network and never from the host part.
+ *
+ * `::` elides a run of zero groups, and dropping the empty strings it leaves
+ * behind slides the tail forward: `2001:db8::1a2b:3c4d:5e6f:7a8b` becomes
+ * `['2001','db8','1a2b',…]`, so the "first three hextets" include the first
+ * hextet of the interface identifier. That identifier is what RFC 4941
+ * privacy addresses rotate, so one household churns through many distinct
+ * "prefixes" — inflating exactly the client cardinalities this anonymisation
+ * feeds, in the one direction that turns a family into an abuse finding.
+ *
+ * Returns null for anything that is not a well-formed address; the caller
+ * stores null rather than guessing.
+ */
+function expandIpv6(addr: string): string[] | null {
+  const halves = addr.split('::');
+  if (halves.length > 2) return null;
+  const left = halves[0] ? halves[0].split(':') : [];
+  if (halves.length === 1) {
+    return left.length === 8 && left.every(Boolean) ? left : null;
+  }
+  const right = halves[1] ? halves[1].split(':') : [];
+  if (!left.every(Boolean) || !right.every(Boolean)) return null;
+  const fill = 8 - left.length - right.length;
+  if (fill < 1) return null;
+  return [...left, ...Array(fill).fill('0'), ...right];
+}
