{
  "extends": [
    "config:base",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "platform": "github",
  "repositories": ["elfhosted/containers"],
  "onboarding": false,
  "requireConfig": false,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prIgnoreNotification"],
  "commitBodyTable": true,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["!alpine", "!ubuntu"],
    },
    {
      "description": "Auto-merge Github Actions",
      "matchDatasources": ["github-tags"],
      "automerge": true,
      "automergeType": "branch",
      "requiredStatusChecks": null,
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackagePatterns": ["renovatebot/github-action"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true,
      "ignoreTests": true,
      "matchPackageNames": ["!alpine", "!ubuntu"]
    },
    {
      // Auto-cascade ElfHosted-internal base bumps. When ubuntu/alpine/etc.
      // get a new date stamp or new digest, child Dockerfiles that pin those
      // bases should follow without manual review — otherwise security
      // updates sit in PR queues for weeks. Major bumps (e.g. focal→jammy)
      // are intentionally excluded; those still need a human eye.
      "description": "Auto-merge ElfHosted base-image bumps in child Dockerfiles",
      "matchDatasources": ["docker"],
      "matchPackagePrefixes": ["ghcr.io/elfhosted/"],
      "matchUpdateTypes": ["digest", "pinDigest", "patch", "minor"],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true,
      "ignoreTests": true
    },
    {
      // A Node major is a runtime change the app's upstream has to support
      // first (#1050 jumped four apps to Node 26 ahead of their upstreams).
      // Move Node majors by hand, when upstream does.
      "description": "No Node major bumps: follow each app's upstream",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "public.ecr.aws/docker/library/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // aiostreams mirrors upstream's Dockerfile, which pins an exact Node
      // release (node:24.18.1-slim at v2.38.1). Keep it equal to upstream's
      // pin rather than chasing newer Node patches.
      "description": "aiostreams: Node follows upstream's Dockerfile pin",
      "matchFileNames": ["apps/aiostreams/**"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      // Floppy's pyproject sets [tool.uv] required-version = "==0.12.3", so any
      // other uv fails `uv sync --locked`. Bump with upstream's pin.
      "description": "floppy: uv follows upstream's required-version",
      "matchFileNames": ["apps/floppy/**"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "enabled": false
    },
    {
      // yamtrack builds FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-alpine${ALPINE_VERSION},
      // so ALPINE_VERSION can only move once uv publishes that tag (#849
      // failed: python3.12-alpine3.24 does not exist).
      "description": "yamtrack: Alpine follows the uv image tags",
      "matchFileNames": ["apps/yamtrack/**"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine", "public.ecr.aws/docker/library/alpine"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "📣 "
    }
  ],
  "regexManagers": [
    {
      "description": "Process Dependencies",
      "fileMatch": [
        ".*"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?\"(?<currentValue>.*)\"\n"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
